<legacy:MyPageRight x:Class="PCL.Desktop.Features.Instances.Views.PageInstanceToolsRight"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:legacy="using:PCL.Desktop.Controls.Legacy">
    <legacy:MyScrollViewer x:Name="PanBack"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain"
                    Margin="25,25,25,25" />
    </legacy:MyScrollViewer>
</legacy:MyPageRight>
