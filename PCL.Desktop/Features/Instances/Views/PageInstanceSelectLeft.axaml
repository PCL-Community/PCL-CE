<legacy:MyPageLeft x:Class="PCL.Desktop.Features.Instances.Views.PageInstanceSelectLeft"
                   xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:legacy="using:PCL.Desktop.Controls.Legacy">
    <legacy:MyScrollViewer HorizontalScrollBarVisibility="Disabled"
                           VerticalScrollBarVisibility="Auto"
                           MaxWidth="300" MinWidth="250">
        <StackPanel x:Name="PanList" />
    </legacy:MyScrollViewer>
</legacy:MyPageLeft>
