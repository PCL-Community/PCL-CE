                            </Grid>
                        </legacy:MyCard>
                        <legacy:MyCard Title="{DynamicResource Common.Installation.OptiFabric}" Height="40"
                                      Margin="0,15,0,0" x:Name="CardOptiFabric"
                                      IsSwapped="True" CanSwap="True" SwapLogoRight="True"
                                      PreviewSwap="CardOptiFabric_PreviewSwap">
                            <StackPanel Margin="20,40,18,15" VerticalAlignment="Top" x:Name="PanOptiFabric" />
                            <Grid x:Name="PanOptiFabricInfo" Height="18" Margin="132,11,15,0" VerticalAlignment="Top"
                                  Tag="True">
                                <Grid.RenderTransform>
                                    <TranslateTransform />
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="ImgOptiFabric" Margin="0,0,7,0" Height="18"
                                       Source="avares://PCL.Desktop/WpfOriginal/Images/Blocks/OptiFabric.png" />
                                <TextBlock x:Name="LabOptiFabric" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Grid.Column="1" />
                            </Grid>
                            <Grid x:Name="BtnOptiFabricClear" Height="30" Width="30" HorizontalAlignment="Right"
                                  VerticalAlignment="Top" Margin="0,5,32,0" PointerReleased="OptiFabric_Clear"
