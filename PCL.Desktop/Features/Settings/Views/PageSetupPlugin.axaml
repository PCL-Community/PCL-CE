<legacy:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:legacy="using:PCL.Desktop.Controls.Legacy"
    x:Class="PCL.Desktop.Features.Settings.Views.PageSetupPlugin">
    <legacy:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <legacy:MyCard Margin="0,0,0,15" Title="{DynamicResource Setup.Plugin.Title}">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="{DynamicResource Setup.Plugin.ComingSoon}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ColorBrush1}"
                               Margin="0,0,0,10" />
                    <TextBlock Text="{DynamicResource Setup.Plugin.Description}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrush2}" />
                </StackPanel>
            </legacy:MyCard>
        </StackPanel>
    </legacy:MyScrollViewer>
</legacy:MyPageRight>
