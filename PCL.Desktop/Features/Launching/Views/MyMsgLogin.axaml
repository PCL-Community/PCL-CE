<Grid x:Class="PCL.Desktop.Features.Launching.Views.MyMsgLogin"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:legacy="using:PCL.Desktop.Controls.Legacy"
      RenderTransformOrigin="0%,50%"
      MinWidth="400"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Margin="25">
    <Grid.RenderTransform>
        <TransformGroup>
            <RotateTransform Angle="-4" />
            <TranslateTransform X="0" Y="40" />
        </TransformGroup>
    </Grid.RenderTransform>
    <legacy:BlurBorder x:Name="PanBorder"
                       CornerRadius="7"
                       Background="{DynamicResource ColorBrushBackground}"
                       BoxShadow="0 4 20 0 #cc3c3c3c"
                       PointerPressed="Drag">
        <Grid x:Name="PanMain"
              VerticalAlignment="Top"
              Margin="22,22,22,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="13" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       FontSize="23"
                       TextTrimming="None"
                       Foreground="{DynamicResource ColorBrush2}"
                       HorizontalAlignment="Left"
                       x:Name="LabTitle"
                       Margin="7,-1,70,9"
                       Text="{DynamicResource Launch.Account.LoginDialog.Title}"
                       VerticalAlignment="Top"
                       PointerPressed="Drag" />
            <Rectangle x:Name="ShapeLine"
                       Grid.Row="1"
                       Height="2"
                       Fill="{Binding Foreground, ElementName=LabTitle}" />
            <legacy:MyScrollViewer Grid.Row="3"
                                  VerticalAlignment="Top"
                                  x:Name="PanCaption"
                                  Margin="0,0,0,17"
                                  Padding="7,0,15,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  DeltaMult="0.7">
                <TextBlock VerticalAlignment="Top"
                           TextTrimming="None"
                           TextWrapping="Wrap"
                           x:Name="LabCaption"
                           FontSize="15"
                           LineHeight="18"
                           Foreground="{DynamicResource ColorBrush1}"
                           FontWeight="Normal"
                           Padding="1" />
            </legacy:MyScrollViewer>
            <StackPanel Grid.Row="4"
                        x:Name="PanBtn"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Margin="150,0,8,0"
                        Orientation="Horizontal">
                <legacy:MyButton ColorType="Normal"
                                Text="{DynamicResource Launch.Account.LoginDialog.ReopenWebpage}"
                                x:Name="Btn1"
                                Margin="12,0,0,0"
                                TextPadding="7"
                                Padding="5,0"
                                Click="Btn1_Click" />
                <legacy:MyButton ColorType="Normal"
                                Text="{DynamicResource Launch.Account.LoginDialog.CopyCode}"
                                x:Name="Btn2"
                                Margin="12,0,0,0"
                                TextPadding="7"
                                Padding="5,0"
                                Click="Btn2_Click" />
                <legacy:MyButton ColorType="Normal"
                                Text="{DynamicResource Common.Action.Cancel}"
                                x:Name="Btn3"
                                Margin="12,0,0,0"
                                TextPadding="7"
                                Padding="5,0"
                                Click="Btn3_Click" />
            </StackPanel>
        </Grid>
    </legacy:BlurBorder>
</Grid>
