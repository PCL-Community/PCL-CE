<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <AssemblyName>PCL.Desktop</AssemblyName>
    <RootNamespace>PCL.Desktop</RootNamespace>
    <Description>PCL N cross-platform Avalonia desktop shell</Description>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <PclRuntimeVariant Condition="'$(PclRuntimeVariant)' == ''">SelfContained</PclRuntimeVariant>
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
    <PclPluginAssembly Condition="'$(PclPluginAssembly)' != ''">$([System.IO.Path]::GetFullPath('$(PclPluginAssembly)'))</PclPluginAssembly>
    <PclPluginAbstractionsAssembly Condition="'$(PclPluginAbstractionsAssembly)' != ''">$([System.IO.Path]::GetFullPath('$(PclPluginAbstractionsAssembly)'))</PclPluginAbstractionsAssembly>
    <PclPluginSdkAssembly Condition="'$(PclPluginSdkAssembly)' != ''">$([System.IO.Path]::GetFullPath('$(PclPluginSdkAssembly)'))</PclPluginSdkAssembly>
    <PclPluginUiAssembly Condition="'$(PclPluginUiAssembly)' != ''">$([System.IO.Path]::GetFullPath('$(PclPluginUiAssembly)'))</PclPluginUiAssembly>
    <PclPluginUiAvaloniaAssembly Condition="'$(PclPluginUiAvaloniaAssembly)' != ''">$([System.IO.Path]::GetFullPath('$(PclPluginUiAvaloniaAssembly)'))</PclPluginUiAvaloniaAssembly>
    <PclPluginBouncyCastleAssembly Condition="'$(PclPluginBouncyCastleAssembly)' != ''">$([System.IO.Path]::GetFullPath('$(PclPluginBouncyCastleAssembly)'))</PclPluginBouncyCastleAssembly>
    <PclPluginJsonCanonicalizerAssembly Condition="'$(PclPluginJsonCanonicalizerAssembly)' != ''">$([System.IO.Path]::GetFullPath('$(PclPluginJsonCanonicalizerAssembly)'))</PclPluginJsonCanonicalizerAssembly>
    <PclPluginEs6NumberSerializerAssembly Condition="'$(PclPluginEs6NumberSerializerAssembly)' != ''">$([System.IO.Path]::GetFullPath('$(PclPluginEs6NumberSerializerAssembly)'))</PclPluginEs6NumberSerializerAssembly>
    <PclPluginProtectedDataAssembly Condition="'$(PclPluginProtectedDataAssembly)' != ''">$([System.IO.Path]::GetFullPath('$(PclPluginProtectedDataAssembly)'))</PclPluginProtectedDataAssembly>

    <!-- CI secret pre-write (PCL_WRITE_SECRET=1 embeds values into PclEmbeddedSecrets). -->
    <PclWriteSecret Condition="'$(PclWriteSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_WRITE_SECRET'))</PclWriteSecret>
    <PclMsClientId Condition="'$(PclMsClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_MS_CLIENT_ID'))</PclMsClientId>
    <PclMsClientId Condition="'$(PclMsClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('MS_CLIENT_ID'))</PclMsClientId>
    <PclCurseForgeApiKey Condition="'$(PclCurseForgeApiKey)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_CURSEFORGE_API_KEY'))</PclCurseForgeApiKey>
    <PclSentryDsn Condition="'$(PclSentryDsn)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_SENTRY_DSN'))</PclSentryDsn>
    <PclNaidClientId Condition="'$(PclNaidClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_NAID_CLIENT_ID'))</PclNaidClientId>
    <PclNaidClientSecret Condition="'$(PclNaidClientSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_NAID_CLIENT_SECRET'))</PclNaidClientSecret>
    <PclLinkServerRoot Condition="'$(PclLinkServerRoot)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LINK_SERVER_ROOT'))</PclLinkServerRoot>
    <PclLobbyDefaultSecret Condition="'$(PclLobbyDefaultSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LOBBY_DEFAULT_SECRET'))</PclLobbyDefaultSecret>
    <PclGithubSha Condition="'$(PclGithubSha)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_GITHUB_SHA'))</PclGithubSha>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclPluginAssembly)' != ''">
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PclRuntimeVariant</_Parameter1>
      <_Parameter2>$(PclRuntimeVariant)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="InformationalVersion" />
    <CompilerVisibleProperty Include="Version" />
    <CompilerVisibleProperty Include="SourceRevisionId" />
    <CompilerVisibleProperty Include="PclWriteSecret" />
    <CompilerVisibleProperty Include="PclMsClientId" />
    <CompilerVisibleProperty Include="PclCurseForgeApiKey" />
    <CompilerVisibleProperty Include="PclSentryDsn" />
    <CompilerVisibleProperty Include="PclNaidClientId" />
    <CompilerVisibleProperty Include="PclNaidClientSecret" />
    <CompilerVisibleProperty Include="PclLinkServerRoot" />
    <CompilerVisibleProperty Include="PclLobbyDefaultSecret" />
    <CompilerVisibleProperty Include="PclGithubSha" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.0.4" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1"
                      Condition="('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))) OR $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1"
                      Condition="('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('OSX'))) OR $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))" />
    <PackageReference Include="Wacton.Unicolour" Version="6.4.0" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- Host UI surface catalog for PCL.Plugin (design §11.1); not Avalonia XAML. -->
    <Content Include="Assets/UiSurfaces/PCL.Desktop.UiSurface.json"
             CopyToOutputDirectory="PreserveNewest"
             TargetPath="PCL.Desktop.UiSurface.json" />
    <EmbeddedResource Include="Localization/en-US.xaml">
      <LogicalName>PCL.Desktop.Localization.en-US.xaml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="metadata.json">
      <LogicalName>PCL.Desktop.metadata.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PclPluginAssembly)"
                      Condition="'$(PclPluginAssembly)' != '' and Exists('$(PclPluginAssembly)')">
      <LogicalName>PCL.Desktop.Embedded.PCL.Plugin.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PclPluginAbstractionsAssembly)"
                      Condition="'$(PclPluginAbstractionsAssembly)' != '' and Exists('$(PclPluginAbstractionsAssembly)')">
      <LogicalName>PCL.Desktop.Embedded.PCL.N.Plugin.Abstractions.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PclPluginSdkAssembly)"
                      Condition="'$(PclPluginSdkAssembly)' != '' and Exists('$(PclPluginSdkAssembly)')">
      <LogicalName>PCL.Desktop.Embedded.PCL.N.Plugin.Sdk.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PclPluginUiAssembly)"
                      Condition="'$(PclPluginUiAssembly)' != '' and Exists('$(PclPluginUiAssembly)')">
      <LogicalName>PCL.Desktop.Embedded.PCL.N.Plugin.UI.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PclPluginUiAvaloniaAssembly)"
                      Condition="'$(PclPluginUiAvaloniaAssembly)' != '' and Exists('$(PclPluginUiAvaloniaAssembly)')">
      <LogicalName>PCL.Desktop.Embedded.PCL.N.Plugin.UI.Avalonia.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PclPluginBouncyCastleAssembly)"
                      Condition="'$(PclPluginBouncyCastleAssembly)' != '' and Exists('$(PclPluginBouncyCastleAssembly)')">
      <LogicalName>PCL.Desktop.Embedded.BouncyCastle.Cryptography.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PclPluginJsonCanonicalizerAssembly)"
                      Condition="'$(PclPluginJsonCanonicalizerAssembly)' != '' and Exists('$(PclPluginJsonCanonicalizerAssembly)')">
      <LogicalName>PCL.Desktop.Embedded.jsoncanonicalizer.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PclPluginEs6NumberSerializerAssembly)"
                      Condition="'$(PclPluginEs6NumberSerializerAssembly)' != '' and Exists('$(PclPluginEs6NumberSerializerAssembly)')">
      <LogicalName>PCL.Desktop.Embedded.es6numberserializer.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="ValidatePclPluginAssembly" BeforeTargets="PrepareForBuild" Condition="'$(PclPluginAssembly)' != ''">
    <Error Condition="!Exists('$(PclPluginAssembly)')"
           Text="PCL.Plugin assembly was requested but not found: $(PclPluginAssembly)" />
    <Error Condition="'$(PclPluginAbstractionsAssembly)' == '' or !Exists('$(PclPluginAbstractionsAssembly)')"
           Text="PCL.Plugin requires PCL.N.Plugin.Abstractions in the default load context: $(PclPluginAbstractionsAssembly)" />
    <Error Condition="'$(PclPluginSdkAssembly)' == '' or !Exists('$(PclPluginSdkAssembly)')"
           Text="PCL.Plugin requires PCL.N.Plugin.Sdk in the default load context: $(PclPluginSdkAssembly)" />
    <Error Condition="'$(PclPluginUiAssembly)' == '' or !Exists('$(PclPluginUiAssembly)')"
           Text="PCL.Plugin requires PCL.N.Plugin.UI in the default load context: $(PclPluginUiAssembly)" />
    <Error Condition="'$(PclPluginUiAvaloniaAssembly)' == '' or !Exists('$(PclPluginUiAvaloniaAssembly)')"
           Text="PCL.Plugin requires PCL.N.Plugin.UI.Avalonia in the default load context: $(PclPluginUiAvaloniaAssembly)" />
    <Error Condition="'$(PclPluginBouncyCastleAssembly)' == '' or !Exists('$(PclPluginBouncyCastleAssembly)')"
           Text="PCL.Plugin requires BouncyCastle.Cryptography: $(PclPluginBouncyCastleAssembly)" />
    <Error Condition="'$(PclPluginJsonCanonicalizerAssembly)' == '' or !Exists('$(PclPluginJsonCanonicalizerAssembly)')"
           Text="PCL.Plugin requires jsoncanonicalizer: $(PclPluginJsonCanonicalizerAssembly)" />
    <Error Condition="'$(PclPluginEs6NumberSerializerAssembly)' == '' or !Exists('$(PclPluginEs6NumberSerializerAssembly)')"
           Text="PCL.Plugin requires es6numberserializer: $(PclPluginEs6NumberSerializerAssembly)" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../PCL.Desktop.SourceGenerators/PCL.Desktop.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../PCL.Application/PCL.Application.csproj" />
    <ProjectReference Include="../PCL.Platform/PCL.Platform.csproj" />
    <ProjectReference Include="../PCL.UI.Abstractions/PCL.UI.Abstractions.csproj" />
  </ItemGroup>
  <Import Project="GenerateEmbeddedSecrets.targets" />
</Project>
