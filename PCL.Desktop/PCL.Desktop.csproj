<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <AssemblyName>PCL.Desktop</AssemblyName>
    <RootNamespace>PCL.Desktop</RootNamespace>
    <Description>PCL N cross-platform Avalonia desktop shell</Description>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <PclRuntimeVariant Condition="'$(PclRuntimeVariant)' == ''">SelfContained</PclRuntimeVariant>
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PclRuntimeVariant</_Parameter1>
      <_Parameter2>$(PclRuntimeVariant)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="InformationalVersion" />
    <CompilerVisibleProperty Include="Version" />
    <CompilerVisibleProperty Include="SourceRevisionId" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1"
                      Condition="('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))) OR $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1"
                      Condition="('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('OSX'))) OR $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))" />
    <PackageReference Include="Wacton.Unicolour" Version="6.4.0" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <AvaloniaResource Include="WpfOriginal/Images/**" />
    <EmbeddedResource Include="../PCL.Core/App/Localization/Languages/en-US.xaml">
      <LogicalName>PCL.Desktop.Localization.en-US.xaml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="metadata.json">
      <LogicalName>PCL.Desktop.metadata.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="WpfOriginal/**/*.cs" />
    <None Include="WpfOriginal/**/*.cs" />
    <None Include="WpfOriginal/**/*.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PCL.Desktop.SourceGenerators/PCL.Desktop.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../PCL.Application/PCL.Application.csproj" />
    <ProjectReference Include="../PCL.Platform/PCL.Platform.csproj" />
    <ProjectReference Include="../PCL.UI.Abstractions/PCL.UI.Abstractions.csproj" />
  </ItemGroup>
</Project>
