<Window
    x:Class="PCL.Desktop.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PCL.Desktop.ViewModels"
    x:CompileBindings="True"
    Title="PCL N"
    Width="1080"
    Height="700"
    MinWidth="900"
    MinHeight="600"
    Background="#F4F7FB">
  <Window.Styles>
    <Style Selector="Button.nav-item">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#DDE8F7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.nav-item:pointerover">
      <Setter Property="Background" Value="#203A5D" />
    </Style>
    <Style Selector="Button.nav-item.selected">
      <Setter Property="Background" Value="#285A8E" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.info-card">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="8" />
    </Style>
    <Style Selector="TextBlock.card-label">
      <Setter Property="Foreground" Value="#65758B" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.card-value">
      <Setter Property="Foreground" Value="#172A43" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border
        Grid.Row="0"
        x:Name="MacTitleBar"
        IsVisible="{CompiledBinding Environment.IsMacOS}"
        Height="42"
        Background="#14263D"
        PointerPressed="MacTitleBar_OnPointerPressed">
      <Grid ColumnDefinitions="Auto,*" Margin="16,0">
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
          <Button
              Width="13"
              Height="13"
              Padding="0"
              Background="#FF5F57"
              BorderBrush="#E0443E"
              BorderThickness="1"
              CornerRadius="7"
              Click="CloseButton_OnClick" />
          <Button
              Width="13"
              Height="13"
              Padding="0"
              Background="#FEBC2E"
              BorderBrush="#D89A1B"
              BorderThickness="1"
              CornerRadius="7"
              Click="MinimizeButton_OnClick" />
          <Button
              Width="13"
              Height="13"
              Padding="0"
              Background="#28C840"
              BorderBrush="#1DA934"
              BorderThickness="1"
              CornerRadius="7"
              IsEnabled="False"
              ToolTip.Tip="暂不支持全屏" />
        </StackPanel>
        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="8"
            Margin="14,0,0,0"
            VerticalAlignment="Center">
          <Border
              Width="22"
              Height="22"
              Background="#285A8E"
              CornerRadius="6">
            <TextBlock
                Text="P"
                Foreground="White"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
          </Border>
          <TextBlock
              Text="PCL N"
              Foreground="White"
              FontSize="13"
              FontWeight="SemiBold"
              VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="244,*">
    <Border Grid.Column="0" Background="#14263D" Padding="20,28">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel>
          <TextBlock
              Text="PCL N"
              Foreground="White"
              FontSize="28"
              FontWeight="Bold" />
          <TextBlock
              Text="跨平台启动器"
              Foreground="#9DB2CE"
              FontSize="13"
              Margin="0,4,0,22" />
        </StackPanel>

        <ItemsControl
            Grid.Row="1"
            ItemsSource="{CompiledBinding NavigationItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationItemViewModel">
              <Button
                  Classes="nav-item"
                  Classes.selected="{CompiledBinding IsSelected}"
                  Command="{CompiledBinding OpenCommand}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock
                      Text="{CompiledBinding Title}"
                      VerticalAlignment="Center"
                      FontSize="15" />
                  <Border
                      Grid.Column="1"
                      IsVisible="{CompiledBinding IsComingSoon}"
                      Background="#344A67"
                      CornerRadius="9"
                      Padding="7,2">
                    <TextBlock
                        Text="敬请期待"
                        Foreground="#C8D6E9"
                        FontSize="10" />
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border
            Grid.Row="2"
            Background="#1D3552"
            CornerRadius="10"
            Padding="14">
          <StackPanel>
            <TextBlock
                Text="核心状态"
                Foreground="#9DB2CE"
                FontSize="12" />
            <TextBlock
                Text="{CompiledBinding RuntimeStatus}"
                Foreground="#E4F4E9"
                FontWeight="SemiBold"
                Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="32,28">
        <TextBlock
            Text="{CompiledBinding SelectedTitle}"
            Foreground="#172A43"
            FontSize="30"
            FontWeight="Bold" />
        <TextBlock
            Text="{CompiledBinding SelectedDescription}"
            Foreground="#65758B"
            FontSize="15"
            Margin="0,6,0,22" />

        <Border
            Background="#E5F2FF"
            BorderBrush="#BCD9F5"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18"
            Margin="0,0,0,16">
          <Grid ColumnDefinitions="Auto,*">
            <Border
                Width="10"
                Height="10"
                Background="#2E8B57"
                CornerRadius="5"
                VerticalAlignment="Center"
                Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
              <TextBlock
                  Text="运行环境已就绪"
                  Foreground="#173B61"
                  FontWeight="SemiBold" />
              <TextBlock
                  Text="跨平台核心、平台适配与插件契约已完成加载。"
                  Foreground="#496A89"
                  FontSize="13"
                  Margin="0,3,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
          <Border Classes="info-card" Grid.Row="0" Grid.Column="0">
            <StackPanel>
              <TextBlock Classes="card-label" Text="操作系统" />
              <TextBlock
                  Classes="card-value"
                  Text="{CompiledBinding Environment.OperatingSystem}"
                  Margin="0,7,0,0" />
            </StackPanel>
          </Border>
          <Border Classes="info-card" Grid.Row="0" Grid.Column="1">
            <StackPanel>
              <TextBlock Classes="card-label" Text="处理器" />
              <TextBlock
                  Classes="card-value"
                  Text="{CompiledBinding Environment.Processor}"
                  Margin="0,7,0,0" />
              <TextBlock
                  Text="{CompiledBinding Environment.Memory}"
                  Foreground="#65758B"
                  FontSize="12"
                  Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Border Classes="info-card" Grid.Row="1" Grid.Column="0">
            <StackPanel>
              <TextBlock Classes="card-label" Text="数据目录" />
              <TextBlock
                  Classes="card-value"
                  Text="{CompiledBinding Environment.ApplicationDataDirectory}"
                  FontSize="13"
                  Margin="0,7,0,0" />
            </StackPanel>
          </Border>
          <Border Classes="info-card" Grid.Row="1" Grid.Column="1">
            <StackPanel>
              <TextBlock Classes="card-label" Text="缓存目录" />
              <TextBlock
                  Classes="card-value"
                  Text="{CompiledBinding Environment.CacheDirectory}"
                  FontSize="13"
                  Margin="0,7,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </Grid>
</Window>
