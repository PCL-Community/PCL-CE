<Window
    x:Class="PCL.Desktop.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animation="using:Avalonia.Animation"
    xmlns:buttons="using:PCL.Desktop.Controls.Buttons"
    xmlns:feedback="using:PCL.Desktop.ViewModels.Feedback"
    xmlns:icons="using:PCL.Desktop.Controls.Icons"
    xmlns:vm="using:PCL.Desktop.ViewModels"
    x:CompileBindings="True"
    Title="PCL N"
    Icon="avares://PCL.Desktop/Assets/icon.png"
    Width="1120"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    CanMaximize="False"
    FontFamily="{DynamicResource FontFamilyDefault}"
    Background="{DynamicResource ColorBrushPageBackground}">
  <Window.Styles>
    <Style Selector="Button.nav-item">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="4,8" />
      <Setter Property="Margin" Value="2,1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>
    <Style Selector="Button.nav-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource ColorBrushSidebarHover}" />
    </Style>
    <Style Selector="Button.nav-item.selected">
      <Setter Property="Background" Value="{DynamicResource ColorBrush7}" />
      <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
    </Style>
    <Style Selector="icons|LucideIcon.nav-icon">
      <Setter Property="Stroke" Value="{DynamicResource ColorBrush1}" />
    </Style>
    <Style Selector="icons|LucideIcon.nav-icon.selected">
      <Setter Property="Stroke" Value="{DynamicResource ColorBrush2}" />
    </Style>
    <Style Selector="Button.title-command">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border
              Background="{TemplateBinding Background}"
              CornerRadius="{DynamicResource RadiusSmall}">
            <ContentPresenter
                Content="{TemplateBinding Content}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.title-command:pointerover">
      <Setter Property="Background" Value="#28FFFFFF" />
    </Style>
    <Style Selector="Button.title-command.close:pointerover">
      <Setter Property="Background" Value="#E81123" />
    </Style>
    <Style Selector="Button.mac-light">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="7" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Border.message">
      <Setter Property="MinWidth" Value="240" />
      <Setter Property="MaxWidth" Value="520" />
      <Setter Property="Background" Value="{DynamicResource ColorBrushHintInfo}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadowIdle}" />
    </Style>
    <Style Selector="Border.message.success">
      <Setter Property="Background" Value="{DynamicResource ColorBrushHintSuccess}" />
    </Style>
    <Style Selector="Border.message.warning">
      <Setter Property="Background" Value="{DynamicResource ColorBrushHintWarning}" />
    </Style>
    <Style Selector="Border.message.error">
      <Setter Property="Background" Value="{DynamicResource ColorBrushHintError}" />
    </Style>
  </Window.Styles>

  <Grid>
    <Grid RowDefinitions="Auto,*">
      <Border
          Grid.Row="0"
          x:Name="CustomTitleBar"
          Height="48"
          Background="{DynamicResource ColorBrush2}"
          PointerPressed="TitleBar_OnPointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0,8,0">
          <StackPanel
              IsVisible="{CompiledBinding Environment.IsMacOS}"
              Orientation="Horizontal"
              Spacing="8"
              VerticalAlignment="Center">
            <Button
                Classes="mac-light"
                Background="#FF5F57"
                BorderBrush="#E0443E"
                Click="CloseButton_OnClick" />
            <Button
                Classes="mac-light"
                Background="#FEBC2E"
                BorderBrush="#D89A1B"
                Click="MinimizeButton_OnClick" />
          </StackPanel>
          <StackPanel
              Grid.Column="1"
              Orientation="Horizontal"
              Spacing="8"
              Margin="12,0,0,0"
              VerticalAlignment="Center">
            <TextBlock
                Text="PCL N"
                Foreground="White"
                FontSize="17"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel
              Grid.Column="2"
              IsVisible="{CompiledBinding Environment.IsNotMacOS}"
              Orientation="Horizontal"
              VerticalAlignment="Center">
            <Button
                Classes="title-command"
                Click="MinimizeButton_OnClick"
                ToolTip.Tip="最小化">
              <icons:LucideIcon
                  IconKey="lucide/minus"
                  Stroke="White"
                  Width="15"
                  Height="15" />
            </Button>
            <Button
                Classes="title-command close"
                Click="CloseButton_OnClick"
                ToolTip.Tip="关闭">
              <icons:LucideIcon
                  IconKey="lucide/x"
                  Stroke="White"
                  Width="15"
                  Height="15" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="48,210,*">
        <Border
            Grid.Column="0"
            Background="{DynamicResource ColorBrushSidebar}"
            BorderBrush="{DynamicResource ColorBrush6}"
            BorderThickness="0,0,1,0"
            Padding="1,8">
          <Grid RowDefinitions="*,Auto">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{CompiledBinding NavigationSections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavigationSectionViewModel">
                    <Button
                        Classes="nav-item"
                        Classes.selected="{CompiledBinding IsSelected}"
                        Command="{CompiledBinding OpenCommand}">
                      <StackPanel Spacing="3">
                        <icons:LucideIcon
                            Classes="nav-icon"
                            Classes.selected="{CompiledBinding IsSelected}"
                            IconKey="{CompiledBinding IconKey}"
                            Width="17"
                            Height="17"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="{CompiledBinding Title}"
                            HorizontalAlignment="Center"
                            FontSize="10"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Border
                Grid.Row="1"
                Width="8"
                Height="8"
                Margin="0,10"
                Background="{DynamicResource ColorBrushSuccess}"
                CornerRadius="4"
                ToolTip.Tip="{CompiledBinding RuntimeStatus}"
                HorizontalAlignment="Center" />
          </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Background="{DynamicResource ColorBrushTransparentBackground}"
            BorderBrush="{DynamicResource ColorBrush6}"
            BorderThickness="0,0,1,0"
            Padding="12,18,12,12">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Margin="8,0,8,14">
              <Grid ColumnDefinitions="Auto,*">
                <icons:LucideIcon
                    IconKey="{CompiledBinding SelectedIconKey}"
                    Stroke="{DynamicResource ColorBrush2}"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{CompiledBinding SelectedTitle}"
                    Foreground="{DynamicResource ColorBrush1}"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Margin="9,0,0,0"
                    VerticalAlignment="Center" />
              </Grid>
              <TextBlock
                  Text="{CompiledBinding SelectedDescription}"
                  Foreground="{DynamicResource ColorBrushGray4}"
                  FontSize="11"
                  TextWrapping="Wrap"
                  Margin="0,7,0,0" />
            </StackPanel>
            <ItemsControl
                Grid.Row="1"
                ItemsSource="{CompiledBinding SelectedSection.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                  <Button
                      Classes="nav-item"
                      Classes.selected="{CompiledBinding IsSelected}"
                      Command="{CompiledBinding OpenCommand}"
                      Padding="10,8"
                      Margin="0,1"
                      HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <icons:LucideIcon
                          Classes="nav-icon"
                          Classes.selected="{CompiledBinding IsSelected}"
                          IconKey="{CompiledBinding IconKey}"
                          Width="16"
                          Height="16"
                          Margin="0,0,9,0"
                          VerticalAlignment="Center" />
                      <TextBlock
                          Grid.Column="1"
                          Text="{CompiledBinding Title}"
                          FontSize="{DynamicResource FontSizeBody}"
                          VerticalAlignment="Center" />
                      <TextBlock
                          Grid.Column="2"
                          IsVisible="{CompiledBinding IsComingSoon}"
                          Text="敬请期待"
                          Foreground="{DynamicResource ColorBrushGray4}"
                          FontSize="10"
                          VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <Grid Grid.Column="2">
          <TransitioningContentControl
              Content="{CompiledBinding CurrentPage}"
              Margin="{DynamicResource PageMargin}">
            <TransitioningContentControl.PageTransition>
              <animation:CrossFade Duration="0:0:0.2" />
            </TransitioningContentControl.PageTransition>
          </TransitioningContentControl>
        </Grid>
      </Grid>
    </Grid>

    <ItemsControl
        ItemsSource="{CompiledBinding Messages}"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,70,20"
        IsHitTestVisible="True">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="feedback:InAppMessageViewModel">
          <Border
              Classes="message"
              Classes.success="{CompiledBinding IsSuccess}"
              Classes.warning="{CompiledBinding IsWarning}"
              Classes.error="{CompiledBinding IsError}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <icons:LucideIcon
                  IconKey="{CompiledBinding IconKey}"
                  Stroke="White"
                  Width="18"
                  Height="18"
                  Margin="0,0,9,0"
                  VerticalAlignment="Center" />
              <TextBlock
                  Grid.Column="1"
                  Text="{CompiledBinding Message}"
                  Foreground="White"
                  FontSize="{DynamicResource FontSizeBody}"
                  TextWrapping="Wrap"
                  VerticalAlignment="Center" />
              <buttons:PclIconButton
                  Grid.Column="2"
                  IconKey="lucide/x"
                  AccessibleName="关闭提示"
                  Command="{CompiledBinding DismissCommand}"
                  Foreground="White"
                  BorderBrush="Transparent"
                  Background="Transparent"
                  Width="24"
                  MinWidth="24"
                  MinHeight="24"
                  Padding="4"
                  Margin="8,0,0,0" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border
        VerticalAlignment="Top"
        Height="6"
        Background="Transparent"
        PointerPressed="ResizeTop_OnPointerPressed" />
    <Border
        VerticalAlignment="Bottom"
        Height="6"
        Background="Transparent"
        PointerPressed="ResizeBottom_OnPointerPressed" />
    <Border
        HorizontalAlignment="Left"
        Width="6"
        Background="Transparent"
        PointerPressed="ResizeLeft_OnPointerPressed" />
    <Border
        HorizontalAlignment="Right"
        Width="6"
        Background="Transparent"
        PointerPressed="ResizeRight_OnPointerPressed" />
    <Border
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Width="10"
        Height="10"
        Background="Transparent"
        PointerPressed="ResizeTopLeft_OnPointerPressed" />
    <Border
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Width="10"
        Height="10"
        Background="Transparent"
        PointerPressed="ResizeTopRight_OnPointerPressed" />
    <Border
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Width="10"
        Height="10"
        Background="Transparent"
        PointerPressed="ResizeBottomLeft_OnPointerPressed" />
    <Border
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Width="10"
        Height="10"
        Background="Transparent"
        PointerPressed="ResizeBottomRight_OnPointerPressed" />
  </Grid>
</Window>
