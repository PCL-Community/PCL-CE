<UserControl
    x:Class="PCL.Desktop.Pages.Common.PlaceholderPage"
    x:DataType="vm:PlaceholderPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:PCL.Desktop.Controls.Icons"
    xmlns:vm="using:PCL.Desktop.ViewModels.Common"
    x:CompileBindings="True">
  <Border
      Background="{DynamicResource ColorBrushPanelBackground}"
      CornerRadius="{DynamicResource RadiusLarge}"
      Padding="40"
      MinHeight="340">
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        MaxWidth="460"
        Spacing="12">
      <Border
          Width="64"
          Height="64"
          Background="{DynamicResource ColorBrush7}"
          CornerRadius="18">
        <icons:LucideIcon
            IconKey="{CompiledBinding IconKey}"
            Stroke="{DynamicResource ColorBrush2}"
            Width="30"
            Height="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
      </Border>
      <TextBlock
          Text="{CompiledBinding Title}"
          Foreground="{DynamicResource ColorBrush1}"
          FontSize="{DynamicResource FontSizeTitle}"
          FontWeight="SemiBold"
          HorizontalAlignment="Center" />
      <TextBlock
          Text="{CompiledBinding Description}"
          Foreground="{DynamicResource ColorBrush4}"
          TextAlignment="Center"
          TextWrapping="Wrap" />
      <Border
          IsVisible="{CompiledBinding IsComingSoon}"
          Background="{DynamicResource ColorBrush7}"
          CornerRadius="10"
          Padding="10,4">
        <TextBlock
            Text="敬请期待"
            Foreground="{DynamicResource ColorBrush2}"
            FontSize="{DynamicResource FontSizeCaption}" />
      </Border>
    </StackPanel>
  </Border>
</UserControl>
