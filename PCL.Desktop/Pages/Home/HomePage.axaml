<UserControl
    x:Class="PCL.Desktop.Pages.Home.HomePage"
    x:DataType="vm:HomePageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="using:PCL.Desktop.Controls.Cards"
    xmlns:icons="using:PCL.Desktop.Controls.Icons"
    xmlns:vm="using:PCL.Desktop.ViewModels.Home"
    x:CompileBindings="True">
  <StackPanel Spacing="16">
    <Border
        Background="#1858A9E8"
        BorderBrush="#5558A9E8"
        BorderThickness="1"
        CornerRadius="{DynamicResource RadiusLarge}"
        Padding="18">
      <Grid ColumnDefinitions="Auto,*">
        <Border
            Width="34"
            Height="34"
            Background="{DynamicResource ColorBrush2}"
            CornerRadius="{DynamicResource RadiusMedium}">
          <icons:LucideIcon
              IconKey="lucide/circle-check"
              Stroke="White"
              Width="18"
              Height="18"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0">
          <TextBlock
              Text="运行环境已就绪"
              Foreground="{DynamicResource ColorBrush1}"
              FontWeight="SemiBold"
              FontSize="{DynamicResource FontSizeBodyLarge}" />
          <TextBlock
              Text="跨平台核心、平台适配、插件契约与 Avalonia UI 基础设施已完成加载。"
              Foreground="{DynamicResource ColorBrush4}"
              FontSize="{DynamicResource FontSizeBody}"
              Margin="0,4,0,0"
              TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
      <cards:PclCard Header="操作系统" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
        <TextBlock
            Text="{CompiledBinding Environment.OperatingSystem}"
            Foreground="{DynamicResource ColorBrush1}"
            FontSize="16"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />
      </cards:PclCard>
      <cards:PclCard Header="处理器" Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
        <StackPanel>
          <TextBlock
              Text="{CompiledBinding Environment.Processor}"
              Foreground="{DynamicResource ColorBrush1}"
              FontSize="16"
              FontWeight="SemiBold"
              TextWrapping="Wrap" />
          <TextBlock
              Text="{CompiledBinding Environment.Memory}"
              Foreground="{DynamicResource ColorBrush4}"
              FontSize="{DynamicResource FontSizeCaption}"
              Margin="0,4,0,0" />
        </StackPanel>
      </cards:PclCard>
      <cards:PclCard Header="数据目录" Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
        <TextBlock
            Text="{CompiledBinding Environment.ApplicationDataDirectory}"
            Foreground="{DynamicResource ColorBrush1}"
            FontFamily="{DynamicResource FontFamilyMono}"
            FontSize="{DynamicResource FontSizeCaption}"
            TextWrapping="Wrap" />
      </cards:PclCard>
      <cards:PclCard Header="缓存目录" Grid.Row="1" Grid.Column="1" Margin="8,8,0,0">
        <TextBlock
            Text="{CompiledBinding Environment.CacheDirectory}"
            Foreground="{DynamicResource ColorBrush1}"
            FontFamily="{DynamicResource FontFamilyMono}"
            FontSize="{DynamicResource FontSizeCaption}"
            TextWrapping="Wrap" />
      </cards:PclCard>
    </Grid>
  </StackPanel>
</UserControl>
