<!-- Embed CI secrets when PCL_WRITE_SECRET=1. Semicolons must be %3B in Include attributes. -->
<Project>
  <PropertyGroup>
    <PclEmbeddedSecretsFile>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\PclEmbeddedSecrets.g.cs</PclEmbeddedSecretsFile>
  </PropertyGroup>

  <Target Name="GeneratePclEmbeddedSecrets" BeforeTargets="BeforeCompile;CoreCompile" DependsOnTargets="PrepareForBuild">
    <PropertyGroup>
      <_WriteSecret Condition="'$(PclWriteSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_WRITE_SECRET'))</_WriteSecret>
      <_WriteSecret Condition="'$(PclWriteSecret)' != ''">$(PclWriteSecret)</_WriteSecret>
      <_MsClientId Condition="'$(PclMsClientId)' != ''">$(PclMsClientId)</_MsClientId>
      <_MsClientId Condition="'$(_MsClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_MS_CLIENT_ID'))</_MsClientId>
      <_MsClientId Condition="'$(_MsClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('MS_CLIENT_ID'))</_MsClientId>
      <_CurseKey Condition="'$(PclCurseForgeApiKey)' != ''">$(PclCurseForgeApiKey)</_CurseKey>
      <_CurseKey Condition="'$(_CurseKey)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_CURSEFORGE_API_KEY'))</_CurseKey>
      <_Sentry Condition="'$(PclSentryDsn)' != ''">$(PclSentryDsn)</_Sentry>
      <_Sentry Condition="'$(_Sentry)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_SENTRY_DSN'))</_Sentry>
      <_NaidId Condition="'$(PclNaidClientId)' != ''">$(PclNaidClientId)</_NaidId>
      <_NaidId Condition="'$(_NaidId)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_NAID_CLIENT_ID'))</_NaidId>
      <_NaidSecret Condition="'$(PclNaidClientSecret)' != ''">$(PclNaidClientSecret)</_NaidSecret>
      <_NaidSecret Condition="'$(_NaidSecret)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_NAID_CLIENT_SECRET'))</_NaidSecret>
      <_LinkRoot Condition="'$(PclLinkServerRoot)' != ''">$(PclLinkServerRoot)</_LinkRoot>
      <_LinkRoot Condition="'$(_LinkRoot)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LINK_SERVER_ROOT'))</_LinkRoot>
      <_Lobby Condition="'$(PclLobbyDefaultSecret)' != ''">$(PclLobbyDefaultSecret)</_Lobby>
      <_Lobby Condition="'$(_Lobby)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_LOBBY_DEFAULT_SECRET'))</_Lobby>
      <_Sha Condition="'$(PclGithubSha)' != ''">$(PclGithubSha)</_Sha>
      <_Sha Condition="'$(_Sha)' == ''">$([System.Environment]::GetEnvironmentVariable('PCL_GITHUB_SHA'))</_Sha>
      <_ShouldWrite Condition="'$(_WriteSecret)' == '1' Or '$(_WriteSecret)' == 'true' Or '$(_WriteSecret)' == 'TRUE'">true</_ShouldWrite>
      <_MsEsc>$([System.String]::Copy('$(_MsClientId)').Replace('"', '""'))</_MsEsc>
      <_CurseEsc>$([System.String]::Copy('$(_CurseKey)').Replace('"', '""'))</_CurseEsc>
      <_SentryEsc>$([System.String]::Copy('$(_Sentry)').Replace('"', '""'))</_SentryEsc>
      <_NaidIdEsc>$([System.String]::Copy('$(_NaidId)').Replace('"', '""'))</_NaidIdEsc>
      <_NaidSecretEsc>$([System.String]::Copy('$(_NaidSecret)').Replace('"', '""'))</_NaidSecretEsc>
      <_LinkEsc>$([System.String]::Copy('$(_LinkRoot)').Replace('"', '""'))</_LinkEsc>
      <_LobbyEsc>$([System.String]::Copy('$(_Lobby)').Replace('"', '""'))</_LobbyEsc>
      <_ShaEsc>$([System.String]::Copy('$(_Sha)').Replace('"', '""'))</_ShaEsc>
    </PropertyGroup>

    <ItemGroup>
      <_SecretLine Include="// &lt;auto-generated /&gt;" />
      <_SecretLine Include="// Embedded CI secrets - GenerateEmbeddedSecrets.targets" />
      <_SecretLine Include="#nullable enable" />
      <_SecretLine Include="using System%3B" />
      <_SecretLine Include="using System.Collections.Generic%3B" />
      <_SecretLine Include="namespace PCL.Desktop%3B" />
      <_SecretLine Include="internal static class PclEmbeddedSecrets" />
      <_SecretLine Include="{" />
      <_SecretLine Include="    private static readonly Dictionary&lt;string, string&gt; Values = new(StringComparer.Ordinal)" />
      <_SecretLine Include="    {" />
    </ItemGroup>
    <ItemGroup Condition="'$(_ShouldWrite)' == 'true' And '$(_MsClientId)' != ''">
      <_SecretLine Include="        [&quot;MS_CLIENT_ID&quot;] = @&quot;$(_MsEsc)&quot;," />
    </ItemGroup>
    <ItemGroup Condition="'$(_ShouldWrite)' == 'true' And '$(_CurseKey)' != ''">
      <_SecretLine Include="        [&quot;CURSEFORGE_API_KEY&quot;] = @&quot;$(_CurseEsc)&quot;," />
    </ItemGroup>
    <ItemGroup Condition="'$(_ShouldWrite)' == 'true' And '$(_Sentry)' != ''">
      <_SecretLine Include="        [&quot;SENTRY_DSN&quot;] = @&quot;$(_SentryEsc)&quot;," />
    </ItemGroup>
    <ItemGroup Condition="'$(_ShouldWrite)' == 'true' And '$(_NaidId)' != ''">
      <_SecretLine Include="        [&quot;NAID_CLIENT_ID&quot;] = @&quot;$(_NaidIdEsc)&quot;," />
    </ItemGroup>
    <ItemGroup Condition="'$(_ShouldWrite)' == 'true' And '$(_NaidSecret)' != ''">
      <_SecretLine Include="        [&quot;NAID_CLIENT_SECRET&quot;] = @&quot;$(_NaidSecretEsc)&quot;," />
    </ItemGroup>
    <ItemGroup Condition="'$(_ShouldWrite)' == 'true' And '$(_LinkRoot)' != ''">
      <_SecretLine Include="        [&quot;LINK_SERVER_ROOT&quot;] = @&quot;$(_LinkEsc)&quot;," />
    </ItemGroup>
    <ItemGroup Condition="'$(_ShouldWrite)' == 'true' And '$(_Lobby)' != ''">
      <_SecretLine Include="        [&quot;LOBBY_DEFAULT_SECRET&quot;] = @&quot;$(_LobbyEsc)&quot;," />
    </ItemGroup>
    <ItemGroup Condition="'$(_ShouldWrite)' == 'true' And '$(_Sha)' != ''">
      <_SecretLine Include="        [&quot;GITHUB_SHA&quot;] = @&quot;$(_ShaEsc)&quot;," />
    </ItemGroup>
    <ItemGroup>
      <_SecretLine Include="    }%3B" />
      <_SecretLine Include="    public static int Count { get { return Values.Count%3B } }" />
      <_SecretLine Include="    public static string Get(string key)" />
      <_SecretLine Include="    {" />
      <_SecretLine Include="        if (string.IsNullOrWhiteSpace(key)) return string.Empty%3B" />
      <_SecretLine Include="        if (Values.TryGetValue(key, out string? value) &amp;&amp; value is not null) return value%3B" />
      <_SecretLine Include="        return string.Empty%3B" />
      <_SecretLine Include="    }" />
      <_SecretLine Include="    public static void ApplyToEnvironment()" />
      <_SecretLine Include="    {" />
      <_SecretLine Include="        foreach (KeyValuePair&lt;string, string&gt; pair in Values)" />
      <_SecretLine Include="        {" />
      <_SecretLine Include="            if (string.IsNullOrWhiteSpace(pair.Value)) continue%3B" />
      <_SecretLine Include="            string pclKey = &quot;PCL_&quot; + pair.Key%3B" />
      <_SecretLine Include="            if (string.IsNullOrEmpty(Environment.GetEnvironmentVariable(pclKey)))" />
      <_SecretLine Include="                Environment.SetEnvironmentVariable(pclKey, pair.Value)%3B" />
      <_SecretLine Include="            if (string.IsNullOrEmpty(Environment.GetEnvironmentVariable(pair.Key)))" />
      <_SecretLine Include="                Environment.SetEnvironmentVariable(pair.Key, pair.Value)%3B" />
      <_SecretLine Include="        }" />
      <_SecretLine Include="    }" />
      <_SecretLine Include="}" />
    </ItemGroup>

    <MakeDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)" />
    <WriteLinesToFile File="$(PclEmbeddedSecretsFile)" Lines="@(_SecretLine)" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Remove="$(PclEmbeddedSecretsFile)" />
      <Compile Include="$(PclEmbeddedSecretsFile)" />
      <FileWrites Include="$(PclEmbeddedSecretsFile)" />
    </ItemGroup>
    <Message Importance="high" Text="PclEmbeddedSecrets: write=$(_ShouldWrite) hasMsClient=$([System.Convert]::ToString('$(_MsClientId)' != '')) path=$(PclEmbeddedSecretsFile)" />
  </Target>
</Project>
