<Grid x:Class="PCL.Desktop.Controls.Legacy.MyMsgText"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:legacy="using:PCL.Desktop.Controls.Legacy"
      RenderTransformOrigin="0%,50%"
      MinWidth="400"
      MaxWidth="720"
      MaxHeight="560"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Margin="25">
    <Grid.RenderTransform>
        <TransformGroup>
            <RotateTransform Angle="-4" />
            <TranslateTransform X="0" Y="40" />
        </TransformGroup>
    </Grid.RenderTransform>
    <Border x:Name="PanBorder"
            CornerRadius="8"
            Background="{DynamicResource ColorBrushBackground}"
            BoxShadow="0 4 28 0 #663c3c3c"
            ClipToBounds="False">
        <!-- Auto rows only: never starve caption with * height under Center alignment -->
        <Grid x:Name="PanMain"
              VerticalAlignment="Top"
              Margin="22,22,22,20"
              RowDefinitions="Auto,2,12,Auto,16,Auto">
            <TextBlock Grid.Row="0"
                       x:Name="LabTitle"
                       FontSize="23"
                       TextTrimming="None"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ColorBrush2}"
                       HorizontalAlignment="Left"
                       Margin="7,-1,12,9"
                       Text="提示"
                       VerticalAlignment="Top" />
            <Rectangle x:Name="ShapeLine"
                       Grid.Row="1"
                       Height="2"
                       Fill="{DynamicResource ColorBrush2}" />
            <legacy:MyScrollViewer Grid.Row="3"
                                   VerticalAlignment="Top"
                                   Margin="0,0,0,0"
                                   Padding="7,0,8,4"
                                   MaxHeight="320"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="LabCaption"
                           TextTrimming="None"
                           TextWrapping="Wrap"
                           FontSize="15"
                           LineHeight="22"
                           Foreground="{DynamicResource ColorBrush1}"
                           FontWeight="Normal"
                           Padding="1,0,4,8" />
            </legacy:MyScrollViewer>
            <StackPanel Grid.Row="5"
                        x:Name="PanBtn"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Margin="12,0,4,0"
                        Orientation="Horizontal">
                <legacy:MyButton ColorType="Normal"
                                 Text="确定"
                                 x:Name="Btn1"
                                 Margin="12,0,0,0"
                                 Padding="5,0"
                                 MinHeight="32"
                                 Click="Btn1Click" />
                <legacy:MyButton ColorType="Normal"
                                 Text="取消"
                                 x:Name="Btn2"
                                 Margin="12,0,0,0"
                                 Padding="5,0"
                                 MinHeight="32"
                                 IsVisible="False"
                                 Click="Btn2Click" />
                <legacy:MyButton ColorType="Normal"
                                 Text="关闭"
                                 x:Name="Btn3"
                                 Margin="12,0,0,0"
                                 Padding="5,0"
                                 MinHeight="32"
                                 IsVisible="False"
                                 Click="Btn3Click" />
            </StackPanel>
        </Grid>
    </Border>
</Grid>
