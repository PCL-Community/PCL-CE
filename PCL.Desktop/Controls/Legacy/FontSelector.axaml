<ContentControl x:Class="PCL.Desktop.Controls.Legacy.FontSelector"
                xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:legacy="using:PCL.Desktop.Controls.Legacy">
    <legacy:MyComboBox x:Name="ComboFont"
                       SelectionChanged="ComboFontSelectionChanged">
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Name}"
                           FontFamily="{Binding Font}" />
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </legacy:MyComboBox>
</ContentControl>
