<UserControl
    x:Class="PCL.Desktop.Controls.Log.LogViewer"
    x:DataType="vm:LogPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:logVm="using:PCL.Desktop.ViewModels.Log"
    xmlns:vm="using:PCL.Desktop.ViewModels.Log"
    x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Border.log-line">
      <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush6}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.log-line:pointerover">
      <Setter Property="Background" Value="{DynamicResource ColorBrush7}" />
    </Style>
    <Style Selector="TextBlock.level">
      <Setter Property="Foreground" Value="{DynamicResource ColorBrushInfo}" />
    </Style>
    <Style Selector="TextBlock.level.debug">
      <Setter Property="Foreground" Value="{DynamicResource ColorBrushDebug}" />
    </Style>
    <Style Selector="TextBlock.level.warning">
      <Setter Property="Foreground" Value="{DynamicResource ColorBrushWarn}" />
    </Style>
    <Style Selector="TextBlock.level.error">
      <Setter Property="Foreground" Value="{DynamicResource ColorBrushError}" />
    </Style>
  </UserControl.Styles>

  <ListBox
      x:Name="LogList"
      ItemsSource="{CompiledBinding Lines}"
      Background="Transparent"
      BorderThickness="0">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="logVm:LogLineViewModel">
        <Border Classes="log-line">
          <Grid ColumnDefinitions="92,72,120,*">
            <TextBlock
                Text="{CompiledBinding TimeText}"
                Foreground="{DynamicResource ColorBrush5}"
                FontFamily="Consolas,Menlo,Monospace"
                FontSize="{DynamicResource FontSizeCaption}" />
            <TextBlock
                Grid.Column="1"
                Classes="level"
                Classes.debug="{CompiledBinding IsDebug}"
                Classes.warning="{CompiledBinding IsWarning}"
                Classes.error="{CompiledBinding IsError}"
                Text="{CompiledBinding LevelText}"
                FontWeight="SemiBold"
                FontSize="{DynamicResource FontSizeCaption}" />
            <TextBlock
                Grid.Column="2"
                Text="{CompiledBinding Module}"
                Foreground="{DynamicResource ColorBrush4}"
                TextTrimming="CharacterEllipsis"
                Margin="0,0,12,0" />
            <StackPanel Grid.Column="3" Spacing="5">
              <TextBlock
                  Text="{CompiledBinding Message}"
                  Foreground="{DynamicResource ColorBrush1}"
                  TextWrapping="Wrap" />
              <TextBlock
                  IsVisible="{CompiledBinding HasException}"
                  Text="{CompiledBinding ExceptionText}"
                  Foreground="{DynamicResource ColorBrushError}"
                  FontFamily="Consolas,Menlo,Monospace"
                  FontSize="{DynamicResource FontSizeCaption}"
                  TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
