<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="DurationFastMilliseconds">80</x:Double>
  <x:Double x:Key="DurationEnterMilliseconds">100</x:Double>
  <x:Double x:Key="DurationLeaveMilliseconds">200</x:Double>
  <x:Double x:Key="DurationNormalMilliseconds">300</x:Double>
  <x:Double x:Key="DurationSlowMilliseconds">700</x:Double>
  <x:Double x:Key="ScalePressed">0.955</x:Double>
  <x:Double x:Key="ScaleNormal">1</x:Double>
</ResourceDictionary>
