<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cards="using:PCL.Desktop.Controls.Cards"
    xmlns:icons="using:PCL.Desktop.Controls.Icons">
  <Style Selector="cards|PclCard">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Background" Value="{DynamicResource ColorBrushTransparentBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
            x:Name="PART_Card"
            Background="{TemplateBinding Background}"
            CornerRadius="{DynamicResource RadiusLarge}"
            BoxShadow="{DynamicResource CardShadowIdle}">
          <Grid RowDefinitions="Auto,*">
            <Grid
                x:Name="PART_Header"
                MinHeight="40"
                ColumnDefinitions="*,Auto"
                Margin="15,0,14,0">
              <ContentPresenter
                  Content="{TemplateBinding Header}"
                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                  VerticalAlignment="Center"
                  FontSize="{DynamicResource FontSizeBody}"
                  FontWeight="SemiBold"
                  Foreground="{TemplateBinding Foreground}" />
              <icons:LucideIcon
                  x:Name="PART_ExpandIcon"
                  Grid.Column="1"
                  IconKey="lucide/chevron-down"
                  Stroke="{TemplateBinding Foreground}"
                  Width="14"
                  Height="14"
                  IsVisible="{TemplateBinding IsCollapsible}"
                  VerticalAlignment="Center" />
            </Grid>
            <ContentPresenter
                x:Name="PART_Content"
                Grid.Row="1"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Padding="{DynamicResource CardPadding}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="cards|PclCard:pointerover /template/ Border#PART_Card">
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadowHover}" />
  </Style>
  <Style Selector="cards|PclCard:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
  </Style>
  <Style Selector="cards|PclCard:collapsed /template/ ContentPresenter#PART_Content">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="cards|PclCard:collapsed /template/ icons|LucideIcon#PART_ExpandIcon">
    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
  </Style>
</Styles>
