<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ColorBrush1" Color="#343D4A" />
  <SolidColorBrush x:Key="ColorBrush2" Color="#0B5BCB" />
  <SolidColorBrush x:Key="ColorBrush3" Color="#1370F3" />
  <SolidColorBrush x:Key="ColorBrush4" Color="#4890F5" />
  <SolidColorBrush x:Key="ColorBrush5" Color="#96C0F9" />
  <SolidColorBrush x:Key="ColorBrush6" Color="#D5E6FD" />
  <SolidColorBrush x:Key="ColorBrush7" Color="#E0EAFD" />
  <SolidColorBrush x:Key="ColorBrushHalfWhite" Color="#55FFFFFF" />
  <SolidColorBrush x:Key="ColorBrushSemiTransparent" Color="#01EAF2FE" />
  <SolidColorBrush x:Key="ColorBrushTransparentBackground" Color="#D2FBFBFB" />
  <SolidColorBrush x:Key="ColorBrushPageBackground" Color="#FBFBFB" />
  <SolidColorBrush x:Key="ColorBrushPanelBackground" Color="#FBFBFB" />
  <SolidColorBrush x:Key="ColorBrushSidebar" Color="#D2FBFBFB" />
  <SolidColorBrush x:Key="ColorBrushSidebarHover" Color="#E0EAFD" />
  <SolidColorBrush x:Key="ColorBrushGray4" Color="#A6A6A6" />

  <SolidColorBrush x:Key="ColorBrushRedDark" Color="#CE2111" />
  <SolidColorBrush x:Key="ColorBrushRedLight" Color="#FF4C4C" />
  <SolidColorBrush x:Key="ColorBrushRedBack" Color="#80FBDDDD" />

  <SolidColorBrush x:Key="ColorBrushDebug" Color="#7D8B9C" />
  <SolidColorBrush x:Key="ColorBrushInfo" Color="#287BC1" />
  <SolidColorBrush x:Key="ColorBrushInfoDark" Color="#1D5E96" />
  <SolidColorBrush x:Key="ColorBrushWarn" Color="#C27A14" />
  <SolidColorBrush x:Key="ColorBrushError" Color="#C44545" />
  <SolidColorBrush x:Key="ColorBrushFatal" Color="#8F2C65" />

  <SolidColorBrush x:Key="ColorBrushSuccess" Color="#278552" />
  <SolidColorBrush x:Key="ColorBrushSuccessBack" Color="#EAF7EF" />
  <SolidColorBrush x:Key="ColorBrushWarningBack" Color="#FFF6E5" />
  <SolidColorBrush x:Key="ColorBrushErrorBack" Color="#FFF0F0" />
  <SolidColorBrush x:Key="ColorBrushHintInfo" Color="#D7259BFC" />
  <SolidColorBrush x:Key="ColorBrushHintSuccess" Color="#D721B121" />
  <SolidColorBrush x:Key="ColorBrushHintWarning" Color="#D7F39C12" />
  <SolidColorBrush x:Key="ColorBrushHintError" Color="#D7FF350B" />
</ResourceDictionary>
