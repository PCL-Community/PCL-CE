<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Avalonia.Media">
  <media:FontFamily x:Key="FontFamilyDefault">Segoe UI, PingFang SC, Noto Sans CJK SC, sans-serif</media:FontFamily>
  <media:FontFamily x:Key="FontFamilyMono">Cascadia Mono, Consolas, JetBrains Mono, Menlo, monospace</media:FontFamily>
  <x:Double x:Key="FontSizeCaption">12</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeBodyLarge">14</x:Double>
  <x:Double x:Key="FontSizeTitle">19</x:Double>
  <x:Double x:Key="FontSizePageTitle">28</x:Double>
</ResourceDictionary>
