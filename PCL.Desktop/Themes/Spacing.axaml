<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="Spacing2">2</x:Double>
  <x:Double x:Key="Spacing4">4</x:Double>
  <x:Double x:Key="Spacing6">6</x:Double>
  <x:Double x:Key="Spacing8">8</x:Double>
  <x:Double x:Key="Spacing12">12</x:Double>
  <x:Double x:Key="Spacing16">16</x:Double>
  <x:Double x:Key="Spacing20">20</x:Double>
  <x:Double x:Key="ControlHeight">32</x:Double>
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
  <Thickness x:Key="CardPadding">16</Thickness>
  <Thickness x:Key="PageMargin">24</Thickness>
</ResourceDictionary>
