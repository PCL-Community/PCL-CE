<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Avalonia.Media">
  <media:BoxShadows x:Key="CardShadowIdle">0 2 10 0 #12000000</media:BoxShadows>
  <media:BoxShadows x:Key="CardShadowHover">0 4 18 0 #26000000</media:BoxShadows>
  <media:BoxShadows x:Key="DialogShadow">0 12 36 0 #30000000</media:BoxShadows>
</ResourceDictionary>
