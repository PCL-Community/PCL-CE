<Border x:Class="PCL.CrashReportDock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCL"
        xmlns:svgIcon="clr-namespace:PCL.Core.UI.Controls.SvgIcon;assembly=PCL.Core"
        x:Name="PanBack" Visibility="Collapsed" MaxWidth="360" Cursor="Hand"
        CornerRadius="8" Background="{DynamicResource ColorBrushBackground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseLeftButtonUp="PanBack_MouseLeftButtonUp">
    <Border.Effect>
        <DropShadowEffect BlurRadius="16" Opacity="0.25" ShadowDepth="4" Direction="270" Color="#000000" />
    </Border.Effect>
    <Grid Margin="12,6,6,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <svgIcon:SvgIcon x:Name="ShapeIcon" Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center"
                         Margin="0,0,8,0" Icon="lucide/triangle-alert" UseOriginalColor="False"
                         IconBrush="{DynamicResource ColorBrushWarn}" StrokeThickness="0" />
        <TextBlock x:Name="LabText" Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                   Foreground="{DynamicResource ColorBrush1}" />
        <local:MyIconButton x:Name="BtnOpen" Grid.Column="2" Width="22" Height="22" Margin="10,0,0,0"
                            SvgIcon="lucide/external-link" Theme="Custom"
                            ToolTip="{DynamicResource Crash.Dock.Entry.ToolTip}" Click="BtnOpen_Click" />
        <local:MyIconButton x:Name="BtnDiscard" Grid.Column="3" Width="22" Height="22" Margin="4,0,0,0"
                            SvgIcon="lucide/x" Theme="Custom"
                            ToolTip="{DynamicResource Crash.Dock.Discard.ToolTip}" Click="BtnDiscard_Click" />
    </Grid>
</Border>
