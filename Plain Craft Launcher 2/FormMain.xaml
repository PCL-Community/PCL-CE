                <controls:BlurBorder x:Name="PanMsgBackground" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#00000000"
                                     Panel.ZIndex="99"
                                     Visibility="Collapsed">

                    <Grid x:Name="PanMsg" Background="#00000000" MouseLeftButtonDown="FormDragMove" />

                </controls:BlurBorder>

                <!-- 隐藏占位：保持代码兼容 -->

                <local:AnimatedBackgroundGrid x:Name="RectLeftBackground" Grid.Row="1" Grid.Column="0" Width="0" Visibility="Collapsed" />

                <Rectangle x:Name="RectLeftShadow" Grid.Row="1" Grid.Column="0" Width="0" Visibility="Collapsed" />

            </Grid>

        </Border>

    </Grid>

</Window>