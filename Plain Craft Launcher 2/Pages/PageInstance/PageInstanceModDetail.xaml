<local:MyPageRight x:Class="PCL.PageInstanceModDetail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCL"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Margin="25">
            <local:MyCard x:Name="CardIntro" Margin="0,0,0,15">
                <StackPanel x:Name="PanIntro" Margin="12" Orientation="Horizontal">
                    <local:MyImage x:Name="PathLogo" Width="48" Height="48" Margin="0,0,12,0"
                                   FallbackSource="pack://application:,,,/images/Icons/NoIcon.png" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LabTitle" FontSize="16" Foreground="{DynamicResource ColorBrush1}"
                                   TextTrimming="WordEllipsis" Text="{DynamicResource Instance.ModDetail.Loading.Title}" />
                        <TextBlock x:Name="LabAuthor" FontSize="12" Foreground="{StaticResource ColorBrushGray3}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyHint x:Name="HintError" HasBorder="True" Theme="Yellow" Margin="0,0,0,15" Visibility="Collapsed" />
            <local:MyCard x:Name="CardFiles" UseAnimation="False">
                <StackPanel x:Name="PanFiles" Margin="12" />
            </local:MyCard>
            <local:MyCard x:Name="PanLoad" UseAnimation="False" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Margin="40,80" Visibility="Collapsed">
                <local:MyLoading Margin="20,20,20,17" x:Name="Load" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" Text="{DynamicResource Instance.ModDetail.Loading.Versions}" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
