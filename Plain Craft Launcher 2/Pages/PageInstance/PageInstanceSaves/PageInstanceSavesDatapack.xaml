<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
                   xmlns:loc="https://ce.pclc.cc/core/localization" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageInstanceSavesDatapack"
    PanScroll="{Binding ElementName=PanBack}" PageExit="UnselectedAllWithAnimation">
    <Grid>
        <Grid x:Name="PanAllBack">
            <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  x:Name="PanBack"
                                  Visibility="{Binding ShowDatapacks, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel x:Name="PanMain" Margin="25,10,25,10" Grid.IsSharedSizeScope="True">
                    <local:MySearchBox Margin="0,15" HintText="{loc:Loc Instance.Resource.Search.Hint}" x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}" PreviewKeyDown="SearchBox_PreviewKeyDown" TextChanged="SearchRun" />
                    <local:MyCard Margin="0,0,0,15" x:Name="PanManage">
                        <WrapPanel Margin="15,8,0,15">
                            <local:MyButton x:Name="BtnManageOpen" MinWidth="110" Text="{loc:Loc Common.Action.OpenFolder}" Padding="13,7" Command="{Binding OpenFolderCommand}"
                                            Margin="0,7,15,0" HorizontalAlignment="Left" ColorType="Highlight" />
                            <local:MyButton x:Name="BtnManageInstall" MinWidth="110" Text="{loc:Loc Instance.Resource.InstallFromFiles}" Padding="13,7" Command="{Binding InstallCommand}" IsEnabled="{Binding InstallEnabled}"
                                            Margin="0,7,15,0" HorizontalAlignment="Left" />
                            <local:MyButton x:Name="BtnManageDownload" MinWidth="110" Text="{loc:Loc Instance.Resource.Datapack.DownloadNew}" Padding="13,7" Command="{Binding DownloadCommand}"
                                            Margin="0,7,15,0" HorizontalAlignment="Left" />
                            <local:MyButton x:Name="BtnManageSelectAll" MinWidth="110" Text="{loc:Loc Instance.Resource.SelectAll}" Padding="13,7" Click="BtnManageSelectAll_Click"
                                            Margin="0,7,15,0" HorizontalAlignment="Left" />
                            <local:MyButton x:Name="BtnManageInfoExport" MinWidth="110" Text="{loc:Loc Instance.Resource.ExportInfo}" Padding="13,7" Command="{Binding ExportInfoCommand}" IsEnabled="{Binding ExportInfoEnabled}"
                                            Margin="0,7,15,0" HorizontalAlignment="Left" ToolTip="{loc:Loc Instance.Resource.Datapack.ExportInfo.ToolTip}" />
                        </WrapPanel>
                    </local:MyCard>
                    <local:MyCard x:Name="PanListBack" VerticalAlignment="Top" Opacity="0" Margin="0,0,0,14" Title=" "
                                  MinHeight="55">
                        <StackPanel x:Name="PanFilter" Margin="15,13,0,0" Orientation="Horizontal"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" Height="28">
                            <local:MyRadioButton Tag="0" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                                 Text="{Binding FilterAllText}" x:Name="BtnFilterAll" Checked="True" Check="ChangeFilter" />
                            <local:MyRadioButton Tag="1" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                                 Text="{Binding FilterEnabledText}" Visibility="{Binding ShowFilterEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" x:Name="BtnFilterEnabled" Check="ChangeFilter" />
                            <local:MyRadioButton Tag="2" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                                 Text="{Binding FilterDisabledText}" Visibility="{Binding ShowFilterDisabled, Converter={StaticResource BooleanToVisibilityConverter}}" x:Name="BtnFilterDisabled" Check="ChangeFilter" />
                            <local:MyRadioButton Tag="3" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                                 Text="{Binding FilterCanUpdateText}" Visibility="{Binding ShowFilterCanUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" x:Name="BtnFilterCanUpdate" Check="ChangeFilter" />
                            <local:MyRadioButton Tag="4" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0"
                                                 Text="{Binding FilterErrorText}" Visibility="{Binding ShowFilterError, Converter={StaticResource BooleanToVisibilityConverter}}" x:Name="BtnFilterError" Check="ChangeFilter" />
                        </StackPanel>
                        <StackPanel Margin="0,13,15,0" Orientation="Horizontal" VerticalAlignment="Top"
                                    HorizontalAlignment="Right" Height="28">
                            <local:MyIconTextButton x:Name="BtnSort" Text="{Binding SortText}" Click="BtnSortClick"
                                                    SvgIcon="lucide/arrow-up-down" />
                        </StackPanel>
                        <StackPanel Margin="20,48,18,22" Name="PanList" VerticalAlignment="Top"
                                    Visibility="{Binding HasVisibleEntries, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </local:MyCard>
                </StackPanel>
            </local:MyScrollViewer>
            <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" x:Name="PanEmpty"
                          Visibility="{Binding ShowDatapacks, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel Margin="20,17">
                    <TextBlock x:Name="TxtEmptyTitle" Margin="0,0,0,9" HorizontalAlignment="Center" Text="{loc:Loc Instance.Resource.Datapack.Empty.Title}"
                               FontSize="19" UseLayoutRounding="True" SnapsToDevicePixels="True"
                               Foreground="{DynamicResource ColorBrush3}" />
                    <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                    <TextBlock x:Name="TxtEmptyDescription" Margin="10,10,10,0"
                               Text="{loc:Loc Instance.Resource.Datapack.Empty.Description}" TextWrapping="Wrap" />
                    <WrapPanel Margin="10,20,10,5" HorizontalAlignment="Center" Orientation="Horizontal">
                        <local:MyButton Height="35" x:Name="BtnHintInstall" MinWidth="130" Text="{loc:Loc Instance.Resource.InstallFromFiles}" Margin="5,0" Command="{Binding InstallCommand}" IsEnabled="{Binding InstallEnabled}"
                                        Padding="12,0" ColorType="Highlight" />
                        <local:MyButton Height="35" x:Name="BtnHintDownload" MinWidth="130" Text="{loc:Loc Instance.Resource.Datapack.DownloadNew}" Margin="5,0" Command="{Binding DownloadCommand}"
                                        Padding="12,0" />
                        <local:MyButton Height="35" x:Name="BtnHintOpen" MinWidth="130" Text="{loc:Loc Common.Action.OpenFolder}" Margin="5,0" Command="{Binding OpenFolderCommand}"
                                        Padding="12,0" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
        </Grid>
        <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0" SnapsToDevicePixels="True"
                      x:Name="PanLoad" UseAnimation="False">
            <local:MyLoading Text="{loc:Loc Instance.Resource.Datapack.Loading}" Margin="20,20,20,17" x:Name="Load" HorizontalAlignment="Center" Click="Load_Click" StateChanged="Load_StateChanged"
                             VerticalAlignment="Center" />
        </local:MyCard>
        <local:MyCard x:Name="CardSelect" Visibility="Collapsed" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="25,25,25,0" UseAnimation="False">
            <local:MyCard.RenderTransform>
                <TranslateTransform x:Name="TransSelect" Y="-10" />
            </local:MyCard.RenderTransform>
            <TextBlock x:Name="LabSelect" Text="{Binding SelectedText}" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="9" Foreground="{DynamicResource ColorBrush2}" />
            <StackPanel Orientation="Horizontal" Margin="5,28,5,5">
                <local:MyIconTextButton x:Name="BtnSelectUpdate" Text="{loc:Loc Instance.Resource.Update}" Click="BtnSelectUpdate_Click"
                                        LogoScale="1"
                                        SvgIcon="lucide/upload"
                                        IsEnabled="{Binding CanUpdate}" />
                <local:MyIconTextButton x:Name="BtnSelectEnable" Text="{loc:Loc Instance.Resource.Enable}" Click="BtnSelectEnable_Click"
                                        LogoScale="1.05"
                                        SvgIcon="lucide/circle-check"
                                        IsEnabled="{Binding CanEnable}" />
                <local:MyIconTextButton x:Name="BtnSelectDisable" Text="{loc:Loc Instance.Resource.Disable}" Click="BtnSelectDisable_Click"
                                        LogoScale="1"
                                        SvgIcon="lucide/circle-minus"
                                        IsEnabled="{Binding CanDisable}" />
                <local:MyIconTextButton x:Name="BtnSelectFavorites" Text="{loc:Loc Instance.Resource.Favorite}" Click="BtnSelectFavorites_Click"
                                        LogoScale="1"
                                        SvgIcon="lucide/heart"
                                        IsEnabled="{Binding CanFavoriteAndShare}" />
                <local:MyIconTextButton x:Name="BtnSelectShare" Text="{loc:Loc Instance.Resource.ShareSelected}" Click="BtnSelectShare_Click"
                                        LogoScale="1"
                                        SvgIcon="lucide/share-2"
                                        IsEnabled="{Binding CanFavoriteAndShare}" />
                <local:MyIconTextButton x:Name="BtnSelectDelete" Text="{loc:Loc Common.Action.Delete}" Click="BtnSelectDelete_Click"
                                        LogoScale="0.96"
                                        SvgIcon="lucide/trash-2" />
                <local:MyIconTextButton x:Name="BtnSelectCancel" Text="{loc:Loc Instance.Resource.CancelSelection}" Click="BtnSelectCancel_Click"
                                        LogoScale="0.8"
                                        SvgIcon="lucide/x" />
            </StackPanel>
        </local:MyCard>
    </Grid>
</local:MyPageRight>