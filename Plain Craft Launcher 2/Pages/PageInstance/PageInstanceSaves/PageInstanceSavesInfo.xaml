<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageInstanceSavesInfo"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10,25,10" x:Name="PanMain">
            <local:MyHint x:Name="Hintversion1_9" Theme="Yellow" Margin="0,5,0,0"
                          Text="{Binding VersionHint19Text}"
                          Visibility="{Binding ShowVersionHint19, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <local:MyHint x:Name="Hintversion1_8" Theme="Yellow" Margin="0,5,0,0"
                          Text="{Binding VersionHint18Text}"
                          Visibility="{Binding ShowVersionHint18, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <local:MyHint x:Name="Hintversion1_3" Theme="Yellow" Margin="0,5,0,0"
                          Text="{Binding VersionHint13Text}"
                          Visibility="{Binding ShowVersionHint13, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <local:MyCard Margin="0,15,0,0" Title="{DynamicResource Instance.Saves.Info.Details.Title}" x:Name="PanContent"
                          Visibility="{Binding ShowContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl Margin="15,35,15,15" x:Name="PanList" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="TextBlock" Width="Auto" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Head}" Margin="0,3,0,3" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Content}" Margin="0,3,0,3"
                                               Visibility="{Binding ContentTextVisibility}" />
                                    <local:MyTextButton Text="{Binding Content}" Margin="0,3,0,3"
                                                        Visibility="{Binding SeedButtonVisibility}"
                                                        Tag="{Binding}" Click="SeedButton_Click" />
                                    <local:MyIconButton SvgIcon="lucide/external-link" Width="22" Height="22"
                                                        Visibility="{Binding SeedButtonVisibility}"
                                                        ToolTip="{DynamicResource Instance.Saves.Info.Chunkbase.ToolTip}"
                                                        Tag="{Binding}" Click="ChunkbaseButton_Click" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </local:MyCard>
            <local:MyCard Margin="0,15,0,0" Title="{DynamicResource Instance.Saves.Info.Settings.Title}" x:Name="PanSettings"
                          Visibility="{Binding ShowSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="15,35,15,15" x:Name="PanSettingsList">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="TextBlock" Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>