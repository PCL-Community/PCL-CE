<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageInstanceCompJarInJar"
    PanScroll="{Binding ElementName=PanBack}">

    <local:MyPageRight.Resources>
        <DataTemplate x:Key="JijTreeRowTemplate">
            <StackPanel Orientation="Horizontal" Margin="{Binding Margin}">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ColorBrush1}" FontWeight="Bold"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Version}" Foreground="{DynamicResource ColorBrush2}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Loader}" Foreground="{DynamicResource ColorBrush3}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding McVersion}" Foreground="{DynamicResource ColorBrushInfo}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Versions}" ToolTip="{Binding VersionsTooltip}"
                           Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="JijDependencyRowTemplate">
            <StackPanel Orientation="Horizontal" Margin="8,2,0,2">
                <TextBlock Text="{Binding Primary}" Foreground="{DynamicResource ColorBrush1}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Optional}" Foreground="{DynamicResource ColorBrush2}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding GrayLabel}" Foreground="{DynamicResource ColorBrush2}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ColorLabel}" Foreground="{Binding LabelBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </local:MyPageRight.Resources>

    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              x:Name="PanBack">
            <StackPanel x:Name="PanMain" Margin="25,10,25,10">
                <local:MyCard Margin="0,15,0,15" x:Name="PanManage">
                    <WrapPanel Margin="15,8,0,15">
                        <local:MyButton x:Name="BtnBack" MinWidth="110"
                                        Text="{DynamicResource Instance.Resource.BackToParent}" Padding="13,7"
                                        Margin="0,7,15,0" HorizontalAlignment="Left" ColorType="Highlight" Click="BtnBack_Click" />
                        <local:MyButton x:Name="BtnRefresh" MinWidth="110"
                                        Text="{DynamicResource Common.Action.Refresh}" Padding="13,7"
                                        Margin="0,7,15,0" HorizontalAlignment="Left" Click="BtnRefresh_Click" />
                        <TextBlock VerticalAlignment="Center" Margin="0,7,15,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="{DynamicResource Instance.Resource.Mod.JarInJar.Message}" />
                    </WrapPanel>
                </local:MyCard>

                <local:MySearchBox Margin="0,0,0,15" x:Name="SearchBox"
                                   HintText="{DynamicResource Instance.Resource.Mod.JarInJar.Search.Hint}" TextChanged="SearchBox_TextChanged" />

                <local:MyCard x:Name="CardWarnings" Margin="0,0,0,15"
                              Visibility="{Binding CardWarningsVisibility}">
                    <StackPanel Margin="15,10,15,12">
                        <TextBlock Text="{DynamicResource Instance.Resource.Mod.JarInJar.Section.Warnings}"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}" />
                        <ItemsControl x:Name="PanWarnList" Margin="0,8,0,0"
                                      ItemsSource="{Binding WarningRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard x:Name="CardConflicts" Margin="0,0,0,15"
                              Visibility="{Binding CardConflictsVisibility}">
                    <StackPanel Margin="15,10,15,12">
                        <TextBlock Text="{DynamicResource Instance.Resource.Mod.JarInJar.Section.Conflicts}"
                                   ToolTip="{DynamicResource Instance.Resource.Mod.JarInJar.Conflict.Tooltip}"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}" />
                        <ItemsControl x:Name="PanConflictList" Margin="0,8,0,0"
                                      ItemsSource="{Binding ConflictRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                        <TextBlock Text="{Binding Severity}" Foreground="{Binding SeverityBrush}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Pair}"
                                                   Foreground="{DynamicResource ColorBrush1}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </local:MyCard>

                <StackPanel x:Name="SectionRelations" Visibility="{Binding SectionRelationsVisibility}">
                    <TextBlock Text="{DynamicResource Instance.Resource.Mod.JarInJar.Section.Relations}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}"
                               Margin="2,0,0,8" />
                    <StackPanel x:Name="PanRelationList" />
                </StackPanel>

                <StackPanel x:Name="SectionBundled" Visibility="{Binding SectionBundledVisibility}">
                    <TextBlock Text="{DynamicResource Instance.Resource.Mod.JarInJar.Section.Bundled}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}"
                               Margin="2,4,0,8" />
                    <StackPanel x:Name="PanBundledList" />
                </StackPanel>
            </StackPanel>
        </local:MyScrollViewer>
        <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" x:Name="PanEmpty"
                      Visibility="{Binding PanEmptyVisibility}">
            <StackPanel Margin="20,17">
                <TextBlock Margin="0,0,0,9" HorizontalAlignment="Center"
                           Text="{DynamicResource Instance.Resource.Mod.JarInJar.Empty.Title}" FontSize="19"
                           UseLayoutRounding="True" SnapsToDevicePixels="True"
                           Foreground="{DynamicResource ColorBrush3}" />
                <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                <TextBlock Margin="10,10,10,0" Text="{DynamicResource Instance.Resource.Mod.JarInJar.Empty.Message}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" />
                <local:MyButton Height="35" x:Name="BtnEmptyBack" MinWidth="130"
                                Text="{DynamicResource Instance.Resource.BackToParent}" Margin="5,20,5,5"
                                Padding="12,0" HorizontalAlignment="Center" ColorType="Highlight" Click="BtnEmptyBack_Click" />
            </StackPanel>
        </local:MyCard>
        <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0" SnapsToDevicePixels="True"
                      x:Name="PanLoad" UseAnimation="False" Visibility="{Binding PanLoadVisibility}">
            <local:MyLoading Text="{DynamicResource Instance.Resource.Loading}" Margin="20,20,20,17" x:Name="Load"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
        </local:MyCard>
    </Grid>
</local:MyPageRight>
