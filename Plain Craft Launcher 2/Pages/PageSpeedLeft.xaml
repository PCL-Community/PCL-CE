<local:MyPageLeft x:Class="PCL.PageSpeedLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                   xmlns:core="clr-namespace:PCL.Core.App.Tasks;assembly=PCL.Core"
                   xmlns:coreUi="clr-namespace:PCL.Core.UI.Converters;assembly=PCL.Core"
                  mc:Ignorable="d"
                  d:DesignHeight="450" Width="200" HorizontalAlignment="Left">
    <Grid.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock" x:Key="Split">
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Height" Value="2" />
                <Setter Property="Margin" Value="25,7" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                            <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="0" />
                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.02" />
                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.98" />
                            <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <coreUi:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        </ResourceDictionary>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="40" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1*" />
    </Grid.RowDefinitions>
    <TextBlock Text="总进度" Grid.Row="1" HorizontalAlignment="Center" FontSize="14"
               Foreground="{DynamicResource ColorBrush3}" />
    <TextBlock Grid.Row="2" Style="{DynamicResource Split}" />
    <TextBlock Text="00.00 %" Grid.Row="3" Name="LabProgress" HorizontalAlignment="Center" FontSize="20" />

    <!-- Task list -->
    <ListBox Grid.Row="4" Name="TaskList"
             ItemsSource="{Binding Source={x:Static core:TaskCenter.Tasks}}"
             Background="Transparent" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             VirtualizingPanel.ScrollUnit="Pixel"
             Margin="5,0,5,0">
        <ListBox.ItemTemplate>
            <DataTemplate DataType="core:TaskModel">
                <Border Background="Transparent" Padding="0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- State indicator: icon for Waiting/Success/Failed, progress text for Running -->
                        <Grid Grid.Column="0" Width="22" Height="22" Margin="0,0,4,0">
                            <Path Stretch="Uniform" Width="16" Height="16"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Fill="{DynamicResource ColorBrush3}"
                                  Data="F1 M5,0 a5,5 360 1 0 0,0.0001 m15,0 a5,5 360 1 0 0,0.0001 m15,0 a5,5 360 1 0 0,0.0001 Z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Waiting">
                                                <Setter Property="Data" Value="F1 M5,0 a5,5 360 1 0 0,0.0001 m15,0 a5,5 360 1 0 0,0.0001 m15,0 a5,5 360 1 0 0,0.0001 Z" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Running">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Success">
                                                <Setter Property="Data" Value="F1 M 23.7501,33.25L 34.8334,44.3333L 52.2499,22.1668L 56.9999,26.9168L 34.8334,53.8333L 19.0001,38L 23.7501,33.25 Z" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                <Setter Property="Data" Value="F1 M2.5,0 L0,2.5 7.5,10 0,17.5 2.5,20 10,12.5 17.5,20 20,17.5 12.5,10 20,2.5 17.5,0 10,7.5 2.5,0Z" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Canceled">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ColorBrush3}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Text" Value="{Binding Progress, StringFormat={}{0:P0}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Running">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Title -->
                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ColorBrush3}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Success">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Canceled">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Cancel button -->
                        <Button Grid.Column="2" Command="{Binding Cancel}"
                                Background="Transparent" BorderThickness="0"
                                Width="18" Height="18" Padding="0"
                                VerticalAlignment="Center"
                                ToolTip="取消任务"
                                Visibility="{Binding OnCancel, Converter={StaticResource NullToVisibilityConverter}}">
                            <Path Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z"
                                  Stretch="Uniform" Fill="{DynamicResource ColorBrush3}" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Text="下载速度" Grid.Row="5" HorizontalAlignment="Center" FontSize="14"
               Foreground="{DynamicResource ColorBrush3}" />
    <TextBlock Grid.Row="6" Style="{DynamicResource Split}" />
    <TextBlock Text="0 B/s" Grid.Row="7" Name="LabSpeed" HorizontalAlignment="Center" FontSize="20" />
    <TextBlock Text="剩余文件" Grid.Row="8" HorizontalAlignment="Center" FontSize="14"
               Foreground="{DynamicResource ColorBrush3}" />
    <TextBlock Grid.Row="9" Style="{DynamicResource Split}" />
    <TextBlock Text="123456789" Grid.Row="10" Name="LabFile" HorizontalAlignment="Center" FontSize="20" />
    <TextBlock Text="剩余线程" Grid.Row="11" HorizontalAlignment="Center" FontSize="14"
               Foreground="{DynamicResource ColorBrush3}" />
    <TextBlock Grid.Row="12" Style="{DynamicResource Split}" />
    <TextBlock Text="123456789" Grid.Row="13" Name="LabThread" HorizontalAlignment="Center" FontSize="20" />
</local:MyPageLeft>
