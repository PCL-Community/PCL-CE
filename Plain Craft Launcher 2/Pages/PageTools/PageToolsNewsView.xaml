<local:MyPageRight
    x:Class="PageToolsNewsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCL"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:PCL.Core.ViewModel.Tools;assembly=PCL.Core"
    MinWidth="150"
    mc:Ignorable="d">
    <local:MyPageRight.DataContext>
        <vm:NewsViewModel />
    </local:MyPageRight.DataContext>

    <local:MyScrollViewer>
        <Grid Margin="12,0,12,6">
            <StackPanel Grid.Row="1">
                <TextBlock Text="{Binding ErrorMessage}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" Foreground="{DynamicResource ColorBrushRedLight}"/>
                <ItemsControl ItemsSource="{Binding NewsItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:MyCard Margin="5">
                                <Grid Margin="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 图片 -->
                                    <local:MyImage
                                        Grid.Column="0"
                                        Width="100"
                                        Height="80"
                                        Margin="0,0,10,0"
                                        Source="{Binding Image}"
                                        Stretch="UniformToFill" />

                                    <!-- 文字内容 -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,2"
                                            Foreground="DarkGray"
                                            Text="{Binding Author}" />
                                        <TextBlock
                                            MaxHeight="60"
                                            Margin="0,5"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="Gray"
                                            Text="{Binding PublishDate, StringFormat='yyyy-MM-dd HH:mm'}" />
                                    </StackPanel>
                                </Grid>
                            </local:MyCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <local:MyCard
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <local:MyLoading Margin="16" Text="加载中……" />
            </local:MyCard>
        </Grid>
    </local:MyScrollViewer>
</local:MyPageRight>