                            </Grid>
                            <Grid x:Name="BtnLegacyFabricApiClear" Visibility="{Binding ShowLegacyFabricApiClear, Converter={StaticResource BooleanToVisibilityConverter}}" Height="30" Width="30" HorizontalAlignment="Right"
