                                       Source="pack://application:,,,/images/Blocks/NeoForge.png" />
                                <TextBlock x:Name="LabNeoForge" Text="{Binding NeoForgeText}" Foreground="{Binding NeoForgeForeground}" VerticalAlignment="Center"
