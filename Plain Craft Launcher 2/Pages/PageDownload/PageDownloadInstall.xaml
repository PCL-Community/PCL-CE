                                <Grid.RenderTransform>
                                    <TranslateTransform />
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="ImgFabric" Visibility="{Binding ShowFabricImage, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,7,0" SnapsToDevicePixels="True" Height="18"
                                       RenderOptions.BitmapScalingMode="Linear"
                                       Source="pack://application:,,,/images/Blocks/Fabric.png" />
                                <TextBlock x:Name="LabFabric" Text="{Binding FabricText}" Foreground="{Binding FabricForeground}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Grid.Column="1" />
                            </Grid>
                            <Grid x:Name="BtnFabricClear" Visibility="{Binding ShowFabricClear, Converter={StaticResource BooleanToVisibilityConverter}}" Height="30" Width="30" HorizontalAlignment="Right"
