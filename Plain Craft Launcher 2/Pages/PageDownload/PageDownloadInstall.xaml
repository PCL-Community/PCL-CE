                            </Grid>
                        </local:MyCard>
                        <local:MyCard Title="{DynamicResource Common.Installation.LegacyFabric}" Height="40" Margin="0,12,0,0" x:Name="CardLegacyFabric" Visibility="{Binding ShowLegacyFabricCard, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      IsSwapped="True" CanSwap="True" SwapLogoRight="True">
