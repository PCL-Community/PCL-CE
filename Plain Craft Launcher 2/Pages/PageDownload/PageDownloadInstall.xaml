                            </Grid>
                            <Grid x:Name="BtnOptiFineClear" Visibility="{Binding ShowOptiFineClear, Converter={StaticResource BooleanToVisibilityConverter}}" Height="30" Width="30" HorizontalAlignment="Right"
                                  VerticalAlignment="Top" Margin="0,5,32,0"
                                  Background="{StaticResource ColorBrushSemiTransparent}">
