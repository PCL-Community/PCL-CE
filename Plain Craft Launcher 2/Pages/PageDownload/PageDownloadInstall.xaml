                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="ImgLabyMod" Visibility="{Binding ShowLabyModImage, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,7,0" SnapsToDevicePixels="True" Height="18"
