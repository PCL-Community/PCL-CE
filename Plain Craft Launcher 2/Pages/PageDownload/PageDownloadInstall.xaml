                            </Grid>
                            <Grid x:Name="BtnNeoForgeClear" Visibility="{Binding ShowNeoForgeClear, Converter={StaticResource BooleanToVisibilityConverter}}" Height="30" Width="30" HorizontalAlignment="Right"
