                            </Grid>
                            <Grid x:Name="BtnLabyModClear" Visibility="{Binding ShowLabyModClear, Converter={StaticResource BooleanToVisibilityConverter}}" Height="30" Width="30" HorizontalAlignment="Right"
                                  VerticalAlignment="Top" Margin="0,5,32,0"
                                  Background="{StaticResource ColorBrushSemiTransparent}">
                                <Path x:Name="BtnLabyModClearInner" Height="10" Width="10" Stretch="Uniform"
