<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageDownloadClient"
    PanScroll="{Binding ElementName=PanBack}"
    xmlns:loc="https://ce.pclc.cc/core/localization">
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              x:Name="PanBack">
            <StackPanel Orientation="Vertical" Margin="5" Grid.IsSharedSizeScope="True">
                <StackPanel Name="PanLatest" Margin="20,20,20,0" />
                <ItemsControl Name="PanMain" Margin="20,0,20,5" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:GameVersionGroupViewModel}">
                            <local:MyCard Title="{Binding Title.Value}" Height="40" Margin="0,0,0,15" CanSwap="True"
                                          IsSwapped="{Binding IsExpanded, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}">
                                <ItemsControl Margin="20,40,18,18" VerticalAlignment="Top" Visibility="Collapsed"
                                              ItemsSource="{Binding Items}">
                                    <ItemsControl.RenderTransform>
                                        <TranslateTransform />
                                    </ItemsControl.RenderTransform>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:GameVersionItemViewModel}">
                                            <local:MyListItem Title="{Binding Title}" Info="{Binding Info.Value}"
                                                              Logo="{Binding Logo}" Tags="{Binding Tags}"
                                                              Tag="{Binding Entry}" Type="Clickable" Height="42"
                                                              SnapsToDevicePixels="True" Click="VersionItem_Click"
                                                              Loaded="VersionItem_Loaded" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </local:MyCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </local:MyScrollViewer>
        <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0" SnapsToDevicePixels="True"
                      x:Name="PanLoad" UseAnimation="False">
            <local:MyLoading Text="{loc:Loc Download.Version.LoadingList}" Margin="20,20,20,17"
                             x:Name="Load" HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
        </local:MyCard>
    </Grid>
</local:MyPageRight>