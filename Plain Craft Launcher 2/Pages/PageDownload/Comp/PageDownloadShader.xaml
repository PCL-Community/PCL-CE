<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageDownloadShader"
    PanScroll="{Binding ElementName=Content}"
    xmlns:loc="https://ce.pclc.cc/core/localization">
    <local:PageComp x:Name="Content" PageType="Shader">
        <local:MyComboBoxItem Tag="" Content="{loc:Loc Common.Option.All}" IsSelected="True" />

        <local:MyComboBoxItem Content="{loc:Loc Download.Comp.Category.Style}" IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0"
                              Content="{loc:Loc Download.Comp.Category.VanillaLike}"
                              Tag="6555/vanilla-like" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{loc:Loc Download.Comp.Category.Fantasy}"
                              Tag="6554/fantasy" />
        <local:MyComboBoxItem Margin="15,0,0,0"
                              Content="{loc:Loc Download.Comp.Category.Realistic}"
                              Tag="6553/realistic" />
        <local:MyComboBoxItem Margin="15,0,0,0"
                              Content="{loc:Loc Download.Comp.Category.SemiRealistic}"
                              Tag="/semi-realistic" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{loc:Loc Download.Comp.Category.Cartoon}"
                              Tag="/cartoon" />

        <local:MyComboBoxItem Content="{loc:Loc Download.Comp.Category.Feature}" IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0"
                              Content="{loc:Loc Download.Comp.Category.ColoredLighting}"
                              Tag="/colored-lighting" />
        <local:MyComboBoxItem Margin="15,0,0,0"
                              Content="{loc:Loc Download.Comp.Category.PathTracing}"
                              Tag="/path-tracing" />
        <local:MyComboBoxItem Margin="15,0,0,0" Content="{loc:Loc Download.Comp.Category.Pbr}"
                              Tag="/pbr" />
        <local:MyComboBoxItem Margin="15,0,0,0"
                              Content="{loc:Loc Download.Comp.Category.Reflections}"
                              Tag="/reflections" />

        <local:MyComboBoxItem Content="{loc:Loc Download.Comp.Category.Performance}"
                              IsEnabled="False" />
        <local:MyComboBoxItem Margin="15,0,0,0"
                              Content="{loc:Loc Download.Comp.Category.PerformancePotato}"
                              Tag="/potato" />
        <local:MyComboBoxItem Margin="15,0,0,0"
                              Content="{loc:Loc Download.Comp.Category.PerformanceLow}" Tag="/low" />
        <local:MyComboBoxItem Margin="15,0,0,0"
                              Content="{loc:Loc Download.Comp.Category.PerformanceMedium}"
                              Tag="/medium" />
        <local:MyComboBoxItem Margin="15,0,0,0"
                              Content="{loc:Loc Download.Comp.Category.PerformanceHigh}"
                              Tag="/high" />
    </local:PageComp>
</local:MyPageRight>