<Grid x:Class="PCL.MyCompGridItem"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PCL"
      xmlns:svgIcon="clr-namespace:PCL.Core.UI.Controls.SvgIcon;assembly=PCL.Core"
      Height="280"
      Width="220"
      Margin="5"
      SnapsToDevicePixels="True">
    <Border x:Name="PanBack"
            Background="{StaticResource ColorBrushBg1}"
            CornerRadius="12"
            BorderBrush="{StaticResource ColorBrush6}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="160"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" 
                    CornerRadius="8,8,0,0" 
                    Background="{StaticResource ColorBrush7}"
                    Margin="1">
                <Grid>
                    <local:MyImage x:Name="PathLogo" 
                                   Stretch="UniformToFill"
                                   FallbackSource="pack://application:,,,/images/Icons/NoIcon.png" />
                    <Border CornerRadius="8,8,0,0" 
                            Background="#88000000" 
                            VerticalAlignment="Bottom" 
                            Height="60"
                            Margin="0">
                        <StackPanel Orientation="Horizontal" 
                                    VerticalAlignment="Bottom" 
                                    HorizontalAlignment="Right"
                                    Margin="8">
                            <Border Background="#55FFFFFF" 
                                    CornerRadius="4" 
                                    Padding="6,3" 
                                    Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <svgIcon:SvgIcon Icon="lucide/download" 
                                                     IconBrush="#333333" 
                                                     Height="12" 
                                                     Width="12" 
                                                     Margin="0,0,4,0"/>
                                    <TextBlock x:Name="LabDownload" 
                                               Foreground="#333333" 
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#55FFFFFF" 
                                    CornerRadius="4" 
                                    Padding="6,3">
                                <TextBlock x:Name="LabSource" 
                                           Foreground="#333333" 
                                           FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
            <StackPanel Grid.Row="1" Margin="12,10,12,0">
                <TextBlock x:Name="LabTitle" 
                           TextWrapping="NoWrap" 
                           TextTrimming="CharacterEllipsis" 
                           FontSize="15" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}" />
                <TextBlock x:Name="LabTitleRaw" 
                           TextWrapping="NoWrap" 
                           TextTrimming="CharacterEllipsis" 
                           FontSize="12" 
                           Foreground="{StaticResource ColorBrushGray1}" 
                           Opacity="0.4" 
                           Margin="0,2,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
            
            <TextBlock x:Name="LabInfo" 
                       Grid.Row="2" 
                       Margin="12,6,12,0" 
                       TextWrapping="Wrap" 
                       TextTrimming="CharacterEllipsis" 
                       MaxHeight="48" 
                       FontSize="12" 
                       Foreground="{StaticResource ColorBrushGray3}" />
            
            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        Margin="12,10,12,10" 
                        VerticalAlignment="Bottom">
                <svgIcon:SvgIcon Icon="lucide/calendar" 
                                 IconBrush="{StaticResource ColorBrushGray4}" 
                                 Height="14" 
                                 Width="14"/>
                <TextBlock x:Name="LabTime" 
                           Margin="4,0,8,0" 
                           FontSize="11" 
                           Foreground="{StaticResource ColorBrushGray4}" 
                           VerticalAlignment="Center"/>
                
                <Border Background="{StaticResource ColorBrush7}" 
                        CornerRadius="4" 
                        Padding="6,2" 
                        Margin="0,0,4,0"
                        Visibility="Collapsed"
                        x:Name="TagBorder1">
                    <TextBlock x:Name="Tag1" FontSize="10" Foreground="{StaticResource ColorBrushGray3}"/>
                </Border>
                <Border Background="{StaticResource ColorBrush7}" 
                        CornerRadius="4" 
                        Padding="6,2" 
                        Margin="0,0,4,0"
                        Visibility="Collapsed"
                        x:Name="TagBorder2">
                    <TextBlock x:Name="Tag2" FontSize="10" Foreground="{StaticResource ColorBrushGray3}"/>
                </Border>
            </StackPanel>
            
            <StackPanel x:Name="PanButtons" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top"
                        Margin="0,8,8,0" 
                        Opacity="0">
                <local:MyIconButton x:Name="BtnDelete" 
                                    Height="28" 
                                    Width="28" 
                                    SvgIcon="lucide/heart"
                                    Background="#55000000"/>
            </StackPanel>
        </Grid>
    </Border>
</Grid>
