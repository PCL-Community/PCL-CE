<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageDownloadPack"
    PanScroll="{Binding ElementName=Content}"
    xmlns:loc="https://ce.pclc.cc/core/localization">
    <local:PageComp x:Name="Content" PageType="ModPack">
        <local:MyComboBoxItem Tag="" Content="{loc:Loc Common.Option.All}" IsSelected="True" />
        <local:MyComboBoxItem Tag="4484/" Content="{loc:Loc Download.Comp.Category.Multiplayer}" />
        <local:MyComboBoxItem Tag="/optimization"
                              Content="{loc:Loc Download.Comp.Category.Optimization}" />
        <local:MyComboBoxItem Tag="4479/challenging"
                              Content="{loc:Loc Download.Comp.Category.Modpack.Hardcore}" />
        <local:MyComboBoxItem Tag="4483/combat" Content="{loc:Loc Download.Comp.Category.Combat}" />
        <local:MyComboBoxItem Tag="4478/quests"
                              Content="{loc:Loc Download.Comp.Category.Modpack.Quests}" />
        <local:MyComboBoxItem Tag="4472/technology"
                              Content="{loc:Loc Download.Comp.Category.Technology}" />
        <local:MyComboBoxItem Tag="4473/magic" Content="{loc:Loc Download.Comp.Category.Magic}" />
        <local:MyComboBoxItem Tag="4475/adventure"
                              Content="{loc:Loc Download.Comp.Category.Adventure}" />
        <local:MyComboBoxItem Tag="/kitchen-sink"
                              Content="{loc:Loc Download.Comp.Category.Modpack.KitchenSink}" />
        <local:MyComboBoxItem Tag="4476/"
                              Content="{loc:Loc Download.Comp.Category.Modpack.Exploration}" />
        <local:MyComboBoxItem Tag="4477/"
                              Content="{loc:Loc Download.Comp.Category.Modpack.MiniGame}" />
        <local:MyComboBoxItem Tag="4471/" Content="{loc:Loc Download.Comp.Category.Modpack.SciFi}" />
        <local:MyComboBoxItem Tag="4736/"
                              Content="{loc:Loc Download.Comp.Category.Modpack.Skyblock}" />
        <local:MyComboBoxItem Tag="5128/"
                              Content="{loc:Loc Download.Comp.Category.Modpack.VanillaPlus}" />
        <local:MyComboBoxItem Tag="4487/" Content="{loc:Loc Download.Comp.Category.Modpack.Ftb}"
                              ToolTip="{loc:Loc Download.Comp.Category.Modpack.Ftb.ToolTip}"
                              ToolTipService.HorizontalOffset="70" />
        <local:MyComboBoxItem Tag="4480/"
                              Content="{loc:Loc Download.Comp.Category.Modpack.MapBased}" />
        <local:MyComboBoxItem Tag="4481/lightweight"
                              Content="{loc:Loc Download.Comp.Category.Modpack.SmallLight}" />
        <local:MyComboBoxItem Tag="4482/"
                              Content="{loc:Loc Download.Comp.Category.Modpack.ExtraLarge}" />
    </local:PageComp>
</local:MyPageRight>