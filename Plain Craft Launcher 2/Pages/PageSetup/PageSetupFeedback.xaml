<local:MyPageRight x:Class="PCL.PageSetupFeedback"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyPageRight.Resources>
        <DataTemplate x:Key="FeedbackItemTemplate">
            <local:MyListItem Title="{Binding Title}" Info="{Binding Info}" Logo="{Binding Logo}"
                              Tags="{Binding Tags}" Type="Clickable" Tag="{Binding}"
                              Click="FeedbackItem_Click" />
        </DataTemplate>
    </local:MyPageRight.Resources>
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,25">
            <local:MyCard Title="{DynamicResource Setup.Feedback.Submit.Title}" x:Name="PanInfo">
                <StackPanel Orientation="Vertical" Margin="20,40,18,22">
                    <TextBlock
                        Text="{DynamicResource Setup.Feedback.Submit.Description}"
                        TextWrapping="Wrap" />
                    <Grid Margin="0,15,0,0" Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnManageOpen" Grid.Column="0" MinWidth="140" Text="{DynamicResource Setup.Feedback.Submit.Open}"
                                        Padding="13,0" Margin="0,0,20,0" HorizontalAlignment="Left"
                                        ColorType="Highlight" Click="Feedback_Click" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <StackPanel x:Name="PanContent" Margin="0,15,0,0">
                <local:MyCard Title="{DynamicResource Setup.Feedback.Status.Processing}" Margin="0,0,0,15" x:Name="PanContentProcessing" CanSwap="True"
                              Visibility="{Binding ShowProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="PanListProcessing" Margin="20,36,18,18"
                                  ItemsSource="{Binding ProcessingRows}"
                                  ItemTemplate="{StaticResource FeedbackItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </local:MyCard>
                <local:MyCard Title="{DynamicResource Setup.Feedback.Status.WaitingProcess}" Margin="0,0,0,15" x:Name="PanContentWaitingProcess" CanSwap="True"
                              Visibility="{Binding ShowWaitingProcess, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="PanListWaitingProcess" Margin="20,36,18,18"
                                  ItemsSource="{Binding WaitingProcessRows}"
                                  ItemTemplate="{StaticResource FeedbackItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </local:MyCard>
                <local:MyCard Title="{DynamicResource Setup.Feedback.Status.Waiting}" Margin="0,0,0,15" x:Name="PanContentWait" CanSwap="True"
                              Visibility="{Binding ShowWait, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="PanListWait" Margin="20,36,18,18"
                                  ItemsSource="{Binding WaitRows}"
                                  ItemTemplate="{StaticResource FeedbackItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </local:MyCard>
                <local:MyCard Title="{DynamicResource Setup.Feedback.Status.Paused}" Margin="0,0,0,15" x:Name="PanContentPause" CanSwap="True"
                              Visibility="{Binding ShowPause, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="PanListPause" Margin="20,36,18,18"
                                  ItemsSource="{Binding PauseRows}"
                                  ItemTemplate="{StaticResource FeedbackItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </local:MyCard>
                <local:MyCard Title="{DynamicResource Setup.Feedback.Status.UpNext}" Margin="0,0,0,15" x:Name="PanContentUpnext" CanSwap="True"
                              Visibility="{Binding ShowUpnext, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="PanListUpnext" Margin="20,36,18,18"
                                  ItemsSource="{Binding UpnextRows}"
                                  ItemTemplate="{StaticResource FeedbackItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </local:MyCard>
                <local:MyCard Title="{DynamicResource Setup.Feedback.Status.Completed}" Margin="0,0,0,15" x:Name="PanContentCompleted" CanSwap="True"
                              IsSwapped="True"
                              Visibility="{Binding ShowCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="PanListCompleted" Margin="20,36,18,18"
                                  ItemsSource="{Binding CompletedRows}"
                                  ItemTemplate="{StaticResource FeedbackItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </local:MyCard>
                <local:MyCard Title="{DynamicResource Setup.Feedback.Status.Declined}" Margin="0,0,0,15" x:Name="PanContentDecline" CanSwap="True" IsSwapped="True"
                              Visibility="{Binding ShowDecline, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="PanListDecline" Margin="20,36,18,18"
                                  ItemsSource="{Binding DeclineRows}"
                                  ItemTemplate="{StaticResource FeedbackItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </local:MyCard>
                <local:MyCard Title="{DynamicResource Setup.Feedback.Status.Ignored}" Margin="0,0,0,15" x:Name="PanContentIgnored" CanSwap="True" IsSwapped="True"
                              Visibility="{Binding ShowIgnored, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="PanListIgnored" Margin="20,36,18,18"
                                  ItemsSource="{Binding IgnoredRows}"
                                  ItemTemplate="{StaticResource FeedbackItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </local:MyCard>
                <local:MyCard Title="{DynamicResource Setup.Feedback.Status.Duplicate}" Margin="0,0,0,15" x:Name="PanContentDuplicate" CanSwap="True" IsSwapped="True"
                              Visibility="{Binding ShowDuplicate, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="PanListDuplicate" Margin="20,36,18,18"
                                  ItemsSource="{Binding DuplicateRows}"
                                  ItemTemplate="{StaticResource FeedbackItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </local:MyCard>
            </StackPanel>
            <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"
                          x:Name="PanLoad" UseAnimation="False" Margin="40,50">
                <local:MyLoading Text="{DynamicResource Setup.Feedback.Loading}" Margin="20,20,20,17" x:Name="Load" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
