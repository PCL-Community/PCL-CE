<my:MyMsgContent x:Class="MyMsgContentLogin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:my="clr-namespace:PCL">
    <StackPanel>
        <my:MyScrollViewer VerticalAlignment="Top" x:Name="PanCaption" Margin="0,0,0,15" Padding="7,0,15,0"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" DeltaMult="0.7">
            <TextBlock VerticalAlignment="Top" TextTrimming="None" TextWrapping="Wrap" Name="LabCaption" FontSize="15" LineHeight="18"
                       Foreground="{DynamicResource ColorBrushMsgBoxText}" FontWeight="Normal" Padding="1" />
        </my:MyScrollViewer>
        <!-- 设备代码显示区域，居中突出显示 -->
        <Border Background="{DynamicResource ColorBrushHalfWhite}" CornerRadius="5" Padding="20,15" Margin="7,0,7,15"
                BorderBrush="{DynamicResource ColorBrush1}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="设备代码" FontSize="12" Foreground="{DynamicResource ColorBrushMsgBoxText}" 
                           HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.7" />
                <TextBlock Name="LabUserCode" FontSize="24" FontWeight="Bold" 
                           Foreground="{DynamicResource ColorBrush2}" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center"
                           FontFamily="Consolas, Courier New, monospace"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <!-- 操作按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
            <my:MyButton ColorType="Normal" x:FieldModifier="public" Text="重新打开网页" x:Name="BtnOpenWebsite" 
                         Margin="0,0,8,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" 
                         UseLayoutRounding="False" EventType="打开网页" />
            <my:MyButton ColorType="Normal" x:FieldModifier="public" Text="复制代码" x:Name="BtnCopyCode" 
                         Margin="0,0,8,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" 
                         UseLayoutRounding="False" EventType="复制文本" />
        </StackPanel>
    </StackPanel>
</my:MyMsgContent>

