<UserControl x:Class="MyMsgContentInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:my="clr-namespace:PCL">
    <StackPanel>
        <my:MyScrollViewer VerticalAlignment="Top" x:Name="PanText" Margin="0,0,0,7" Padding="7,0,15,0"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" DeltaMult="0.7">
            <TextBlock VerticalAlignment="Top" TextTrimming="None" TextWrapping="Wrap" Name="LabText" FontSize="15" LineHeight="18"
                       Foreground="{DynamicResource ColorBrushMsgBoxText}" FontWeight="Normal" Padding="1" />
        </my:MyScrollViewer>
        <my:MyTextBox Margin="7,0,7,0" x:Name="TextArea" UseLayoutRounding="False" MaxLength="1000" MinWidth="450" />
    </StackPanel>
</UserControl>

