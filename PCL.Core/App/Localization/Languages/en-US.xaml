    <!-- Setup.Launch.Options -->
    <sys:String x:Key="Setup.Launch.Options.Title">Launch Options</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.Label">Default Version Isolation</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.None.ToolTip">All instances share the same profile, saves, Mods, resource packs, etc.&#x0a;If multiple instances have Mods installed, this may cause Mod conflicts.</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.ToolTip">When installing a new instance, automatically set its isolation option accordingly.&#x0a;To adjust the isolation policy of existing instances, go to their instance settings.</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.ModdedOnly">Isolate moddable instances</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.ModdedOnly.ToolTip">Moddable instances (e.g. Forge, Fabric) are isolated from each other to avoid Mod conflicts. Other instances (e.g. vanilla) will not be isolated.</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.NonRelease">Isolate non-release versions</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.NonRelease.ToolTip">Isolate Minecraft snapshots, pre-releases, old versions, and April Fools versions from other instances</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.ModdedAndNonRelease">Isolate moddable instances and non-release versions</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.All">Isolate all instances</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.All.ToolTip">Saves, Mods, resource packs, etc. are not shared between different instances.&#x0a;This means saves cannot be shared between different vanilla instances, so it is generally not recommended.</sys:String>
    <sys:String x:Key="Setup.Launch.InstanceIsolation.DefaultPolicyHint">The default policy only applies to newly installed instances.&#x0a;Existing instances' isolation policy needs to be adjusted in their settings.</sys:String>
    <sys:String x:Key="Setup.Launch.WindowTitle.Label">Game Window Title</sys:String>
    <sys:String x:Key="Setup.Launch.WindowTitle.SampleFormat">{name} | Player: {user} | Logged in as {login}</sys:String>
    <sys:String x:Key="Setup.Launch.WindowTitle.ToolTip">Customize the game window title. Leave blank to keep default.&#x0a;Supports the following replacement tokens:&#x0a; · {user}: Player name&#x0a; · {login}: Player authentication method&#x0a; · {name}: Game instance name&#x0a; · {date}, {time}: Current system time&#x0a; · {version}: The vanilla version of the game&#x0a;Note: If your instance has the Modern UI mod installed, this setting will not take effect.</sys:String>
    <sys:String x:Key="Setup.Launch.CustomInfo.Label">Custom Info</sys:String>
    <sys:String x:Key="Setup.Launch.CustomInfo.ToolTip">This information will be displayed in the bottom-left corner of the game's main menu and the top-left corner of the F3 debug screen.</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.Label">Launcher Visibility</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.CloseImmediately">Close immediately after game starts</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.HideAndCloseOnExit">Hide after game starts, close automatically after game exits</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.HideAndReopenOnExit">Hide after game starts, reopen after game exits</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.Minimize">Minimize after game starts</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.KeepUnchanged">Keep unchanged after game starts</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.CloseImmediately.Warning.Message">If the launcher is closed immediately after the game starts, features such as crash detection and changing the game title will be unavailable.&#x0a;To keep these features, you can choose to hide the launcher after the game starts and close it automatically after the game exits.</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.CloseImmediately.Warning.Title">Reminder</sys:String>
    <sys:String x:Key="Setup.Launch.Visibility.CloseImmediately.Warning.Continue">Continue</sys:String>
    <sys:String x:Key="Setup.Launch.Priority.Label">Process Priority</sys:String>
    <sys:String x:Key="Setup.Launch.Priority.High">High (prioritizes game performance, but may cause other programs to lag)</sys:String>
    <sys:String x:Key="Setup.Launch.Priority.Normal">Normal (balanced)</sys:String>
    <sys:String x:Key="Setup.Launch.Priority.Low">Low (prioritizes other programs, but may cause the game to lag, suitable for running in background)</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.Label">Window Size</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.ModernUiWarning">Note: If your instance has the Modern UI mod installed, this setting will not take effect</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.Fullscreen">Fullscreen</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.SameAsLauncher">Same as launcher size</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.Custom">Custom size</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.CustomHeightBug.ToolTip">Some versions such as Forge 1.12.2 have a bug that causes the height setting to not take effect</sys:String>
    <sys:String x:Key="Setup.Launch.WindowSize.Maximized">Maximized</sys:String>
    <sys:String x:Key="Setup.Launch.MsAuth.Label">Microsoft Authentication</sys:String>
    <sys:String x:Key="Setup.Launch.MsAuth.ToolTip">The Web Account Manager offers a simpler authentication flow, while the Device Code flow allows you to authenticate on any device with a web browser.&#x0a;If you encounter issues with the Web Account Manager, try using the Device Code flow.&#x0a;If you are temporarily signing in on a public computer, Device Code flow is recommended.&#x0a;&#x0a;Due to issues with some dependencies, this option is temporarily forced to Device Code flow.</sys:String>
    <sys:String x:Key="Setup.Launch.MsAuth.WebManager">Web Account Manager (temporarily forced to Device Code flow)</sys:String>
    <sys:String x:Key="Setup.Launch.MsAuth.DeviceCode">Device Code flow</sys:String>
    <sys:String x:Key="Setup.Launch.IpStack.Label">IP Protocol Preference</sys:String>
    <sys:String x:Key="Setup.Launch.IpStack.ToolTip">Set the MC IP protocol version preference via Java VM arguments.&#x0a;It is generally recommended to set to "IPv4 Only", which ensures the PCL CE lobby works properly.&#x0a;If you need manual IPv6 networking, you can choose other options.&#x0a;&#x0a;IPv4 Only: -Djava.net.preferIPv4Stack=true&#x0a;Default: No extra arguments&#x0a;IPv6 Only: -Djava.net.preferIPv6Stack=true</sys:String>
    <sys:String x:Key="Setup.Launch.IpStack.Ipv4">IPv4 Only</sys:String>
    <sys:String x:Key="Setup.Launch.IpStack.JavaDefault">Java Default</sys:String>
    <sys:String x:Key="Setup.Launch.IpStack.Ipv6">IPv6 Only</sys:String>

