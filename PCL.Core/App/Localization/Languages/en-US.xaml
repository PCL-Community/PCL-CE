    <sys:String x:Key="Setup.Update.Changelog.Title">About this update</sys:String>
    <sys:String x:Key="Setup.Update.Changelog.View">Changelog</sys:String>
    <sys:String x:Key="Setup.Update.Changelog.MoreInfo">More information about this update...</sys:String>
    <sys:String x:Key="Setup.Update.Changelog.Empty">The developers seem to have forgotten to provide an update summary... Maybe click below to view the full changelog?</sys:String>
