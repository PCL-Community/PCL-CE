    <sys:String x:Key="Setup.Launch.Advanced.Renderer.Warning.Message">Changing this setting will severely affect game stability and performance. If you don't know what you are doing, do not change this option!&#x0a;Are you sure you want to continue?</sys:String>
    <sys:String x:Key="Setup.Launch.Advanced.Renderer.Warning.Title">Warning</sys:String>
