    <sys:String x:Key="Setup.Update.Changelog.Placeholder">PCL CE 2.14.0 brings a refreshing new design, several Pigeon smart features, and a delightful cross-instance workflow to boost your productivity.</sys:String>
    <sys:String x:Key="Setup.Update.DotNetMissing.Title">Launcher Update - Missing Runtime</sys:String>
