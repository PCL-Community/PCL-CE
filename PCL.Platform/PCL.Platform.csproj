<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyTitle>PCL.Platform</AssemblyTitle>
        <AssemblyName>PCL.Platform</AssemblyName>
        <Description>PCL CE 平台原生实现</Description>
        <Company>PCL Community</Company>
        <Product>PCL.Platform</Product>
        <Copyright>Copyright © PCL Community</Copyright>
        <RootNamespace>PCL.Platform</RootNamespace>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>15.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Configurations>Debug;CI;Release;Beta</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
        <PlatformTarget>$(Platform)</PlatformTarget>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <NoWarn>$(NoWarn);CS9113</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\PCL.Core\PCL.Core.csproj" />
    </ItemGroup>
</Project>
