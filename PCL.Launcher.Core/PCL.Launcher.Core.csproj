<Project Sdk="Microsoft.NET.Sdk">
    <!-- PCL 业务核心：从 Plain Craft Launcher 2/Modules 拆出的业务逻辑，自定义许可。 -->
    <PropertyGroup>
        <AssemblyTitle>PCL.Launcher.Core</AssemblyTitle>
        <AssemblyName>PCL.Launcher.Core</AssemblyName>
        <Description>PCL 业务核心</Description>
        <Company>PCL Community</Company>
        <Product>PCL.Launcher.Core</Product>
        <RootNamespace>PCL</RootNamespace>
        <TargetFramework>net10.0-windows</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Configurations>Debug;CI;Release;Beta</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
        <NoWarn>$(NoWarn);CS9113</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.79" />
        <PackageReference Include="Downloader" Version="5.9.4" />
        <PackageReference Include="protobuf-net" Version="3.2.56" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="PCL.Text" />
        <Using Include="System.Text.Json" />
        <Using Include="System.Text.Json.Nodes" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PCL.Core\PCL.Core.csproj" />
    </ItemGroup>
</Project>
