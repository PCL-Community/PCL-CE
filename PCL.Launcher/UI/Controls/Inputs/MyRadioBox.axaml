<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.UI.Controls.MyRadioBox"
             Background="Transparent"
             Focusable="True"
             MinWidth="20"
             MinHeight="20"
             UseLayoutRounding="False">
    <Grid>
        <TextBlock x:Name="LabTextElement"
                   Margin="26,0,0,0"
                   FontSize="13"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />
        <Grid Width="18"
              Height="18"
              Margin="1,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              UseLayoutRounding="False"
              IsHitTestVisible="False">
            <Ellipse x:Name="ShapeBorderElement"
                     Width="18"
                     Height="18"
                     StrokeThickness="1.1"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
            <Ellipse x:Name="ShapeDotElement"
                     Width="0"
                     Height="0"
                     Opacity="0"
                     Fill="{Binding Stroke, ElementName=ShapeBorderElement}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Grid>
        <Border x:Name="FocusRing"
                Classes="FocusRing"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>