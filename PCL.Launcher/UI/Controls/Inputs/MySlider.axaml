<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.UI.Controls.MySlider"
             Background="Transparent"
             Focusable="True"
             MinHeight="16">
    <!-- 双导轨 + 圆形拖点 + 数值提示 Popup；拖点缩放与配色由代码驱动动画。 -->
    <Grid x:Name="PanMainElement"
          MinHeight="16"
          MaxHeight="16"
          IsHitTestVisible="False">
        <Border x:Name="LineBackElement"
                Width="0"
                Height="4"
                Opacity="0.3"
                CornerRadius="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" />
        <Border x:Name="LineForeElement"
                Width="0"
                Height="4"
                CornerRadius="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" />
        <Ellipse x:Name="ShapeDotElement"
                 Width="10"
                 Height="10"
                 StrokeThickness="1.2"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Popup x:Name="PopupElement"
               IsOpen="False">
            <Border x:Name="HintBorderElement"
                    MaxWidth="500"
                    Padding="7,5"
                    BorderThickness="1.5"
                    CornerRadius="3">
                <TextBlock x:Name="TextHintElement"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>
        </Popup>
    </Grid>
</UserControl>