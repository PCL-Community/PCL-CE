<Label xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       x:Class="PCL.UI.Controls.MyTextButton"
       Focusable="False">
    <Label.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PCL.Launcher/UI/Styles/Controls/ButtonPalette.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Label.Resources>
    <Label.Styles>
        <StyleInclude Source="avares://PCL.Launcher/UI/Styles/Controls/MyTextButton.axaml" />
    </Label.Styles>
    <TextBlock x:Name="LabText"
               VerticalAlignment="Center" />
</Label>