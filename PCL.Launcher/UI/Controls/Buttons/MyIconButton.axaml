<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="using:PCL.UI.Controls.SvgIcon"
        x:Class="PCL.UI.Controls.MyIconButton">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PCL.Launcher/UI/Styles/Controls/ButtonPalette.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Border.Resources>
    <Border.Styles>
        <StyleInclude Source="avares://PCL.Launcher/UI/Styles/Controls/MyIconButton.axaml" />
    </Border.Styles>
    <Border x:Name="PanBack"
            CornerRadius="1000"
            IsHitTestVisible="False">
        <Grid x:Name="IconHost"
              Margin="5"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Path x:Name="Path"
                  Stretch="Uniform"
                  RenderTransformOrigin="0.5,0.5" />
            <svg:SvgIcon x:Name="ShapeSvgIcon"
                         Stretch="Uniform"
                         IsVisible="False"
                         IconBrush="{Binding Fill, ElementName=Path}" />
        </Grid>
    </Border>
</Border>