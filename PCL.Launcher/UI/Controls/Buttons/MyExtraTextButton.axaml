<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:svg="using:PCL.UI.Controls.SvgIcon"
      x:Class="PCL.UI.Controls.MyExtraTextButton"
      Height="52"
      Margin="20"
      RenderTransformOrigin="0.5,0.5"
      ToolTip.Placement="Left">
    <Grid.Styles>
        <StyleInclude Source="avares://PCL.Launcher/UI/Styles/Controls/MyExtraTextButton.axaml" />
    </Grid.Styles>
    <Grid.RenderTransform>
        <ScaleTransform ScaleX="0"
                        ScaleY="0" />
    </Grid.RenderTransform>
    <Border x:Name="PanClick"
            Background="Transparent" />
    <Grid x:Name="PanScale"
          Margin="0,10,0,0"
          IsHitTestVisible="False"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform />
        </Grid.RenderTransform>
        <Border x:Name="PanColor"
                BoxShadow="0 0 10 0 #33000000" />
        <StackPanel Orientation="Horizontal"
                    Margin="20,0">
            <Grid x:Name="IconHost"
                  Width="16"
                  Margin="2,12,0,12"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform />
                </Grid.RenderTransform>
                <Path x:Name="Path"
                      Stretch="Uniform" />
                <svg:SvgIcon x:Name="ShapeSvgIcon"
                             Stretch="Uniform"
                             IsVisible="False"
                             IconBrush="{Binding Fill, ElementName=Path}" />
            </Grid>
            <TextBlock x:Name="LabText"
                       Margin="12,0,0,0.8"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="{DynamicResource ColorBrush8}" />
        </StackPanel>
    </Grid>
</Grid>