<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:PCL.UI.Controls">
    <!--
        外层 PanBack 只负责命中测试与焦点，可见配色与缩放都落在内层 PanFore 上。
        悬停/按下/禁用的过渡由 MyButton.axaml.cs 逐帧插值，这里只提供初始配色。
    -->
    <Style Selector="ui|MyButton">
        <Setter Property="Background"
                Value="{DynamicResource ButtonBrushSemiTransparent}" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Focusable"
                Value="True" />
        <Setter Property="UseLayoutRounding"
                Value="True" />
    </Style>
    <Style Selector="ui|MyButton > Border#PanFore">
        <Setter Property="CornerRadius"
                Value="3" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource PageBrushText}" />
        <Setter Property="Background"
                Value="{DynamicResource ButtonBrushChrome}" />
    </Style>
    <Style Selector="ui|MyButton.color-highlight > Border#PanFore">
        <Setter Property="Background"
                Value="{DynamicResource PageBrushItemChecked}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ButtonBrushAccentDeep}" />
    </Style>
    <Style Selector="ui|MyButton.color-red > Border#PanFore">
        <Setter Property="Background"
                Value="{DynamicResource ButtonBrushRedBack}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource PageBrushFatal}" />
    </Style>
</Styles>