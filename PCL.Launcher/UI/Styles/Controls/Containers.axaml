<!--
    容器与列表控件的样式覆盖层。
    颜色全部走 ThemeService 写入 Application.Resources 的核心 ColorBrush* 键；
    控件构造函数通过 ContainerTheme.AttachStyles 引入本文件，这里给出视觉默认值。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:PCL.UI.Controls">
    <Styles.Resources>
        <SolidColorBrush x:Key="ListItemTagBubbleBackground"
                         Color="#11000000" />
    </Styles.Resources>

    <!-- 列表项 -->
    <Style Selector="ui|MyListItem">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="ClipToBounds"
                Value="False" />
    </Style>

    <Style Selector="ui|MyListItem TextBlock.ListItemTitle">
        <Setter Property="Foreground"
                Value="{DynamicResource ColorBrush1}" />
    </Style>

    <Style Selector="ui|MyListItem Border.ListItemBack">
        <Setter Property="Background"
                Value="{DynamicResource ColorBrush7}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ColorBrush7}" />
    </Style>

    <Style Selector="ui|MyListItem Border.ListItemCheck">
        <Setter Property="Background"
                Value="{DynamicResource ColorBrush3}" />
    </Style>

    <Style Selector="ui|MyListItem TextBlock.ListItemTagText">
        <Setter Property="Foreground"
                Value="{DynamicResource ColorBrushGray3}" />
        <Setter Property="FontSize"
                Value="11" />
    </Style>

    <Style Selector="ui|MyListItem Border.ListItemTagBubble">
        <Setter Property="Background"
                Value="{DynamicResource ListItemTagBubbleBackground}" />
        <Setter Property="Padding"
                Value="3,1" />
        <Setter Property="CornerRadius"
                Value="3" />
        <Setter Property="Margin"
                Value="0,0,3,0" />
    </Style>

    <!-- 折叠栏 -->
    <Style Selector="ui|MyCollapseBar TextBlock.CollapseTitle">
        <Setter Property="Foreground"
                Value="{DynamicResource ColorBrush1}" />
    </Style>

    <Style Selector="ui|MyCollapseBar Path.CollapseTriangle">
        <Setter Property="Fill"
                Value="{DynamicResource ColorBrush1}" />
    </Style>

    <!-- 页面壳 -->
    <Style Selector="ui|MyPageLeft">
        <Setter Property="Background"
                Value="Transparent" />
    </Style>

    <Style Selector="ui|MyPageRight">
        <Setter Property="ClipToBounds"
                Value="False" />
    </Style>

    <!-- 滚动容器 -->
    <Style Selector="ui|MyScrollViewer">
        <Setter Property="Background"
                Value="Transparent" />
    </Style>

    <Style Selector="ui|MyScrollBar">
        <Setter Property="MinWidth"
                Value="8" />
    </Style>
</Styles>