<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:PCL.UI.Controls">
    <!-- MyExtraButton：侧边栏圆形附加按钮，PanColor 为该按钮的常态底色。 -->
    <Style Selector="ui|MyExtraButton Border#PanColor">
        <Setter Property="Background"
                Value="{DynamicResource PageBrushAccent}" />
    </Style>
    <!-- 悬停/禁用底色由 MyExtraButton.axaml.cs 用动画接管，这里只保留常态基线。 -->
    <Style Selector="ui|MyExtraButton Path">
        <Setter Property="Fill"
                Value="{DynamicResource ButtonBrushIconWhite}" />
    </Style>
</Styles>