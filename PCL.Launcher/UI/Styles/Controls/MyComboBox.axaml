<!--
    MyComboBox 的模板与样式：按 WPF Application.xaml:423-522 的自绘模板重写。
    结构为单层 Border（底色/1px 描边/圆角 3）+ 内容呈现 + 右侧 15×8 箭头 + 下拉 Popup；
    配色由控件代码驱动（Foreground 同时作为描边色，Background 作为底色）。
    Avalonia 的 ComboBox 要求模板内保留 PART_Popup / PART_EditableTextBox / PART_ItemsPresenter，
    内容宿主命名为 PART_ContentPresenter 供控件代码查找；可编辑模式沿用 MyTextBox。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:PCL.UI.Controls">
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type ui:MyComboBox}"
                      TargetType="ui:MyComboBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource ColorBrushBg0}" />
            <Setter Property="Background"
                    Value="{DynamicResource ColorBrushHalfWhite}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ColorBrushBg0}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="3" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="MinHeight"
                    Value="26" />
            <Setter Property="MaxDropDownHeight"
                    Value="160" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="FocusAdorner"
                    Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="HorizontalAlignment"
                    Value="Left" />
            <Setter Property="VerticalAlignment"
                    Value="Top" />
            <Setter Property="PlaceholderForeground"
                    Value="{DynamicResource ColorBrushGray4}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto" />
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Grid>
                            <Border x:Name="Background"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />

                            <TextBlock x:Name="PlaceholderTextBlock"
                                       Margin="8.5,0,21.5,0"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="{TemplateBinding PlaceholderForeground}">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="SelectionBoxItem"
                                                 RelativeSource="{RelativeSource TemplatedParent}"
                                                 Converter="{x:Static ObjectConverters.IsNull}" />
                                        <Binding Path="!IsEditable"
                                                 RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>

                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8.5,0,21.5,0"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />

                            <ui:MyTextBox Name="PART_EditableTextBox"
                                          Margin="1.5,0,21.5,0"
                                          Padding="0"
                                          Background="Transparent"
                                          Text="{TemplateBinding Text, Mode=TwoWay}"
                                          PlaceholderText="{TemplateBinding PlaceholderText}"
                                          BorderThickness="0"
                                          VerticalAlignment="Center"
                                          IsVisible="{TemplateBinding IsEditable}" />

                            <Path x:Name="DropDownGlyph"
                                  Width="15"
                                  Margin="0,0,1.5,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Data="M1,1L4.5,4.5L8,1"
                                  Stretch="None"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5"
                                  RenderTransformOrigin="0.3,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>

                            <Popup Name="PART_Popup"
                                   VerticalOffset="-1.5"
                                   Placement="Bottom"
                                   PlacementTarget="Background"
                                   WindowManagerAddShadowHint="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                   IsLightDismissEnabled="True"
                                   InheritsTransform="True">
                                <Grid x:Name="PanPopup">
                                    <Border Background="{DynamicResource ColorBrushWhite}"
                                            CornerRadius="3" />
                                    <Border x:Name="dropDownBorder"
                                            Width="{Binding Width, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            Background="Transparent"
                                            BorderBrush="{TemplateBinding Foreground}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                      IsScrollChainingEnabled="False"
                                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                                      IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}">
                                            <ItemsPresenter Name="PART_ItemsPresenter"
                                                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:empty /template/ Border#dropDownBorder">
                <Setter Property="MinHeight"
                        Value="26" />
            </Style>

            <Style Selector="^[IsEditable=true]">
                <Setter Property="IsTabStop"
                        Value="False" />
                <Setter Property="KeyboardNavigation.TabNavigation"
                        Value="Local" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
</Styles>