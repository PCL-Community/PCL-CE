<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        按钮族专用调色板：补充 PageStyles.axaml 的 PageBrush* 主色表未覆盖的按钮键值。
        控件通过 DynamicResource 引用这些键，颜色字面量只出现在本文件。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonBrushChrome"
                             Color="#55FFFFFF" />
            <SolidColorBrush x:Key="ButtonBrushSemiTransparent"
                             Color="#01EAF2FE" />
            <SolidColorBrush x:Key="ButtonBrushChromePressed"
                             Color="#D5E6FD" />
            <SolidColorBrush x:Key="ButtonBrushAccentDeep"
                             Color="#0B5BCB" />
            <SolidColorBrush x:Key="ButtonBrushRedBack"
                             Color="#80FBDDDD" />
            <SolidColorBrush x:Key="ButtonBrushRedIcon"
                             Color="#A0FF4C4C" />
            <SolidColorBrush x:Key="ButtonBrushIconWhite"
                             Color="#EAF2FE" />
            <SolidColorBrush x:Key="ButtonBrushWhiteHover"
                             Color="#32FFFFFF" />
            <SolidColorBrush x:Key="ButtonBrushBlackIcon"
                             Color="#A0000000" />
            <SolidColorBrush x:Key="ButtonBrushBlackIconHover"
                             Color="#E6000000" />
            <SolidColorBrush x:Key="ButtonBrushRibble"
                             Color="#96C0F9" />
            <SolidColorBrush x:Key="ButtonBrushProgressBack"
                             Color="#2FFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonBrushChrome"
                             Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ButtonBrushSemiTransparent"
                             Color="#01FFFFFF" />
            <SolidColorBrush x:Key="ButtonBrushChromePressed"
                             Color="#4D2F6BD6" />
            <SolidColorBrush x:Key="ButtonBrushAccentDeep"
                             Color="#5AA2FF" />
            <SolidColorBrush x:Key="ButtonBrushRedBack"
                             Color="#33FF6B5A" />
            <SolidColorBrush x:Key="ButtonBrushRedIcon"
                             Color="#A0FF6B5A" />
            <SolidColorBrush x:Key="ButtonBrushIconWhite"
                             Color="#EAF2FE" />
            <SolidColorBrush x:Key="ButtonBrushWhiteHover"
                             Color="#32FFFFFF" />
            <SolidColorBrush x:Key="ButtonBrushBlackIcon"
                             Color="#A0FFFFFF" />
            <SolidColorBrush x:Key="ButtonBrushBlackIconHover"
                             Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="ButtonBrushRibble"
                             Color="#3D6BA8" />
            <SolidColorBrush x:Key="ButtonBrushProgressBack"
                             Color="#2FFFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>