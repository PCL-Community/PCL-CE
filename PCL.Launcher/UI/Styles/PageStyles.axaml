<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:PCL.UI.Controls">
    <Style Selector="Border.WindowSurface">
        <Setter Property="Background"
                Value="{DynamicResource ColorBrushTransparentBackground}" />
    </Style>

    <Style Selector="Border.WindowSurface.Opaque">
        <Setter Property="Background"
                Value="{DynamicResource ColorBrushBackground}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource LaunchFontFamily}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{DynamicResource ColorBrush1}" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button">
        <Setter Property="FontFamily"
                Value="{DynamicResource LaunchFontFamily}" />
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="FontFamily"
                Value="{DynamicResource LaunchFontFamily}" />
    </Style>
    <Style Selector="RepeatButton">
        <Setter Property="FontFamily"
                Value="{DynamicResource LaunchFontFamily}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="FontFamily"
                Value="{DynamicResource LaunchFontFamily}" />
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="FontFamily"
                Value="{DynamicResource LaunchFontFamily}" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="FontFamily"
                Value="{DynamicResource LaunchFontFamily}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="FontFamily"
                Value="{DynamicResource LaunchFontFamily}" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="FontFamily"
                Value="{DynamicResource LaunchFontFamily}" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="FontFamily"
                Value="{DynamicResource LaunchFontFamily}" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="FontFamily"
                Value="{DynamicResource LaunchFontFamily}" />
    </Style>
    <Style Selector="SelectableTextBlock">
        <Setter Property="FontFamily"
                Value="{DynamicResource LaunchFontFamily}" />
    </Style>

    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Margin"
                Value="0,0,0,14" />
    </Style>
    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Opacity"
                Value="0.6" />
        <Setter Property="Margin"
                Value="13,18,5,4" />
    </Style>
    <Style Selector="TextBlock.RowTitle">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.RowInfo">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{DynamicResource ColorBrushGray3}" />
    </Style>
    <Style Selector="TextBlock.Hint">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{DynamicResource ColorBrushGray3}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style Selector="Border.Card">
        <Setter Property="Background"
                Value="{DynamicResource ColorBrushTransparentBackground}" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="CornerRadius"
                Value="5" />
        <Setter Property="BoxShadow"
                Value="0 0 3 0 #12000000" />
    </Style>
    <Style Selector="Border.PageListItem">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="CornerRadius"
                Value="6" />
        <Setter Property="Padding"
                Value="8,6" />
        <Setter Property="Margin"
                Value="4,1" />
    </Style>
    <Style Selector="Border.PageListItem:pointerover">
        <Setter Property="Background"
                Value="{DynamicResource ColorBrushBg1}" />
    </Style>
    <Style Selector="Border.PageListItem.Checked">
        <Setter Property="Background"
                Value="{DynamicResource ColorBrush7}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Padding"
                Value="14,6" />
        <Setter Property="CornerRadius"
                Value="4" />
        <Setter Property="Background"
                Value="{DynamicResource ColorBrush3}" />
        <Setter Property="Foreground"
                Value="{DynamicResource ColorBrushWhite}" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background"
                Value="{DynamicResource ColorBrush4}" />
    </Style>
    <Style Selector="Button.PageIconButton">
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Width"
                Value="28" />
        <Setter Property="Height"
                Value="28" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource ColorBrushGray3}" />
        <Setter Property="FontSize"
                Value="15" />
    </Style>
    <Style Selector="Button.PageIconButton:pointerover">
        <Setter Property="Background"
                Value="{DynamicResource ColorBrushBg1}" />
        <Setter Property="Foreground"
                Value="{DynamicResource ColorBrush1}" />
    </Style>
    <Style Selector="Button.PageLinkButton">
        <Setter Property="Padding"
                Value="4,2" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource ColorBrush3}" />
    </Style>
    <Style Selector="Button.PageLinkButton:pointerover">
        <Setter Property="Background"
                Value="{DynamicResource ColorBrush7}" />
        <Setter Property="Foreground"
                Value="{DynamicResource ColorBrush3}" />
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="MinWidth"
                Value="0" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="FontSize"
                Value="13" />
    </Style>

    <Style Selector="Border.FocusRing">
        <Setter Property="IsVisible"
                Value="False" />
        <Setter Property="Margin"
                Value="-2" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ColorBrush2}" />
        <Setter Property="BorderThickness"
                Value="2" />
        <Setter Property="CornerRadius"
                Value="4" />
    </Style>
    <Style Selector="ui|MyButton:focus-visible Border#FocusRing,
                     ui|MyIconButton:focus-visible Border#FocusRing,
                     ui|MyTextButton:focus-visible Border#FocusRing,
                     ui|MyIconTextButton:focus-visible Border#FocusRing,
                     ui|MyExtraButton:focus-visible Border#FocusRing,
                     ui|MyExtraTextButton:focus-visible Border#FocusRing,
                     ui|MyRadioButton:focus-visible Border#FocusRing,
                     ui|MyCheckBox:focus-visible Border#FocusRing,
                     ui|MyRadioBox:focus-visible Border#FocusRing,
                     ui|MySlider:focus-visible Border#FocusRing,
                     ui|MyListItem:focus-visible Border.FocusRing">
        <Setter Property="IsVisible"
                Value="True" />
    </Style>
    <Style Selector="ui|MyIconButton:focus-visible Border#FocusRing,
                     ui|MyExtraButton:focus-visible Border#FocusRing">
        <Setter Property="CornerRadius"
                Value="1000" />
    </Style>
    <Style Selector="ui|MyButton:focus-visible Border#FocusRing,
                     ui|MyTextButton:focus-visible Border#FocusRing,
                     ui|MyListItem:focus-visible Border.FocusRing">
        <Setter Property="CornerRadius"
                Value="3" />
    </Style>
    <Style Selector="ui|MyIconTextButton:focus-visible Border#FocusRing,
                     ui|MyRadioButton:focus-visible Border#FocusRing">
        <Setter Property="CornerRadius"
                Value="13.5" />
    </Style>
</Styles>