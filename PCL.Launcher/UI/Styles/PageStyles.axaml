<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <!--
                页面配色按 Light/Dark 主题成对提供：页面文本直接压在窗口材质上，
                浅色主题用深色文字、深色主题用浅色文字，避免系统切换主题后内容不可读。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBrushText"
                                     Color="#FF343D4A" />
                    <SolidColorBrush x:Key="PageBrushTextSecondary"
                                     Color="#FF8C8C8C" />
                    <SolidColorBrush x:Key="PageBrushWindowSurface"
                                     Color="#B8FBFBFB" />
                    <SolidColorBrush x:Key="PageBrushWindowFallback"
                                     Color="#FFFBFBFB" />
                    <SolidColorBrush x:Key="PageBrushCard"
                                     Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="PageBrushCardBorder"
                                     Color="#22808080" />
                    <SolidColorBrush x:Key="PageBrushDivider"
                                     Color="#22808080" />
                    <SolidColorBrush x:Key="PageBrushAccent"
                                     Color="#FF1370F3" />
                    <SolidColorBrush x:Key="PageBrushAccentHover"
                                     Color="#FF4890F5" />
                    <SolidColorBrush x:Key="PageBrushAccentLight"
                                     Color="#FFE0EAFD" />
                    <SolidColorBrush x:Key="PageBrushItemHover"
                                     Color="#14808080" />
                    <SolidColorBrush x:Key="PageBrushItemChecked"
                                     Color="#FFEAF2FE" />
                    <SolidColorBrush x:Key="PageBrushError"
                                     Color="#FFE74C3C" />
                    <SolidColorBrush x:Key="PageBrushWarn"
                                     Color="#FFF39C12" />
                    <SolidColorBrush x:Key="PageBrushFatal"
                                     Color="#FFC23616" />
                    <SolidColorBrush x:Key="PageBrushDebug"
                                     Color="#FF95A5A6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBrushText"
                                     Color="#FFEDEDF2" />
                    <SolidColorBrush x:Key="PageBrushTextSecondary"
                                     Color="#FF9E9EA8" />
                    <SolidColorBrush x:Key="PageBrushWindowSurface"
                                     Color="#B81C1C1C" />
                    <SolidColorBrush x:Key="PageBrushWindowFallback"
                                     Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="PageBrushCard"
                                     Color="#FF2A2A2A" />
                    <SolidColorBrush x:Key="PageBrushCardBorder"
                                     Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="PageBrushDivider"
                                     Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="PageBrushAccent"
                                     Color="#FF5AA2FF" />
                    <SolidColorBrush x:Key="PageBrushAccentHover"
                                     Color="#FF7FB8FF" />
                    <SolidColorBrush x:Key="PageBrushAccentLight"
                                     Color="#333E6BB8" />
                    <SolidColorBrush x:Key="PageBrushItemHover"
                                     Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="PageBrushItemChecked"
                                     Color="#332F6BD6" />
                    <SolidColorBrush x:Key="PageBrushError"
                                     Color="#FFFF6B5A" />
                    <SolidColorBrush x:Key="PageBrushWarn"
                                     Color="#FFFFC04D" />
                    <SolidColorBrush x:Key="PageBrushFatal"
                                     Color="#FFFF7A6B" />
                    <SolidColorBrush x:Key="PageBrushDebug"
                                     Color="#FFB0B0B8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!--
        页面内容不再统一铺不透明底色：窗口根保持透明承接系统材质，
        由主窗口的 WindowSurface 壳层提供半透明承托，页面自身透明。
    -->
    <Style Selector="Border.WindowSurface">
        <Setter Property="Background"
                Value="{DynamicResource PageBrushWindowSurface}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="Foreground"
                Value="{DynamicResource PageBrushText}" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Margin"
                Value="0,0,0,14" />
    </Style>
    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Opacity"
                Value="0.6" />
        <Setter Property="Margin"
                Value="13,18,5,4" />
    </Style>
    <Style Selector="TextBlock.RowTitle">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.RowInfo">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{DynamicResource PageBrushTextSecondary}" />
    </Style>
    <Style Selector="TextBlock.Hint">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Foreground"
                Value="{DynamicResource PageBrushTextSecondary}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style Selector="Border.Card">
        <Setter Property="Background"
                Value="{DynamicResource PageBrushCard}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource PageBrushCardBorder}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="6" />
        <Setter Property="BoxShadow"
                Value="0 2 8 0 #1A000000" />
    </Style>
    <Style Selector="Border.PageListItem">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="CornerRadius"
                Value="6" />
        <Setter Property="Padding"
                Value="8,6" />
        <Setter Property="Margin"
                Value="4,1" />
    </Style>
    <Style Selector="Border.PageListItem:pointerover">
        <Setter Property="Background"
                Value="{DynamicResource PageBrushItemHover}" />
    </Style>
    <Style Selector="Border.PageListItem.Checked">
        <Setter Property="Background"
                Value="{DynamicResource PageBrushItemChecked}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Padding"
                Value="14,6" />
        <Setter Property="CornerRadius"
                Value="4" />
        <Setter Property="Background"
                Value="{DynamicResource PageBrushAccent}" />
        <Setter Property="Foreground"
                Value="#FFFFFFFF" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Background"
                Value="{DynamicResource PageBrushAccentHover}" />
    </Style>
    <Style Selector="Button.PageIconButton">
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Width"
                Value="28" />
        <Setter Property="Height"
                Value="28" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource PageBrushTextSecondary}" />
        <Setter Property="FontSize"
                Value="15" />
    </Style>
    <Style Selector="Button.PageIconButton:pointerover">
        <Setter Property="Background"
                Value="{DynamicResource PageBrushItemHover}" />
        <Setter Property="Foreground"
                Value="{DynamicResource PageBrushText}" />
    </Style>
    <Style Selector="Button.PageLinkButton">
        <Setter Property="Padding"
                Value="4,2" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{DynamicResource PageBrushAccent}" />
    </Style>
    <Style Selector="Button.PageLinkButton:pointerover">
        <Setter Property="Background"
                Value="{DynamicResource PageBrushAccentLight}" />
        <Setter Property="Foreground"
                Value="{DynamicResource PageBrushAccent}" />
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="MinWidth"
                Value="0" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="FontSize"
                Value="13" />
    </Style>
</Styles>