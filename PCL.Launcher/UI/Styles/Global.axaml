<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:PCL.UI.Controls">
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type ui:MyMenuItem}"
                      TargetType="ui:MyMenuItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource ColorBrush1}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Height"
                    Value="26" />
            <Setter Property="MinHeight"
                    Value="26" />
            <Setter Property="Padding"
                    Value="8,0,40,0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_MenuItemBorder"
                            Height="26"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <Grid ColumnDefinitions="Auto,*">
                            <ContentControl Grid.Column="0"
                                            Margin="0,0,8,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Icon}"
                                            IsHitTestVisible="False" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_MenuItemBorder">
                <Setter Property="Background"
                        Value="{DynamicResource ColorBrush6}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity"
                        Value="0.45" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="Label">
        <Setter Property="Padding"
                Value="0" />
    </Style>

    <Style Selector="Calendar">
        <Setter Property="Background"
                Value="{DynamicResource ColorBrush8}" />
    </Style>

    <Style Selector="ContextMenu">
        <Setter Property="Background"
                Value="{DynamicResource ColorBrushWhite}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ColorBrush1}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="3" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Margin"
                Value="0,0,4,4" />
    </Style>

    <Style Selector="ContextMenu.NoScroll">
        <Setter Property="PlacementConstraintAdjustment"
                Value="FlipX,FlipY,SlideX,SlideY" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        MaxWidth="{TemplateBinding MaxWidth}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    KeyboardNavigation.TabNavigation="Continue"
                                    Grid.IsSharedSizeScope="True" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Height"
                Value="26" />
        <Setter Property="MinHeight"
                Value="26" />
        <Setter Property="Padding"
                Value="8,0,40,0" />
        <Setter Property="FontSize"
                Value="13" />
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="MinWidth"
                Value="15" />
        <Setter Property="MinHeight"
                Value="8" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Background"
                Value="Transparent" />
    </Style>

    <Style Selector="ui|MyScrollViewer.FullMargin">
        <Setter Property="ScrollBarMargin"
                Value="2,1,1,1" />
    </Style>

    <Style Selector="ui|MyScrollViewer.NoMargin">
        <Setter Property="ScrollBarMargin"
                Value="0" />
    </Style>
</Styles>