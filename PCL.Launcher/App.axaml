<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.App"
             Name="PCL Community Edition"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PCL.Launcher/UI/Theming/ThemeConstants.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PCL.Launcher/UI/Styles/PageStyles.axaml" />
        <StyleInclude Source="avares://PCL.Launcher/UI/Styles/Global.axaml" />
        <StyleInclude Source="avares://PCL.Launcher/UI/Styles/Controls/Inputs.axaml" />
        <StyleInclude Source="avares://PCL.Launcher/UI/Styles/Controls/Feedback.axaml" />
        <StyleInclude Source="avares://PCL.Launcher/UI/Styles/Controls/MyCard.axaml" />
        <StyleInclude Source="avares://PCL.Launcher/UI/Styles/Controls/ScrollBars.axaml" />
    </Application.Styles>
</Application>