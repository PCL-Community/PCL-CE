<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PCL.UI.Controls"
             xmlns:loc="using:PCL.Core.UI"
             x:Class="PCL.Views.Shell.TitleBar">
    <Grid x:Name="PanTitle"
          Height="48"
          Background="Transparent">
        <controls:AnimatedBackgroundGrid x:Name="TitleBackground"
                                         BackgroundBrush="{DynamicResource ColorBrush3}"
                                         IsHitTestVisible="False" />
        <Grid x:Name="PanTitleMain"
              ColumnDefinitions="1*,Auto,1*">
            <Grid x:Name="PanTitleLeft"
                  Grid.Column="0"
                  VerticalAlignment="Stretch"
                  ColumnDefinitions="Auto,*">
                <Grid Grid.Column="0"
                      VerticalAlignment="Center">
                    <Path x:Name="ShapeTitleLogo"
                          Data="M26,29 v-25 h6 a7,7 180 0 1 0,14 h-6 M62.5,6.5 a10,11.5 180 1 0 0,18 M71,2.5 v24.5 h13.5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="19,0,0,0"
                          Width="39"
                          Height="17"
                          Stretch="Fill"
                          Stroke="White"
                          StrokeThickness="2.2"
                          IsHitTestVisible="False" />
                    <Path x:Name="ShapeHMCLTitleLogo"
                          Data="M 60.375 53.406 L 53.625 53.406 L 53.625 0.906 L 63.6 0.906 L 78.15 34.131 L 92.475 0.906 L 102.675 0.906 L 102.675 53.406 L 95.55 53.406 L 95.55 9.981 L 81.525 41.556 L 74.475 41.556 L 60.375 9.981 L 60.375 53.406 Z M 7.125 53.406 L 0 53.406 L 0 0.906 L 7.125 0.906 L 7.125 23.331 L 33 23.331 L 33 0.906 L 40.125 0.906 L 40.125 53.406 L 33 53.406 L 33 29.481 L 7.125 29.481 L 7.125 53.406 Z M 149.85 2.706 L 147.675 8.706 Q 145.35 7.581 142.913 6.906 Q 140.475 6.231 137.175 6.231 Q 132.375 6.231 128.588 8.706 Q 124.8 11.181 122.625 15.831 A 25.755 25.755 0 0 0 120.458 26.263 A 38.963 38.963 0 0 0 120.45 27.081 Q 120.45 33.381 122.588 38.106 Q 124.725 42.831 128.512 45.456 Q 132.3 48.081 137.175 48.081 Q 140.85 48.081 143.55 47.181 Q 146.25 46.281 148.8 44.856 L 150.975 50.781 Q 148.2 52.281 144.638 53.293 Q 141.075 54.306 136.35 54.306 Q 129.525 54.306 124.275 51.043 Q 119.025 47.781 116.1 41.743 A 31.603 31.603 0 0 1 113.201 28.922 A 45.601 45.601 0 0 1 113.175 27.381 Q 113.175 19.356 116.138 13.168 Q 119.1 6.981 124.538 3.493 Q 129.975 0.006 137.25 0.006 Q 141 0.006 144.075 0.718 Q 147.15 1.431 149.85 2.706 Z M 191.925 53.406 L 160.725 53.406 L 160.725 0.906 L 167.85 0.906 L 167.85 47.031 L 191.925 47.031 L 191.925 53.406 Z"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="45,15.5,0,0"
                          Width="52"
                          Height="15"
                          Stretch="Fill"
                          Fill="White"
                          IsHitTestVisible="False"
                          IsVisible="False" />
                    <TextBlock x:Name="LabTitleLogo"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="18,0,0,0"
                               FontSize="17"
                               Foreground="White"
                               IsVisible="False"
                               IsHitTestVisible="False" />
                    <controls:MyImage x:Name="ImageTitleLogo"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="7"
                                      IsVisible="False"
                                      IsHitTestVisible="False" />
                </Grid>
                <Border x:Name="CELogo"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"
                        Background="White"
                        CornerRadius="5"
                        Width="20"
                        Height="18"
                        IsHitTestVisible="False">
                    <Path Fill="{DynamicResource ColorBrush3}"
                          Data="M3.1709 11.6098c-0.0423,-0.1524 -0.0783,-0.2985 -0.1079,-0.4382 -0.0297,-0.1397 -0.0551,-0.3048 -0.0762,-0.4953 -0.0212,-0.1905 -0.036,-0.4212 -0.0445,-0.6921 -0.0085,-0.2709 -0.0127,-0.6011 -0.0127,-0.9906 0,-0.3979 0.0042,-0.7324 0.0127,-1.0033 0.0085,-0.2709 0.0233,-0.5017 0.0445,-0.6922 0.0211,-0.1905 0.0465,-0.3577 0.0762,-0.5016 0.0296,-0.1439 0.0656,-0.2836 0.1079,-0.4191 0.2286,-0.7281 0.6054,-1.2658 1.1303,-1.6129 0.5249,-0.3471 1.1684,-0.5207 1.9304,-0.5207 0.6943,0 1.2954,0.1587 1.8034,0.4762 0.508,0.3175 0.8932,0.7684 1.1557,1.3526 0,0 -0.0169,0.0212 -0.0508,0.0635l-0.8001 0.381c-0.0169,0.0169 -0.0381,0.0127 -0.0635,-0.0127 -0.1947,-0.3979 -0.453,-0.7176 -0.7747,-0.9589 -0.3217,-0.2413 -0.7451,-0.3619 -1.27,-0.3619 -0.5334,0 -0.9673,0.1249 -1.3017,0.3746 -0.3345,0.2498 -0.5906,0.6118 -0.7684,1.0859 -0.0254,0.1016 -0.0508,0.2117 -0.0762,0.3302 -0.0254,0.1185 -0.0444,0.2625 -0.0571,0.4318 -0.0127,0.1693 -0.0233,0.3831 -0.0318,0.6413 -0.0085,0.2583 -0.0127,0.5737 -0.0127,0.9462 0,0.3725 0.0042,0.6858 0.0127,0.9398 0.0085,0.254 0.0191,0.4657 0.0318,0.635 0.0127,0.1693 0.0317,0.3154 0.0571,0.4381 0.0254,0.1228 0.0508,0.2308 0.0762,0.3239 0.1778,0.4741 0.4339,0.8361 0.7684,1.0858 0.3344,0.2498 0.7683,0.3747 1.3017,0.3747 0.5249,0 0.9483,-0.1207 1.27,-0.362 0.3217,-0.2413 0.58,-0.5609 0.7747,-0.9588 0.0254,-0.0254 0.0466,-0.0296 0.0635,-0.0127l0.8001 0.3937c0,0 0.0169,0.0212 0.0508,0.0635 -0.2625,0.5842 -0.6477,1.035 -1.1557,1.3525 -0.508,0.3175 -1.1091,0.4763 -1.8034,0.4763 -0.762,0 -1.4055,-0.1757 -1.9304,-0.5271 -0.5249,-0.3513 -0.9017,-0.8868 -1.1303,-1.6065 M11.4792 4.4343c0,-0.0254 0.0127,-0.0381 0.0381,-0.0381l5.715 0c0.0254,0 0.0381,0.0127 0.0381,0.0381l0 0.8763c0,0.0254 -0.0127,0.0381 -0.0381,0.0381l-4.5339 0c-0.1185,0 -0.1778,0.0635 -0.1778,0.1905l0 2.794c0,0.1185 0.0593,0.1778 0.1778,0.1778l3.8481 0c0.0254,0 0.0381,0.0127 0.0381,0.0381l0 0.8763c0,0.0254 -0.0127,0.0381 -0.0381,0.0381l-3.8481 0c-0.1185,0 -0.1778,0.0635 -0.1778,0.1905l0 2.8956c0,0.1185 0.0593,0.1778 0.1778,0.1778l4.5339 0c0.0254,0 0.0381,0.0127 0.0381,0.0381l0 0.889c0,0.0254 -0.0127,0.0381 -0.0381,0.0381l-5.715 0c-0.0254,0 -0.0381,-0.0127 -0.0381,-0.0381l0 -9.2202z" />
                </Border>
            </Grid>
            <StackPanel x:Name="PanTitleSelect"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Height="27"
                        Margin="13,0">
                <controls:MyRadioButton x:Name="BtnTitleSelect0"
                                        Text="{loc:Loc Main.Tab.Launch}"
                                        SvgIcon="lucide/play"
                                        LogoScale="0.9"
                                        ColorType="White"
                                        Checked="True"
                                        Padding="2,0"
                                        Margin="5,0"
                                        Check="Tab_OnCheck" />
                <controls:MyRadioButton x:Name="BtnTitleSelect1"
                                        Text="{loc:Loc Main.Tab.Download}"
                                        SvgIcon="lucide/download"
                                        LogoScale="0.9"
                                        ColorType="White"
                                        Padding="2,0"
                                        Margin="5,0"
                                        Check="Tab_OnCheck" />
                <controls:MyRadioButton x:Name="BtnTitleSelect2"
                                        Text="{loc:Loc Main.Tab.Settings}"
                                        SvgIcon="lucide/settings"
                                        LogoScale="1.1"
                                        ColorType="White"
                                        Padding="2,0"
                                        Margin="5,0"
                                        Check="Tab_OnCheck" />
                <controls:MyRadioButton x:Name="BtnTitleSelect3"
                                        Text="{loc:Loc Main.Tab.Tools}"
                                        SvgIcon="lucide/wrench"
                                        ColorType="White"
                                        Padding="2,0"
                                        Margin="5,0"
                                        Check="Tab_OnCheck" />
            </StackPanel>
        </Grid>
        <Grid x:Name="PanInnerTitle"
              Opacity="0"
              IsVisible="False">
            <controls:MyIconButton x:Name="BtnTitleInner"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Width="28"
                                   Height="28"
                                   Theme="White"
                                   LogoScale="0.87"
                                   SvgIcon="lucide/arrow-left"
                                   AutomationProperties.Name="{loc:Loc Common.Action.Back}"
                                   Click="Back_OnClick" />
            <TextBlock x:Name="LabTitleInner"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="47,1,60,0"
                       FontSize="15"
                       Foreground="White"
                       IsHitTestVisible="False" />
        </Grid>
        <StackPanel x:Name="PanCaptionButtons"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="0,0,12,0">
            <controls:MyIconButton x:Name="BtnTitleHelp"
                                   Width="28"
                                   Height="28"
                                   Theme="White"
                                   SvgIcon="lucide/circle-help"
                                   IsVisible="False"
                                   AutomationProperties.Name="{loc:Loc Main.Menu.Help}"
                                   Click="Help_OnClick" />
            <controls:MyIconButton x:Name="BtnTitleMin"
                                   Width="28"
                                   Height="28"
                                   Theme="White"
                                   SvgIcon="lucide/minus"
                                   AutomationProperties.Name="{loc:Loc Main.Menu.Minimize}"
                                   Click="Minimize_OnClick" />
            <controls:MyIconButton x:Name="BtnTitleClose"
                                   Width="28"
                                   Height="28"
                                   Theme="White"
                                   SvgIcon="lucide/x"
                                   AutomationProperties.Name="{loc:Loc Common.Action.Close}"
                                   Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</UserControl>