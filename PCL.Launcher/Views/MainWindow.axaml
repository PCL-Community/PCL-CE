<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1000"
        d:DesignHeight="640"
        x:Class="PCL.Views.MainWindow"
        Width="1000"
        Height="640"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        TransparencyBackgroundFallback="{DynamicResource PageBrushWindowFallback}"
        Title="PCL Community Edition">
    <Grid>
        <Border Name="WindowSurface"
                Classes="WindowSurface">
            <ContentControl Name="PageHost" />
        </Border>
    </Grid>
</Window>