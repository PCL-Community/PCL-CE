<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="using:PCL.UI.Controls"
      xmlns:svg="using:PCL.UI.Controls.SvgIcon"
      xmlns:loc="using:PCL.Core.UI"
      x:Class="PCL.Views.Pages.Download.MyCompItem"
      x:CompileBindings="False"
      x:Name="PanBack"
      Height="64"
      RenderTransformOrigin="0.5,0.5"
      Background="{DynamicResource ColorBrushSemiTransparent}">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="7" />
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition Height="20" />
        <RowDefinition Height="18" />
        <RowDefinition Height="16" />
        <RowDefinition Height="1.1*" />
    </Grid.RowDefinitions>

    <Border x:Name="RectBack"
            Grid.ColumnSpan="99"
            Grid.RowSpan="99"
            CornerRadius="3"
            BorderThickness="1"
            Background="{DynamicResource ColorBrush7}"
            BorderBrush="{DynamicResource ColorBrush6}"
            IsHitTestVisible="False"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1"
                            ScaleY="1" />
        </Border.RenderTransform>
    </Border>

    <Border Grid.Column="1"
            Grid.Row="1"
            Grid.RowSpan="3"
            Width="50"
            Height="50"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            IsHitTestVisible="False">
        <Border.Clip>
            <RectangleGeometry Rect="0,0,50,50"
                               RadiusX="6"
                               RadiusY="6" />
        </Border.Clip>
        <ui:MyImage x:Name="PathLogo"
                    CornerRadius="6"
                    FallbackSource="avares://PCL.Launcher/Assets/Images/Icons/NoIcon.png"
                    Stretch="Uniform"
                    IsHitTestVisible="False" />
    </Border>

    <StackPanel Grid.Column="3"
                Grid.ColumnSpan="2"
                Grid.Row="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                IsHitTestVisible="False">
        <TextBlock x:Name="LabTitle"
                   TextTrimming="WordEllipsis"
                   FontSize="14"
                   Text="{Binding ViewModel.TitleText, ElementName=PanBack}"
                   Foreground="{DynamicResource ColorBrush1}" />
        <TextBlock x:Name="LabTitleRaw"
                   TextTrimming="WordEllipsis"
                   FontSize="12"
                   Text="{Binding ViewModel.SubTitleText, ElementName=PanBack}"
                   Foreground="{DynamicResource ColorBrushGray1}"
                   Opacity="0.4"
                   VerticalAlignment="Center"
                   IsVisible="{Binding ViewModel.SubTitleVisible, ElementName=PanBack}" />
    </StackPanel>

    <StackPanel x:Name="PanTags"
                Grid.Row="2"
                Grid.Column="3"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="-1,0,1,0"
                IsVisible="False" />

    <TextBlock x:Name="LabInfo"
               Grid.Row="2"
               Grid.Column="4"
               VerticalAlignment="Center"
               Margin="0,0,3,0.5"
               Text="{Binding ViewModel.DescriptionText, ElementName=PanBack}"
               TextTrimming="CharacterEllipsis"
               FontSize="12"
               Foreground="{DynamicResource ColorBrushGray3}"
               IsHitTestVisible="True" />

    <Grid x:Name="PanStats"
          Grid.Row="3"
          Grid.Column="3"
          Grid.ColumnSpan="2"
          VerticalAlignment="Center"
          IsHitTestVisible="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto"
                              SharedSizeGroup="CompItemVersion" />
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto"
                              SharedSizeGroup="LabDownload" />
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto"
                              MinWidth="57"
                              SharedSizeGroup="CompItemTime" />
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto"
                              SharedSizeGroup="CompItemSource" />
            <ColumnDefinition Width="0.25*" />
        </Grid.ColumnDefinitions>

        <svg:SvgIcon x:Name="SvgIconVersion"
                     Grid.Column="0"
                     Width="12"
                     Height="12"
                     Stretch="Uniform"
                     VerticalAlignment="Center"
                     Icon="lucide/layout-list"
                     IconBrush="{DynamicResource ColorBrushGray3}" />
        <TextBlock x:Name="LabVersion"
                   Grid.Column="1"
                   Margin="4,0,2,0"
                   VerticalAlignment="Center"
                   FontSize="12"
                   TextTrimming="WordEllipsis"
                   Text="{Binding ViewModel.VersionText, ElementName=PanBack}"
                   Foreground="{DynamicResource ColorBrushGray3}" />

        <svg:SvgIcon x:Name="SvgIconDownload"
                     Grid.Column="3"
                     Width="12"
                     Height="12"
                     Stretch="Uniform"
                     VerticalAlignment="Center"
                     Icon="lucide/download"
                     IconBrush="{DynamicResource ColorBrushGray4}" />
        <TextBlock x:Name="LabDownload"
                   Grid.Column="4"
                   Margin="5,0,2,0"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Text="{Binding ViewModel.DownloadText, ElementName=PanBack}"
                   Foreground="{DynamicResource ColorBrushGray4}" />

        <svg:SvgIcon x:Name="SvgIconTime"
                     Grid.Column="6"
                     Width="12"
                     Height="12"
                     Margin="0,0,1,0"
                     Stretch="Uniform"
                     VerticalAlignment="Center"
                     Icon="lucide/arrow-up-from-line"
                     IconBrush="{DynamicResource ColorBrushGray4}" />
        <TextBlock x:Name="LabTime"
                   Grid.Column="7"
                   Margin="5,0,2,0"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Text="{Binding ViewModel.TimeText, ElementName=PanBack}"
                   Foreground="{DynamicResource ColorBrushGray4}" />

        <svg:SvgIcon x:Name="SvgIconSource"
                     Grid.Column="9"
                     Width="12"
                     Height="12"
                     Stretch="Uniform"
                     VerticalAlignment="Center"
                     Icon="lucide/globe"
                     IconBrush="{DynamicResource ColorBrushGray4}" />
        <TextBlock x:Name="LabSource"
                   Grid.Column="10"
                   Margin="5,0,2,0"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Text="{Binding ViewModel.SourceText, ElementName=PanBack}"
                   Foreground="{DynamicResource ColorBrushGray4}" />
    </Grid>

    <StackPanel x:Name="PanButtons"
                Grid.Column="5"
                Grid.Row="0"
                Grid.RowSpan="5"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,5,0"
                Opacity="0">
        <ui:MyIconButton x:Name="BtnDownload"
                         Height="25"
                         Width="25"
                         Margin="0,0,4,0"
                         Theme="Custom"
                         SvgIcon="lucide/download"
                         IsVisible="False"
                         ToolTip.Tip="{loc:Loc Download.Comp.QuickDownload.Btn.ToolTip}" />
        <ui:MyIconButton x:Name="BtnFavorite"
                         Height="25"
                         Width="25"
                         Theme="Custom"
                         SvgIcon="lucide/heart"
                         ToolTip.Tip="{loc:Loc Download.Comp.Detail.Favorite}" />
    </StackPanel>
</Grid>