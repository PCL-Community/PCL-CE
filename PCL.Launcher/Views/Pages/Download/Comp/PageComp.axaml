<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:PCL.UI.Controls"
             xmlns:loc="using:PCL.Core.UI"
             x:Class="PCL.Views.Pages.Download.PageComp">
    <ui:MyScrollViewer x:Name="PanBack"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <StackPanel x:Name="PanAlways">
                <ui:MySearchBox x:Name="PanSearchBox"
                                Margin="0,0,0,15"
                                HintText="{loc:Loc Download.Comp.Search.Hint}"
                                SearchButtonVisibility="True" />
                <ui:MyCard Margin="0,0,0,15"
                           UseAnimation="False">
                    <Grid Margin="7"
                          ColumnDefinitions="Auto,*,Auto,1.3*,Auto,*,Auto"
                          RowDefinitions="28,8,28">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="5,0,5,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Download.Comp.Filter.Source}" />
                        <ui:MyComboBox x:Name="ComboSearchSource"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       MaxDropDownHeight="320">
                            <ui:MyComboBoxItem Content="{loc:Loc Common.Option.All}"
                                               Tag="3" />
                            <ui:MyComboBoxItem x:Name="ItemSourceCurseForge"
                                               Content="CurseForge"
                                               Tag="1" />
                            <ui:MyComboBoxItem x:Name="ItemSourceModrinth"
                                               Content="Modrinth"
                                               Tag="2" />
                        </ui:MyComboBox>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Margin="5,0,5,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Download.Comp.Filter.Tag}" />
                        <ui:MyComboBox x:Name="ComboSearchTag"
                                       Grid.Row="0"
                                       Grid.Column="3"
                                       MaxDropDownHeight="320" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="4"
                                   Margin="5,0,5,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Download.Comp.Filter.Sort}" />
                        <ui:MyComboBox x:Name="ComboSearchSort"
                                       Grid.Row="0"
                                       Grid.Column="5"
                                       MaxDropDownHeight="320">
                            <ui:MyComboBoxItem Content="{loc:Loc Common.Option.Default}"
                                               Tag="1" />
                            <ui:MyComboBoxItem Content="{loc:Loc Download.Comp.Sort.Relevance}"
                                               Tag="2" />
                            <ui:MyComboBoxItem Content="{loc:Loc Download.Comp.Sort.Downloads}"
                                               Tag="3" />
                            <ui:MyComboBoxItem Content="{loc:Loc Download.Comp.Sort.Follows}"
                                               Tag="4" />
                            <ui:MyComboBoxItem Content="{loc:Loc Download.Comp.Sort.Latest}"
                                               Tag="5" />
                            <ui:MyComboBoxItem Content="{loc:Loc Download.Comp.Sort.Updated}"
                                               Tag="6" />
                        </ui:MyComboBox>
                        <StackPanel Grid.Row="0"
                                    Grid.Column="6"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0">
                            <ui:MyIconButton x:Name="BtnSearchReset"
                                             LogoScale="0.9"
                                             SvgIcon="lucide/rotate-ccw" />
                            <ui:MyIconButton x:Name="BtnSearchInstallModPack"
                                             Margin="3,0,0,0"
                                             LogoScale="0.9"
                                             SvgIcon="lucide/download"
                                             IsVisible="False" />
                        </StackPanel>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="5,0,5,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Download.Comp.Filter.Version}" />
                        <ui:MyComboBox x:Name="TextSearchVersion"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,0,10,0"
                                       IsEditable="True"
                                       MaxDropDownHeight="320" />
                        <TextBlock x:Name="LabLoader"
                                   Grid.Row="2"
                                   Grid.Column="2"
                                   Margin="5,0,5,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Download.Comp.Filter.Loader}" />
                        <ui:MyComboBox x:Name="ComboSearchLoader"
                                       Grid.Row="2"
                                       Grid.Column="3"
                                       MaxDropDownHeight="320">
                            <ui:MyComboBoxItem Content="{loc:Loc Download.Comp.Filter.Loader.Any}"
                                               Tag="0" />
                            <ui:MyComboBoxItem Content="{loc:Loc Common.Installation.Forge}"
                                               Tag="1" />
                            <ui:MyComboBoxItem Content="{loc:Loc Common.Installation.NeoForge}"
                                               Tag="6" />
                            <ui:MyComboBoxItem Content="{loc:Loc Common.Installation.Fabric}"
                                               Tag="4" />
                            <ui:MyComboBoxItem Content="{loc:Loc Common.Installation.Quilt}"
                                               Tag="5" />
                        </ui:MyComboBox>
                        <ui:MyComboBox x:Name="ComboSearchShaderLoader"
                                       Grid.Row="2"
                                       Grid.Column="3"
                                       IsVisible="False"
                                       MaxDropDownHeight="320">
                            <ui:MyComboBoxItem Content="{loc:Loc Download.Comp.Filter.Loader.AnyShader}"
                                               Tag="" />
                            <ui:MyComboBoxItem Content="{loc:Loc Download.Comp.Filter.Loader.VanillaAvailable}"
                                               Tag="/vanilla" />
                            <ui:MyComboBoxItem Content="{loc:Loc Common.Installation.Iris}"
                                               Tag="/iris" />
                            <ui:MyComboBoxItem Content="{loc:Loc Common.Installation.OptiFine}"
                                               Tag="/optifine" />
                        </ui:MyComboBox>
                    </Grid>
                </ui:MyCard>
            </StackPanel>
            <StackPanel x:Name="PanContent"
                        IsVisible="False">
                <ui:MyHint x:Name="HintError"
                           Margin="0,0,0,15"
                           Theme="Yellow"
                           IsVisible="False" />
                <ui:MyCard>
                    <StackPanel x:Name="PanProjects"
                                Margin="12" />
                </ui:MyCard>
                <ui:MyCard x:Name="CardPages"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Margin="10,7"
                                Spacing="5">
                        <ui:MyIconButton x:Name="BtnPageFirst"
                                         Height="25"
                                         Width="25"
                                         SvgIcon="lucide/chevrons-left" />
                        <ui:MyIconButton x:Name="BtnPageLeft"
                                         Height="25"
                                         Width="25"
                                         SvgIcon="lucide/chevron-left" />
                        <TextBlock x:Name="LabPage"
                                   Margin="8,0,13,0"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Text="1"
                                   Foreground="{DynamicResource ColorBrush3}" />
                        <ui:MyIconButton x:Name="BtnPageRight"
                                         Height="25"
                                         Width="25"
                                         Margin="0,0,25,0"
                                         SvgIcon="lucide/chevron-right" />
                    </StackPanel>
                </ui:MyCard>
            </StackPanel>
            <ui:MyCard x:Name="PanLoad"
                       Margin="40,50"
                       HorizontalAlignment="Center">
                <ui:MyLoading x:Name="Load"
                              Margin="20,20,20,17"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              AutoRun="False" />
            </ui:MyCard>
        </StackPanel>
    </ui:MyScrollViewer>
</UserControl>