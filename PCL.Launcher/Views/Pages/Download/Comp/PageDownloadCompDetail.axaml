<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                x:Class="PCL.Views.Pages.Download.PageDownloadCompDetail">
    <ui:MyScrollViewer x:Name="PanBack"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25,25,25,10">
            <ui:MyCard Margin="0,0,0,15">
                <Grid Margin="22,20,22,20"
                      ColumnDefinitions="60,*,Auto">
                    <ui:MyImage x:Name="ImgLogo"
                                Grid.Column="0"
                                Width="56"
                                Height="56"
                                VerticalAlignment="Top"
                                CornerRadius="8"
                                Stretch="Uniform" />
                    <StackPanel Grid.Column="1"
                                Margin="14,0,16,0"
                                Spacing="6">
                        <TextBlock x:Name="LabTitle"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="LabSubTitle"
                                   FontSize="13"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="LabDescription"
                                   FontSize="13"
                                   MaxHeight="120"
                                   TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal"
                                   Margin="0,4,0,0">
                            <ui:MyIconTextButton x:Name="BtnOpenWebsite"
                                                 Margin="0,0,3,0"
                                                 BorderBrush="{DynamicResource ColorBrush6}"
                                                 BorderThickness="1"
                                                 SvgIcon="lucide/globe"
                                                 Text="{loc:Loc Common.Action.Open}" />
                            <ui:MyIconTextButton x:Name="BtnIntroWiki"
                                                 Margin="0,0,3,0"
                                                 BorderBrush="{DynamicResource ColorBrush6}"
                                                 BorderThickness="1"
                                                 SvgIcon="lucide/globe"
                                                 IsVisible="False"
                                                 Text="{loc:Loc Download.Comp.Detail.McMod}" />
                            <ui:MyIconTextButton x:Name="BtnCopyName"
                                                 Margin="0,0,3,0"
                                                 BorderBrush="{DynamicResource ColorBrush6}"
                                                 BorderThickness="1"
                                                 SvgIcon="lucide/copy"
                                                 Text="{loc:Loc Download.Comp.Detail.CopyName}" />
                            <ui:MyIconTextButton x:Name="BtnCopyLink"
                                                 Margin="0,0,3,0"
                                                 BorderBrush="{DynamicResource ColorBrush6}"
                                                 BorderThickness="1"
                                                 SvgIcon="lucide/copy"
                                                 Text="{loc:Loc Download.Comp.Detail.CopyLink}" />
                            <ui:MyIconTextButton x:Name="BtnTranslate"
                                                 Margin="0,0,3,0"
                                                 BorderBrush="{DynamicResource ColorBrush6}"
                                                 BorderThickness="1"
                                                 SvgIcon="lucide/earth"
                                                 IsVisible="False"
                                                 Text="{loc:Loc Download.Comp.Detail.TranslateDescription}" />
                            <ui:MyIconTextButton x:Name="BtnFavorites"
                                                 Margin="0,0,2,0"
                                                 BorderBrush="{DynamicResource ColorBrush6}"
                                                 BorderThickness="1"
                                                 SvgIcon="lucide/heart"
                                                 Text="{loc:Loc Download.Comp.Detail.Favorite}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Spacing="6"
                                VerticalAlignment="Top">
                        <TextBlock x:Name="LabDownloadCount"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Opacity="0.6" />
                        <TextBlock x:Name="LabSource"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Opacity="0.6" />
                    </StackPanel>
                </Grid>
            </ui:MyCard>

            <ui:MyCard x:Name="CardFilter"
                       Margin="0,0,0,15"
                       IsVisible="False">
                <StackPanel Margin="10,10,10,6"
                            Spacing="6">
                    <WrapPanel x:Name="PanInstanceFilter" />
                    <WrapPanel x:Name="PanModLoaderFilter"
                               IsVisible="False" />
                </StackPanel>
            </ui:MyCard>

            <StackPanel x:Name="PanResults" />

            <ui:MyCard x:Name="PanLoad"
                       Margin="40,50"
                       HorizontalAlignment="Center">
                <ui:MyLoading x:Name="Load"
                              Margin="20,20,20,17"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              AutoRun="False"
                              Text="{loc:Loc Download.Version.LoadingList}" />
            </ui:MyCard>
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageRight>