<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                x:Class="PCL.Views.Pages.Download.PageDownloadInstall">
    <Grid>
        <ui:MyScrollViewer x:Name="PanBack"
                           HorizontalScrollBarVisibility="Disabled"
                           VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5">
                <Grid x:Name="PanContent"
                      Margin="25,20,25,25">
                    <StackPanel x:Name="PanSelectStage">
                        <StackPanel x:Name="PanVersions"
                                    Margin="0,15,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="PanConfigStage"
                                Margin="0,0,0,45"
                                IsVisible="False">
                        <ui:MyCard x:Name="CardVersion"
                                   Height="62"
                                   Margin="0,15,0,3"
                                   UseAnimation="False">
                            <Grid>
                                <ui:MyIconButton x:Name="BtnReselect"
                                                 Width="26"
                                                 Height="26"
                                                 Margin="13,0,0,0"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 LogoScale="0.87"
                                                 Opacity="0.6"
                                                 SvgIcon="lucide/arrow-left"
                                                 Theme="Black" />
                                <ui:MyImage x:Name="ImgLogo"
                                            Height="32"
                                            Margin="52,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform" />
                                <ui:MyTextBox x:Name="TextInstanceName"
                                              Margin="93,0,16,0"
                                              MinHeight="30"
                                              VerticalAlignment="Center"
                                              FontSize="15"
                                              MaxLength="70" />
                            </Grid>
                        </ui:MyCard>

                        <ui:MyHint x:Name="HintLoaderWarning"
                                   Margin="0,10,0,0"
                                   Theme="Red"
                                   IsVisible="False" />

                        <StackPanel x:Name="PanLoaderCards" />

                        <ui:MyHint x:Name="HintNoFolder"
                                   Margin="0,12,0,0"
                                   Theme="Red"
                                   IsVisible="False"
                                   Text="{loc:Loc Download.Install.NoFolder}" />

                        <ui:MyCard x:Name="CardProgress"
                                   Margin="0,0,0,12"
                                   IsVisible="False"
                                   UseAnimation="False">
                            <StackPanel Margin="20,20,20,18"
                                        Spacing="12">
                                <ui:MyLoading x:Name="LoadInstall"
                                              HorizontalAlignment="Center"
                                              AutoRun="False"
                                              ShowProgress="True" />
                                <ui:MyButton x:Name="BtnCancel"
                                             MinWidth="120"
                                             Padding="13,0"
                                             HorizontalAlignment="Center"
                                             Text="{loc:Loc Common.Action.Cancel}" />
                            </StackPanel>
                        </ui:MyCard>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ui:MyScrollViewer>

        <ui:MyExtraTextButton x:Name="BtnStart"
                              Margin="0,0,0,25"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Text="{loc:Loc Download.Install.StartDownload}" />

        <ui:MyCard x:Name="PanLoad"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="40,0"
                   IsVisible="False"
                   UseAnimation="False">
            <ui:MyLoading x:Name="LoadMinecraft"
                          Margin="20,20,20,17"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Text="{loc:Loc Download.Version.LoadingList}" />
        </ui:MyCard>
    </Grid>
</ui:MyPageRight>