<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                xmlns:download="using:PCL.Views.Pages.Download"
                x:Class="PCL.Views.Pages.Download.PageDownloadInstall"
                x:CompileBindings="False">
    <Grid>
        <ui:MyScrollViewer x:Name="PanBack"
                           HorizontalScrollBarVisibility="Disabled"
                           VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5">
                <Grid x:Name="PanContent"
                      Margin="25,20,25,25">
                    <StackPanel x:Name="PanSelectStage">
                        <StackPanel x:Name="PanVersions"
                                    Margin="0,15,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="PanConfigStage"
                                Margin="0,0,0,45"
                                IsVisible="{Binding IsConfigStageVisible}">
                        <ui:MyCard x:Name="CardVersion"
                                   Height="62"
                                   Margin="0,15,0,3"
                                   UseAnimation="False">
                            <Grid>
                                <ui:MyIconButton x:Name="BtnReselect"
                                                 Width="26"
                                                 Height="26"
                                                 Margin="13,0,0,0"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 LogoScale="0.87"
                                                 Opacity="0.6"
                                                 SvgIcon="lucide/arrow-left"
                                                 Theme="Black" />
                                <ui:MyImage x:Name="ImgLogo"
                                            Height="32"
                                            Margin="52,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform" />
                                <ui:MyTextBox x:Name="TextInstanceName"
                                              Margin="93,0,16,0"
                                              Padding="-1,0"
                                              MinHeight="30"
                                              VerticalAlignment="Center"
                                              FontSize="15"
                                              MaxLength="70"
                                              HasBackground="False"
                                              Text="{Binding InstanceName, Mode=TwoWay}" />
                            </Grid>
                        </ui:MyCard>

                        <ui:MyHint x:Name="HintFabricApi"
                                   Margin="0,10,0,0"
                                   Theme="Red"
                                   Text="{loc:Loc Download.Install.Warning.FabricApi}"
                                   IsVisible="{Binding ShowHintFabricApi}" />

                        <ui:MyHint x:Name="HintLegacyFabricApi"
                                   Margin="0,10,0,0"
                                   Theme="Red"
                                   Text="{loc:Loc Download.Install.Warning.LegacyFabricApi}"
                                   IsVisible="{Binding ShowHintLegacyFabricApi}" />

                        <ui:MyHint x:Name="HintOptiFabric"
                                   Margin="0,10,0,0"
                                   Theme="Red"
                                   Text="{loc:Loc Download.Install.Warning.OptiFabric}"
                                   IsVisible="{Binding ShowHintOptiFabric}" />

                        <ui:MyHint x:Name="HintOptiFabricOld"
                                   Margin="0,10,0,0"
                                   Theme="Yellow"
                                   Text="{loc:Loc Download.Install.Warning.OptiFabricOld}"
                                   IsVisible="{Binding ShowHintOptiFabricOld}" />

                        <ui:MyHint x:Name="HintLegacyOptiFabric"
                                   Margin="0,10,0,0"
                                   Theme="Yellow"
                                   Text="{loc:Loc Download.Install.Warning.LegacyOptiFabric}"
                                   IsVisible="{Binding ShowHintLegacyOptiFabric}" />

                        <ui:MyHint x:Name="HintModOptiFine"
                                   Margin="0,10,0,0"
                                   Theme="Yellow"
                                   Text="{loc:Loc Download.Install.Warning.ModOptiFine}"
                                   IsVisible="{Binding ShowHintModOptiFine}" />

                        <StackPanel x:Name="PanLoaderCards">
                            <download:InstallLoaderCard Title="{loc:Loc Common.Installation.Forge}" />
                            <download:InstallLoaderCard Title="{loc:Loc Common.Installation.Cleanroom}" />
                            <download:InstallLoaderCard Title="{loc:Loc Common.Installation.NeoForge}" />
                            <download:InstallLoaderCard Title="{loc:Loc Common.Installation.Fabric}" />
                            <download:InstallLoaderCard Title="{loc:Loc Common.Installation.LegacyFabric}" />
                            <download:InstallLoaderCard Title="{loc:Loc Common.Installation.FabricApi}" />
                            <download:InstallLoaderCard Title="{loc:Loc Common.Installation.LegacyFabricApi}" />
                            <download:InstallLoaderCard Title="{loc:Loc Common.Installation.LabyMod}" />
                            <download:InstallLoaderCard Title="{loc:Loc Common.Installation.OptiFine}" />
                            <download:InstallLoaderCard Title="{loc:Loc Common.Installation.OptiFabric}" />
                            <download:InstallLoaderCard Title="{loc:Loc Common.Installation.LiteLoader}" />
                        </StackPanel>

                        <ui:MyHint x:Name="HintNoFolder"
                                   Margin="0,12,0,0"
                                   Theme="Red"
                                   IsVisible="{Binding HasNoFolder}"
                                   Text="{loc:Loc Download.Install.NoFolder}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ui:MyScrollViewer>

        <ui:MyExtraTextButton x:Name="BtnStart"
                              Margin="0,0,0,25"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              IsEnabled="{Binding CanStartInstall}"
                              SvgIcon="lucide/download"
                              Text="{Binding StartButtonText}" />

        <ui:MyCard x:Name="PanLoad"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="40,0"
                   IsVisible="False"
                   UseAnimation="False">
            <ui:MyLoading x:Name="LoadMinecraft"
                          Margin="20,20,20,17"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Text="{loc:Loc Download.Version.LoadingList}" />
        </ui:MyCard>
    </Grid>
</ui:MyPageRight>