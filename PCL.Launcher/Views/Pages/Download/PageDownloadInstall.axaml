<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                xmlns:svg="using:PCL.UI.Controls.SvgIcon"
                x:Class="PCL.Views.Pages.Download.PageDownloadInstall">
    <Grid>
        <ui:MyScrollViewer x:Name="PanBack"
                           HorizontalScrollBarVisibility="Disabled"
                           VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5">
                <Grid x:Name="PanContent"
                      Margin="25,20,25,25">
                    <StackPanel x:Name="PanSelectStage">
                        <StackPanel x:Name="PanVersions" />
                    </StackPanel>

                    <StackPanel x:Name="PanConfigStage"
                                Margin="0,0,0,45"
                                IsVisible="False">
                        <ui:MyCard x:Name="CardVersion"
                                   Height="62"
                                   Margin="0,0,0,12"
                                   UseAnimation="False">
                            <Grid>
                                <ui:MyIconButton x:Name="BtnReselect"
                                                 Width="26"
                                                 Height="26"
                                                 Margin="13,0,0,0"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 LogoScale="0.87"
                                                 Opacity="0.6"
                                                 SvgIcon="lucide/arrow-left"
                                                 Theme="Black" />
                                <svg:SvgIcon x:Name="IconVersion"
                                             Width="32"
                                             Height="32"
                                             Margin="52,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Icon="lucide/box" />
                                <StackPanel Margin="93,0,16,0"
                                            VerticalAlignment="Center"
                                            Spacing="1">
                                    <TextBlock x:Name="LabVersionName"
                                               FontSize="15"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="LabVersionInfo"
                                               FontSize="12"
                                               Opacity="0.7"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </ui:MyCard>

                        <ui:MyHint x:Name="HintLoaderWarning"
                                   Margin="0,0,0,12"
                                   Theme="Red"
                                   IsVisible="False" />

                        <ui:MyCard x:Name="CardLoader"
                                   Margin="0,0,0,12"
                                   Title="{loc:Loc Download.Install.Section.Loader}">
                            <StackPanel Margin="20,40,20,18"
                                        Spacing="10">
                                <StackPanel x:Name="PanLoaderCards"
                                            Spacing="10" />
                            </StackPanel>
                        </ui:MyCard>

                        <ui:MyCard x:Name="CardInstance"
                                   Margin="0,0,0,12"
                                   Title="{loc:Loc Download.Install.Section.Instance}">
                            <StackPanel Margin="20,40,20,18"
                                        Spacing="10">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Margin="0,0,18,0"
                                               VerticalAlignment="Center"
                                               Text="{loc:Loc Download.Install.InstanceName}" />
                                    <ui:MyTextBox x:Name="TextInstanceName"
                                                  Grid.Column="1"
                                                  MaxLength="70" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Margin="0,0,18,0"
                                               VerticalAlignment="Center"
                                               Text="{loc:Loc Download.Install.InstanceLocation}" />
                                    <TextBlock x:Name="LabLocation"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Opacity="0.7"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <ui:MyHint x:Name="HintNoFolder"
                                           Theme="Red"
                                           IsVisible="False"
                                           Text="{loc:Loc Download.Install.NoFolder}" />
                            </StackPanel>
                        </ui:MyCard>

                        <ui:MyCard x:Name="CardProgress"
                                   Margin="0,0,0,12"
                                   IsVisible="False"
                                   UseAnimation="False">
                            <StackPanel Margin="20,20,20,18"
                                        Spacing="12">
                                <ui:MyLoading x:Name="LoadInstall"
                                              HorizontalAlignment="Center"
                                              AutoRun="False"
                                              ShowProgress="True" />
                                <ui:MyButton x:Name="BtnCancel"
                                             MinWidth="120"
                                             Padding="13,0"
                                             HorizontalAlignment="Center"
                                             Text="{loc:Loc Common.Action.Cancel}" />
                            </StackPanel>
                        </ui:MyCard>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ui:MyScrollViewer>

        <ui:MyExtraTextButton x:Name="BtnStart"
                              Margin="0,0,45,25"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Text="{loc:Loc Download.Install.StartDownload}" />

        <ui:MyCard x:Name="PanLoad"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="40,0"
                   IsVisible="False"
                   UseAnimation="False">
            <ui:MyLoading x:Name="LoadMinecraft"
                          Margin="20,20,20,17"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </ui:MyCard>
    </Grid>
</ui:MyPageRight>