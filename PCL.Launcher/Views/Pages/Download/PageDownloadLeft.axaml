<ui:MyPageLeft xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:PCL.UI.Controls"
               xmlns:loc="using:PCL.Core.UI"
               x:Class="PCL.Views.Pages.Download.PageDownloadLeft">
    <ui:MyScrollViewer Classes="FullMargin"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PanItem"
                    Margin="0,12,0,0">
            <ui:MyListItem x:Name="ItemInstall"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="1"
                           MinPaddingRight="35"
                           SvgIcon="lucide/boxes"
                           Title="{loc:Loc Download.Left.Minecraft}"
                           Type="RadioBox" />

            <TextBlock x:Name="TextCommunityCategory"
                       Margin="13,10,5,4"
                       Opacity="0.6"
                       FontSize="12"
                       Text="{loc:Loc Download.Left.CommunityResources}" />

            <ui:MyListItem x:Name="ItemMod"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.97"
                           MinPaddingRight="35"
                           SvgIcon="lucide/puzzle"
                           Title="{loc:Loc Download.Left.Mod}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemPack"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.98"
                           MinPaddingRight="35"
                           SvgIcon="lucide/package"
                           Title="{loc:Loc Download.Left.Modpack}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemDataPack"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.96"
                           MinPaddingRight="35"
                           SvgIcon="lucide/file-archive"
                           Title="{loc:Loc Download.Left.DataPack}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemResourcePack"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.81"
                           MinPaddingRight="35"
                           SvgIcon="lucide/layers"
                           Title="{loc:Loc Download.Left.ResourcePack}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemShader"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="1.04"
                           MinPaddingRight="35"
                           SvgIcon="lucide/sparkles"
                           Title="{loc:Loc Download.Left.Shader}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemWorld"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.85"
                           MinPaddingRight="35"
                           SvgIcon="lucide/globe"
                           Title="{loc:Loc Download.Left.World}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemFavorites"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           MinPaddingRight="35"
                           SvgIcon="lucide/heart"
                           Title="{loc:Loc Download.Left.Favorites}"
                           Type="RadioBox" />

            <TextBlock x:Name="TextInstallCategory"
                       Margin="13,10,5,4"
                       Opacity="0.6"
                       FontSize="12"
                       Text="{loc:Loc Download.Left.Installation}" />

            <ui:MyListItem x:Name="ItemClient"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.98"
                           MinPaddingRight="35"
                           SvgIcon="lucide/package"
                           Title="{loc:Loc Download.Left.Minecraft}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemOptiFine"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="1.00"
                           MinPaddingRight="35"
                           SvgIcon="lucide/gauge"
                           Title="{loc:Loc Download.Left.Optifine}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemForge"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="1.00"
                           MinPaddingRight="35"
                           SvgIcon="lucide/anvil"
                           Title="{loc:Loc Download.Left.Forge}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemNeoForge"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.95"
                           MinPaddingRight="35"
                           SvgIcon="lucide/cat"
                           Title="{loc:Loc Download.Left.NeoForge}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemCleanroom"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.95"
                           MinPaddingRight="35"
                           SvgIcon="lucide/flask-conical"
                           Title="{loc:Loc Download.Left.Cleanroom}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemFabric"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="1.02"
                           MinPaddingRight="35"
                           SvgIcon="lucide/scroll"
                           Title="{loc:Loc Download.Left.Fabric}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemLegacyFabric"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="1.02"
                           MinPaddingRight="35"
                           SvgIcon="lucide/scroll"
                           Title="{loc:Loc Download.Left.LegacyFabric}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemLabyMod"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="1.02"
                           MinPaddingRight="35"
                           SvgIcon="lucide/box"
                           Title="{loc:Loc Download.Left.LabyMod}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemLiteLoader"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="1.06"
                           MinPaddingRight="35"
                           SvgIcon="lucide/egg"
                           Title="{loc:Loc Download.Left.LiteLoader}"
                           Type="RadioBox" />
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageLeft>