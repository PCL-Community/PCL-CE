<ui:MyPageLeft xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                x:Class="PCL.Views.Pages.Select.PageSelectLeft">
    <Grid RowDefinitions="*,5">
        <ui:MyScrollViewer Classes="FullMargin"
                        Grid.Row="0"
                           x:Name="PanScroll"
                           MaxWidth="300"
                           MinWidth="250"
                           HorizontalAlignment="Left"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanList"
                        Margin="0,12,0,0" />
        </ui:MyScrollViewer>
    </Grid>
</ui:MyPageLeft>
