<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:PCL.UI.Controls"
             xmlns:loc="using:PCL.Core.UI"
             mc:Ignorable="d"
             x:CompileBindings="False"
             x:Class="PCL.Views.Pages.Launch.PageLoginOffline"
             d:DesignWidth="317.6">
    <Grid Margin="0,0,0,-2"
          RowDefinitions="Auto,10,Auto,30,Auto,10,Auto,50,Auto,30"
          ColumnDefinitions="50,*">
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Text="{loc:Loc Launch.Account.Offline.PlayerId}" />
        <ui:MyTextBox x:Name="TextName"
                      Grid.Row="0"
                      Grid.Column="1"
                      Height="28"
                      Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip.Tip="{loc:Loc Launch.Account.Offline.PlayerId.ToolTip}" />

        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Margin="-45,0,0,0"
                   FontWeight="Bold"
                   Text="{loc:Loc Launch.Account.Offline.UuidStandard}"
                   TextAlignment="Center" />
        <Grid Grid.Row="3"
              Grid.Column="1"
              Margin="-40,0,0,0"
              HorizontalAlignment="Center"
              ColumnDefinitions="85,85,85">
            <ui:MyRadioBox x:Name="RadioUuidStandard"
                           Grid.Column="0"
                           Height="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{loc:Loc Launch.Account.Offline.Uuid.Standard}"
                           ToolTip.Tip="{loc:Loc Launch.Account.Offline.Uuid.Standard.ToolTip}" />
            <ui:MyRadioBox x:Name="RadioUuidLegacy"
                           Grid.Column="1"
                           Height="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{loc:Loc Launch.Account.Offline.Uuid.Legacy}"
                           ToolTip.Tip="{loc:Loc Launch.Account.Offline.Uuid.Legacy.ToolTip}" />
            <ui:MyRadioBox x:Name="RadioUuidCustom"
                           Grid.Column="2"
                           Height="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{loc:Loc Common.Option.Customize}"
                           ToolTip.Tip="{loc:Loc Launch.Account.Offline.Uuid.Custom.ToolTip}" />
        </Grid>

        <TextBlock x:Name="TextUuidTitle"
                   Grid.Row="6"
                   Grid.Column="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="False"
                   Text="UUID" />
        <ui:MyTextBox x:Name="TextUuid"
                      Grid.Row="6"
                      Grid.Column="1"
                      Height="28"
                      IsVisible="False"
                      Text="{Binding Uuid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip.Tip="{loc:Loc Launch.Account.Offline.Uuid.Custom.Input.ToolTip}" />

        <ui:MyButton x:Name="BtnBack"
                     Grid.Row="9"
                     Grid.Column="1"
                     Width="50"
                     Margin="-100,-40,0,40"
                     HorizontalAlignment="Center"
                     Text="{loc:Loc Launch.Account.Offline.Back}" />
        <ui:MyButton x:Name="BtnLogin"
                     Grid.Row="9"
                     Grid.Column="1"
                     Width="50"
                     Margin="20,-40,0,40"
                     HorizontalAlignment="Center"
                     ColorType="Highlight"
                     Text="{loc:Loc Launch.Account.Offline.Create}" />
    </Grid>
</UserControl>