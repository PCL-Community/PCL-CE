<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:PCL.UI.Controls"
             xmlns:svg="using:PCL.UI.Controls.SvgIcon"
             xmlns:loc="using:PCL.Core.UI"
             x:Class="PCL.Views.Pages.Launch.PageLoginAuth">
    <Grid Margin="0,0,0,-2"
          RowDefinitions="Auto,10,Auto,10,Auto,10,Auto,Auto,20,30"
          ColumnDefinitions="50,*">
        <Grid x:Name="PanOAuth"
              Grid.Row="0"
              Grid.RowSpan="8"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Margin="0,10,0,0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              IsVisible="False"
              RowDefinitions="Auto,25,Auto,Auto,Auto">
            <svg:SvgIcon Grid.Row="0"
                         Width="40"
                         Height="40"
                         HorizontalAlignment="Center"
                         Opacity="0.7"
                         Icon="lucide/user-round" />
            <ui:MyButton x:Name="BtnOAuth"
                         Grid.Row="2"
                         Width="120"
                         Height="28"
                         HorizontalAlignment="Center"
                         ColorType="Highlight"
                         Text="{loc:Loc Launch.Account.Auth.OAuthLogin}" />
            <StackPanel Grid.Row="4"
                        Margin="2,30,2,0"
                        HorizontalAlignment="Center"
                        Opacity="0.3"
                        Orientation="Horizontal"
                        Spacing="30">
                <ui:MyTextButton x:Name="BtnWebsite"
                                 Text="{loc:Loc Launch.Account.Microsoft.Website}" />
                <ui:MyTextButton x:Name="BtnUsePassword"
                                 Text="{loc:Loc Launch.Account.Auth.UsePassword}" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="TextNameTitle"
                   Grid.Row="4"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{loc:Loc Launch.Account.Auth.Email}" />
        <ui:MyTextBox x:Name="TextName"
                      Grid.Row="4"
                      Grid.Column="1"
                      Height="28" />
        <TextBlock x:Name="TextPassTitle"
                   Grid.Row="6"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{loc:Loc Launch.Account.Auth.Password}" />
        <ui:MyPasswordBox x:Name="TextPass"
                         Grid.Row="6"
                         Grid.Column="1"
                         Height="28" />
        <ui:MyTextButton x:Name="BtnLink"
                         Grid.Row="7"
                         Grid.Column="1"
                         Margin="0,12,2,0"
                         HorizontalAlignment="Right"
                         IsVisible="False"
                         Text="{loc:Loc Launch.Account.Auth.Register}" />
        <StackPanel x:Name="PanPasswordLinks"
                    Grid.Row="7"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="2,20,2,0"
                    HorizontalAlignment="Center"
                    Opacity="0.3"
                    Orientation="Horizontal"
                    Spacing="30">
            <ui:MyTextButton x:Name="BtnPasswordWebsite"
                             Text="{loc:Loc Launch.Account.Microsoft.Website}" />
            <ui:MyTextButton x:Name="BtnUseOAuth"
                             IsVisible="False"
                             Text="{loc:Loc Launch.Account.Auth.UseOAuth}" />
        </StackPanel>

        <ui:MyButton x:Name="BtnBack"
                     Grid.Row="9"
                     Grid.Column="1"
                     Width="50"
                     Margin="-100,0,0,0"
                     HorizontalAlignment="Center"
                     Text="{loc:Loc Launch.Account.Auth.Back}" />
        <ui:MyTextButton x:Name="BtnBackOAuth"
                         Grid.Row="9"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         HorizontalAlignment="Center"
                         IsVisible="False"
                         Opacity="0.3"
                         Text="{loc:Loc Launch.Account.Back}" />
        <ui:MyButton x:Name="BtnLogin"
                     Grid.Row="9"
                     Grid.Column="1"
                     Width="50"
                     Margin="20,0,0,0"
                     HorizontalAlignment="Center"
                     ColorType="Highlight"
                     Text="{loc:Loc Launch.Account.Auth.Login}" />
    </Grid>
</UserControl>