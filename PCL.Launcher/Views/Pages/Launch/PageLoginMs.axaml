<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:PCL.UI.Controls"
             xmlns:loc="using:PCL.Core.UI"
             x:Class="PCL.Views.Pages.Launch.PageLoginMs">
    <Grid Margin="0,10,0,0"
          ColumnDefinitions="*,Auto"
          RowDefinitions="Auto,25,Auto,Auto,Auto">
        <Path Grid.Row="0"
              Grid.ColumnSpan="2"
              Width="40"
              Margin="4,0,0,0"
              HorizontalAlignment="Center"
              Data="M660.338 528.065c63.61-46.825 105.131-121.964 105.131-206.83 0-141.7-115.29-256.987-256.997-256.987-141.706 0-256.998 115.288-256.998 256.987 0 85.901 42.52 161.887 107.456 208.562-152.1 59.92-260.185 207.961-260.185 381.077 0 21.276 17.253 38.53 38.53 38.53 21.278 0 38.53-17.254 38.53-38.53 0-183.426 149.232-332.671 332.667-332.671 1.589 0 3.113-.207 4.694-.244.8.056 1.553.244 2.362.244 183.434 0 332.664 149.245 332.664 332.671 0 21.276 17.255 38.53 38.533 38.53 21.277 0 38.53-17.254 38.53-38.53 0-174.885-110.354-324.13-264.917-382.809z m-331.803-206.83c0-99.22 80.72-179.927 179.935-179.927s179.937 80.708 179.937 179.927c0 99.203-80.721 179.91-179.937 179.91s-179.935-80.708-179.935-179.91z"
              Fill="{DynamicResource ColorBrush2}"
              Opacity="0.7"
              Stretch="Uniform" />
        <ui:MyButton x:Name="BtnLogin"
                     Grid.Row="2"
                     Grid.Column="0"
                     Width="100"
                     Height="28"
                     ColorType="Highlight" />
        <Grid Grid.Row="4"
              Grid.ColumnSpan="2"
              Margin="2,30,2,0"
              HorizontalAlignment="Center"
              Opacity="0.3"
              ColumnDefinitions="Auto,30,Auto">
            <ui:MyTextButton x:Name="BtnPurchase"
                             Grid.Column="0"
                             Text="{loc:Loc Launch.Account.Microsoft.Purchase}" />
            <ui:MyTextButton x:Name="BtnWebsite"
                             Grid.Column="2"
                             Text="{loc:Loc Launch.Account.Microsoft.Website}" />
        </Grid>
        <ui:MyTextButton x:Name="BtnBack"
                         Grid.Row="4"
                         Grid.ColumnSpan="2"
                         Margin="0,60,0,0"
                         HorizontalAlignment="Center"
                         Opacity="0.3"
                         Text="{loc:Loc Launch.Account.Back}" />
    </Grid>
</UserControl>