<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                x:CompileBindings="False"
                x:Class="PCL.Views.Pages.Tools.PageToolsTest">
    <ui:MyScrollViewer x:Name="PanBack"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25,10">
            <ui:MyCard Margin="0,15"
                       Title="{loc:Loc Tools.Test.Title}">
                <WrapPanel Margin="25,40,21,5"
                           ItemHeight="50">
                    <ui:MyButton x:Name="BtnClean"
                                 MinWidth="120"
                                 Margin="0,0,15,15"
                                 Command="{Binding CleanCommand}"
                                 IsEnabled="{Binding CleanEnabled}"
                                 Text="{loc:Loc Tools.Test.Clean.Title}"
                                 ToolTip.Tip="{loc:Loc Tools.Test.Clean.ToolTip}" />
                    <ui:MyButton x:Name="BtnLuck"
                                 MinWidth="100"
                                 Margin="0,0,15,15"
                                 Command="{Binding ShowDailyFortuneCommand}"
                                 Text="{loc:Loc Tools.Test.Luck.Title}" />
                    <ui:MyButton x:Name="BtnCrash"
                                 MinWidth="100"
                                 Margin="0,0,15,15"
                                 ColorType="Red"
                                 Command="{Binding CrashCommand}"
                                 IsVisible="{Binding CrashButtonVisible}"
                                 Text="{loc:Loc Tools.Test.Crash.Title}"
                                 ToolTip.Tip="{loc:Loc Tools.Test.Crash.ManualCrash}" />
                    <ui:MyButton x:Name="BtnShortcut"
                                 MinWidth="120"
                                 Margin="0,0,15,15"
                                 Command="{Binding CreateShortcutCommand}"
                                 IsEnabled="{Binding ShortcutEnabled}"
                                 Text="{loc:Loc Tools.Test.Shortcut.Title}"
                                 ToolTip.Tip="{loc:Loc Tools.Test.Shortcut.ToolTip}" />
                    <ui:MyButton x:Name="BtnLaunchCount"
                                 MinWidth="120"
                                 Margin="0,0,15,15"
                                 Command="{Binding ShowLaunchCountCommand}"
                                 IsEnabled="{Binding LaunchCountEnabled}"
                                 Text="{loc:Loc Tools.Test.LaunchCount.Title}" />
                </WrapPanel>
            </ui:MyCard>

            <ui:MyCard Margin="0,0,0,15"
                       Title="{loc:Loc Tools.Test.CustomDownload.Title}">
                <StackPanel Margin="25,40,25,20"
                            Orientation="Vertical">
                    <TextBlock Text="{loc:Loc Tools.Test.CustomDownload.Description}"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,10,0,0"
                          ColumnDefinitions="Auto,*,Auto"
                          RowDefinitions="Auto,Auto,Auto,*"
                          ColumnSpacing="25">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Tools.Test.CustomDownload.Url}" />
                        <ui:MyTextBox x:Name="TextDownloadUrl"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      Text="{Binding DownloadUrl, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Tools.Test.CustomDownload.SaveTo}" />
                        <ui:MyTextBox x:Name="TextDownloadFolder"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Margin="0,10"
                                      Text="{Binding DownloadFolder, Mode=TwoWay}" />
                        <ui:MyTextButton x:Name="BtnDownloadSelectFolder"
                                         Grid.Row="2"
                                         Grid.Column="2"
                                         Margin="10,0,5,0"
                                         VerticalAlignment="Center"
                                         Command="{Binding SelectDownloadFolderCommand}"
                                         Text="{loc:Loc Tools.Test.CustomDownload.Select}" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Tools.Test.CustomDownload.FileName}" />
                        <ui:MyTextBox x:Name="TextDownloadName"
                                      Grid.Row="3"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      Text="{Binding DownloadName, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,15,0,0"
                          RowDefinitions="35"
                          ColumnDefinitions="*,*">
                        <ui:MyButton x:Name="BtnDownloadStart"
                                     Grid.Column="0"
                                     Width="140"
                                     Margin="0,0,15,0"
                                     HorizontalAlignment="Right"
                                     ColorType="Highlight"
                                     Command="{Binding StartDownloadCommand}"
                                     IsEnabled="{Binding DownloadStartEnabled}"
                                     Text="{loc:Loc Tools.Test.CustomDownload.Start}" />
                        <ui:MyButton x:Name="BtnDownloadOpen"
                                     Grid.Column="1"
                                     Width="140"
                                     Margin="0,0,15,0"
                                     HorizontalAlignment="Left"
                                     Command="{Binding OpenDownloadFolderCommand}"
                                     IsEnabled="{Binding DownloadOpenEnabled}"
                                     Text="{loc:Loc Common.Action.OpenFolder}" />
                    </Grid>
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard x:Name="CardSkin"
                       Margin="0,0,0,15"
                       Title="{loc:Loc Tools.Test.Skin.Title}">
                <StackPanel Margin="25,40,25,15">
                    <Grid Margin="0,14,0,2"
                          ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,0,25,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Tools.Test.Skin.PlayerName}" />
                        <ui:MyTextBox x:Name="TextSkinID"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      MaxLength="50"
                                      Text="{Binding SkinId, Mode=TwoWay}" />
                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Height="35"
                              Margin="0,14,0,0"
                              ColumnDefinitions="Auto,*">
                            <ui:MyButton x:Name="BtnSkinSave"
                                         Grid.Column="0"
                                         MinWidth="140"
                                         Padding="13,0"
                                         Margin="0,0,20,0"
                                         HorizontalAlignment="Left"
                                         Command="{Binding SavePlayerSkinCommand}"
                                         IsEnabled="{Binding SkinSaveEnabled}"
                                         Text="{loc:Loc Tools.Test.Skin.Save}" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard Margin="0,0,0,15"
                       Title="{loc:Loc Tools.Test.ServerQuery.Title}">
                <ui:MinecraftServerQuery Margin="15,40,15,15" />
            </ui:MyCard>

            <ui:MyCard x:Name="CardAchievement"
                       Margin="0,0,0,15"
                       CanSwap="True"
                       IsSwapped="True"
                       Title="{loc:Loc Tools.Test.Achievement.Title}">
                <StackPanel Margin="25,30,25,15">
                    <Grid Margin="0,4,0,2"
                          ColumnDefinitions="Auto,*,Auto"
                          RowDefinitions="Auto,Auto,Auto,Auto,*">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,0,25,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Tools.Test.Achievement.ItemId}" />
                        <ui:MyTextBox x:Name="TextAchievementItem"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      MaxLength="50"
                                      Margin="0,10"
                                      Text="{Binding AchievementItem, Mode=TwoWay}" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,0,25,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Tools.Test.Achievement.Name}" />
                        <ui:MyTextBox x:Name="TextAchievementTitle"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      MaxLength="50"
                                      Text="{Binding AchievementTitle, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="0,0,25,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Tools.Test.Achievement.Line1}" />
                        <ui:MyTextBox x:Name="TextAchievementLine1"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      MaxLength="50"
                                      Margin="0,10"
                                      Text="{Binding AchievementLine1, Mode=TwoWay}" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Margin="0,0,25,0"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc Tools.Test.Achievement.Line2}" />
                        <ui:MyTextBox x:Name="TextAchievementLine2"
                                      Grid.Row="3"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      MaxLength="50"
                                      Text="{Binding AchievementLine2, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,15,0,10"
                          RowDefinitions="35"
                          ColumnDefinitions="*,*">
                        <ui:MyButton x:Name="BtnAchievementPreview"
                                     Grid.Column="0"
                                     Width="140"
                                     Margin="0,0,15,0"
                                     HorizontalAlignment="Right"
                                     ColorType="Highlight"
                                     Command="{Binding PreviewAchievementCommand}"
                                     IsEnabled="{Binding AchievementButtonsEnabled}"
                                     Text="{loc:Loc Tools.Test.Achievement.Preview}" />
                        <ui:MyButton x:Name="BtnAchievementSave"
                                     Grid.Column="1"
                                     Width="140"
                                     Margin="0,0,15,0"
                                     HorizontalAlignment="Left"
                                     Command="{Binding SaveAchievementCommand}"
                                     IsEnabled="{Binding AchievementButtonsEnabled}"
                                     Text="{loc:Loc Tools.Test.Achievement.Save}" />
                    </Grid>
                    <ui:MyImage x:Name="ImgAchievement"
                                Width="320"
                                Height="64"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding AchievementImageVisible}"
                                Source="{Binding AchievementImagePath}"
                                Stretch="Uniform" />
                </StackPanel>
            </ui:MyCard>

            <ui:MyCard x:Name="CardAvatar"
                       Margin="0,0,0,15"
                       CanSwap="True"
                       IsSwapped="True"
                       Title="{loc:Loc Tools.Test.Avatar.Title}">
                <StackPanel Margin="25,40,25,20"
                            Orientation="Vertical">
                    <Grid Margin="0,0,0,10"
                          ColumnDefinitions="Auto,*">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Text="{loc:Loc Tools.Test.Avatar.Size}" />
                        <ui:MyComboBox x:Name="CmbHeadSize"
                                       Grid.Column="1"
                                       Height="26"
                                       SelectedIndex="{Binding HeadSizeIndex, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto,*">
                        <ui:MyButton x:Name="BtnSelectSkin"
                                     Grid.Column="1"
                                     Width="140"
                                     Height="35"
                                     Margin="0,0,10,0"
                                     Command="{Binding SelectSkinFileCommand}"
                                     Text="{loc:Loc Tools.Test.Avatar.SelectSkin}" />
                        <ui:MyButton x:Name="BtnSaveHead"
                                     Grid.Column="2"
                                     Width="140"
                                     Height="35"
                                     Command="{Binding SaveHeadCommand}"
                                     Text="{loc:Loc Tools.Test.Avatar.Save}" />
                    </Grid>
                    <Border x:Name="BorderSkinPreview"
                            Margin="0,15,0,0"
                            Padding="10"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding SkinPreviewVisible}">
                        <Image x:Name="ImgHead"
                               Width="80"
                               Height="80"
                               Source="{Binding GeneratedHead}"
                               Stretch="Uniform" />
                    </Border>
                </StackPanel>
            </ui:MyCard>
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageRight>