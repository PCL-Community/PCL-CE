<ui:MyPageLeft xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:PCL.UI.Controls"
               xmlns:loc="using:PCL.Core.UI"
               x:CompileBindings="False"
               x:Class="PCL.Views.Pages.Speed.PageSpeedLeft"
               Width="200"
               HorizontalAlignment="Left"
               RowDefinitions="1*,Auto,Auto,Auto,0.6*,Auto,Auto,Auto,0.6*,Auto,Auto,Auto,0.6*,Auto,Auto,Auto,1*">
    <TextBlock Grid.Row="1"
               HorizontalAlignment="Center"
               FontSize="14"
               Foreground="{DynamicResource ColorBrush3}"
               Text="{loc:Loc Speed.Progress.Total}" />
    <Rectangle Grid.Row="2"
               Height="2"
               Margin="25,7">
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0%,50%"
                                 EndPoint="100%,50%">
                <GradientStop Offset="0"
                              Color="{DynamicResource ColorObjectBg1}" />
                <GradientStop Offset="0.02"
                              Color="{DynamicResource ColorObject3}" />
                <GradientStop Offset="0.98"
                              Color="{DynamicResource ColorObject3}" />
                <GradientStop Offset="1"
                              Color="{DynamicResource ColorObjectBg1}" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>
    <TextBlock Grid.Row="3"
               x:Name="LabProgress"
               HorizontalAlignment="Center"
               FontSize="20"
               Text="{Binding ProgressText}" />

    <TextBlock Grid.Row="5"
               HorizontalAlignment="Center"
               FontSize="14"
               Foreground="{DynamicResource ColorBrush3}"
               Text="{loc:Loc Speed.Progress.Speed}" />
    <Rectangle Grid.Row="6"
               Height="2"
               Margin="25,7">
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0%,50%"
                                 EndPoint="100%,50%">
                <GradientStop Offset="0"
                              Color="{DynamicResource ColorObjectBg1}" />
                <GradientStop Offset="0.02"
                              Color="{DynamicResource ColorObject3}" />
                <GradientStop Offset="0.98"
                              Color="{DynamicResource ColorObject3}" />
                <GradientStop Offset="1"
                              Color="{DynamicResource ColorObjectBg1}" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>
    <TextBlock Grid.Row="7"
               x:Name="LabSpeed"
               HorizontalAlignment="Center"
               FontSize="20"
               Text="{Binding SpeedText}" />

    <TextBlock Grid.Row="9"
               x:Name="LabFileTitle"
               HorizontalAlignment="Center"
               FontSize="14"
               Foreground="{DynamicResource ColorBrush3}"
               Text="{loc:Loc Speed.Progress.RemainingFiles}" />
    <Rectangle Grid.Row="10"
               Height="2"
               Margin="25,7">
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0%,50%"
                                 EndPoint="100%,50%">
                <GradientStop Offset="0"
                              Color="{DynamicResource ColorObjectBg1}" />
                <GradientStop Offset="0.02"
                              Color="{DynamicResource ColorObject3}" />
                <GradientStop Offset="0.98"
                              Color="{DynamicResource ColorObject3}" />
                <GradientStop Offset="1"
                              Color="{DynamicResource ColorObjectBg1}" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>
    <TextBlock Grid.Row="11"
               x:Name="LabFile"
               HorizontalAlignment="Center"
               FontSize="20"
               Text="{Binding FileText}" />

    <TextBlock Grid.Row="13"
               x:Name="LabThreadTitle"
               HorizontalAlignment="Center"
               FontSize="14"
               Foreground="{DynamicResource ColorBrush3}"
               Text="{loc:Loc Speed.Progress.RemainingThreads}" />
    <Rectangle x:Name="LineThread"
               Grid.Row="14"
               Height="2"
               Margin="25,7">
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0%,50%"
                                 EndPoint="100%,50%">
                <GradientStop Offset="0"
                              Color="{DynamicResource ColorObjectBg1}" />
                <GradientStop Offset="0.02"
                              Color="{DynamicResource ColorObject3}" />
                <GradientStop Offset="0.98"
                              Color="{DynamicResource ColorObject3}" />
                <GradientStop Offset="1"
                              Color="{DynamicResource ColorObjectBg1}" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>
    <TextBlock Grid.Row="15"
               x:Name="LabThread"
               HorizontalAlignment="Center"
               FontSize="20"
               Text="{Binding ThreadText}" />
</ui:MyPageLeft>