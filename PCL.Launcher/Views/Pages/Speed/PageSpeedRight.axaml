<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                x:Class="PCL.Views.Pages.Speed.PageSpeedRight">
    <ui:MyScrollViewer x:Name="PanBack"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain"
                    Margin="25,25,25,10" />
    </ui:MyScrollViewer>
</ui:MyPageRight>