<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="using:PCL.UI.Controls"
      xmlns:svg="using:PCL.UI.Controls.SvgIcon"
      xmlns:loc="using:PCL.Core.UI"
      x:Class="PCL.Views.Pages.Instance.ServerCard"
      x:CompileBindings="False"
      Height="44"
      Background="Transparent"
      ClipToBounds="True"
      RenderTransformOrigin="0.5,0.5"
      RowDefinitions="*,17,18,*">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="34" />
        <ColumnDefinition Width="7" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="60" />
        <ColumnDefinition Width="6" />
    </Grid.ColumnDefinitions>

    <Border x:Name="RectBack"
            Grid.RowSpan="99"
            Grid.ColumnSpan="99"
            Background="{DynamicResource ColorBrush7}"
            BorderBrush="{DynamicResource ColorBrush6}"
            BorderThickness="1"
            CornerRadius="3"
            IsHitTestVisible="False"
            Opacity="0" />

    <Border Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="34"
            Height="34"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            IsHitTestVisible="False">
        <Border.Clip>
            <RectangleGeometry Rect="0,0,34,34"
                               RadiusX="6"
                               RadiusY="6" />
        </Border.Clip>
        <Image x:Name="ServerIcon"
               Stretch="UniformToFill"
               ClipToBounds="True" />
    </Border>

    <TextBlock x:Name="ServerName"
               Grid.Row="1"
               Grid.Column="3"
               Margin="0,0,0,-2"
               HorizontalAlignment="Left"
               VerticalAlignment="Bottom"
               FontSize="14"
               Foreground="{DynamicResource ColorBrush1}"
               TextTrimming="CharacterEllipsis" />

    <Grid Grid.Row="2"
          Grid.Column="3"
          VerticalAlignment="Center"
          ColumnDefinitions="Auto,Auto,*">
        <svg:SvgIcon x:Name="Signal"
                     Grid.Column="0"
                     Width="18"
                     Height="18"
                     VerticalAlignment="Center"
                     IconBrush="{DynamicResource ColorBrushGray4}" />
        <TextBlock x:Name="ServerPlayer"
                   Grid.Column="1"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource ColorBrushGray3}"
                   IsVisible="False"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="ServerAddress"
                   Grid.Column="2"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource ColorBrushGray4}"
                   Opacity="0.65"
                   TextTrimming="CharacterEllipsis" />
    </Grid>

    <TextBlock x:Name="ServerMotD"
               Grid.Row="1"
               Grid.RowSpan="2"
               Grid.Column="5"
               Margin="0,0,10,1"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Center"
               FontSize="12"
               Foreground="{DynamicResource ColorBrushGray4}"
               IsHitTestVisible="False"
               ClipToBounds="True"
               MaxLines="2"
               TextTrimming="CharacterEllipsis"
               TextWrapping="Wrap" />

    <StackPanel x:Name="PanButtons"
                Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="7"
                Margin="0,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsHitTestVisible="True"
                Orientation="Horizontal">
        <ui:MyIconButton x:Name="BtnConnect"
                         Width="24"
                         Height="24"
                         Margin="0,0,4,0"
                         SvgIcon="lucide/play" />
        <ui:MyIconButton x:Name="BtnSetting"
                         Width="24"
                         Height="24"
                         LogoScale="1.2"
                         SvgIcon="lucide/settings">
            <ui:MyIconButton.ContextMenu>
                <ContextMenu>
                    <ui:MyMenuItem Click="MenuRefresh_Click"
                                   Header="{loc:Loc Common.Action.Refresh}"
                                   SvgIcon="lucide/refresh-cw" />
                    <ui:MyMenuItem Click="MenuCopy_Click"
                                   Header="{loc:Loc Instance.Server.Card.CopyAddress}"
                                   SvgIcon="lucide/copy" />
                    <ui:MyMenuItem Click="MenuEdit_Click"
                                   Header="{loc:Loc Instance.Server.Card.Edit}"
                                   SvgIcon="lucide/pencil" />
                    <Separator />
                    <ui:MyMenuItem Click="MenuRemove_Click"
                                   Header="{loc:Loc Instance.Server.Card.Remove}"
                                   SvgIcon="lucide/trash-2" />
                </ContextMenu>
            </ui:MyIconButton.ContextMenu>
        </ui:MyIconButton>
    </StackPanel>
</Grid>