<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                xmlns:local="using:PCL"
                x:Class="PCL.Views.Pages.Instance.PageInstanceModDisabled"
                x:DataType="local:PageInstanceModDisabledViewModel">
    <ui:MyCard x:Name="PanMain"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="40">
        <Grid Margin="20,17"
              RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,Auto,Auto,*">
            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="4"
                       Margin="0,0,0,9"
                       HorizontalAlignment="Center"
                       FontSize="19"
                       Foreground="{DynamicResource ColorBrush3}"
                       Text="{loc:Loc Instance.Resource.Mod.Disabled.Title}" />
            <Rectangle Grid.Row="1"
                       Grid.ColumnSpan="4"
                       Height="2"
                       HorizontalAlignment="Stretch"
                       Fill="{DynamicResource ColorBrush3}" />
            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="4"
                       Margin="10,15,10,5"
                       Text="{loc:Loc Instance.Resource.Mod.Disabled.Message}"
                       TextWrapping="Wrap" />
            <ui:MyButton x:Name="BtnDownload"
                         Grid.Row="3"
                         Grid.Column="1"
                         Height="35"
                         Margin="10,10,10,0"
                         Padding="13,0"
                         MinWidth="140"
                         HorizontalAlignment="Center"
                         ColorType="Highlight"
                         IsVisible="{Binding IsDownloadVisible}"
                         Text="{loc:Loc Instance.Resource.Mod.Disabled.GoDownload}" />
            <ui:MyButton x:Name="BtnVersion"
                         Grid.Row="3"
                         Grid.Column="2"
                         Height="35"
                         Margin="10,10,10,0"
                         Padding="13,0"
                         MinWidth="140"
                         HorizontalAlignment="Center"
                         Text="{loc:Loc Instance.Resource.Mod.Disabled.SelectInstance}" />
        </Grid>
    </ui:MyCard>
</ui:MyPageRight>