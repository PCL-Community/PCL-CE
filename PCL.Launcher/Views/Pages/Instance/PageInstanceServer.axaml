<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                x:Class="PCL.Views.Pages.Instance.PageInstanceServer"
                x:CompileBindings="False">
    <Grid>
        <ui:MyScrollViewer x:Name="PanBack"
                           HorizontalScrollBarVisibility="Hidden"
                           VerticalScrollBarVisibility="Auto">
            <Grid>
                <ui:MyCard x:Name="PanNoServer"
                           Margin="40"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding ShowContent, Converter={x:Static BoolConverters.Not}}">
                    <Grid Margin="20,17"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto,Auto,*">
                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="4"
                                   Margin="0,0,0,9"
                                   HorizontalAlignment="Center"
                                   FontSize="19"
                                   Foreground="{DynamicResource ColorBrush3}"
                                   Text="{loc:Loc Instance.Server.Empty.Title}" />
                        <Rectangle Grid.Row="1"
                                   Grid.ColumnSpan="4"
                                   Height="2"
                                   HorizontalAlignment="Stretch"
                                   Fill="{DynamicResource ColorBrush3}" />
                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="4"
                                   Margin="10,15,10,5"
                                   Text="{loc:Loc Instance.Server.Empty.Message}"
                                   TextWrapping="Wrap" />
                        <ui:MyButton x:Name="BtnRefreshEmpty"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Height="35"
                                     MinWidth="140"
                                     Margin="10,10,10,0"
                                     Padding="13,0"
                                     HorizontalAlignment="Center"
                                     ColorType="Highlight"
                                     Text="{loc:Loc Instance.Server.RefreshInfo}" />
                        <ui:MyButton x:Name="BtnAddServerEmpty"
                                     Grid.Row="3"
                                     Grid.Column="2"
                                     Height="35"
                                     MinWidth="140"
                                     Margin="10,10,10,0"
                                     Padding="13,0"
                                     HorizontalAlignment="Center"
                                     Text="{loc:Loc Instance.Server.AddServer}" />
                    </Grid>
                </ui:MyCard>

                <ui:MyCard x:Name="PanError"
                           Margin="40"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="False">
                    <StackPanel Margin="20,17"
                                HorizontalAlignment="Center">
                        <TextBlock Margin="0,0,0,9"
                                   HorizontalAlignment="Center"
                                   FontSize="19"
                                   Foreground="{DynamicResource ColorBrush3}"
                                   Text="{loc:Loc Instance.Server.ReadFileFailed}" />
                        <Rectangle Height="2"
                                   HorizontalAlignment="Stretch"
                                   Fill="{DynamicResource ColorBrush3}" />
                        <TextBlock Margin="10,12"
                                   Text="{Binding Error}"
                                   TextWrapping="Wrap" />
                        <ui:MyButton x:Name="BtnErrorRetry"
                                     Height="35"
                                     MinWidth="140"
                                     Margin="10,12,10,0"
                                     Padding="13,0"
                                     HorizontalAlignment="Center"
                                     ColorType="Highlight"
                                     Text="{loc:Loc Common.Action.Refresh}" />
                    </StackPanel>
                </ui:MyCard>

                <StackPanel x:Name="PanMain"
                            Margin="25,25,25,25"
                            Orientation="Vertical"
                            IsVisible="{Binding ShowContent}">
                    <ui:MyCard Margin="0,0,0,15">
                        <WrapPanel Margin="15,8,0,15">
                            <ui:MyButton x:Name="BtnRefreshAll"
                                         MinWidth="110"
                                         Margin="0,7,15,0"
                                         Padding="13,7"
                                         HorizontalAlignment="Left"
                                         ColorType="Highlight"
                                         Text="{loc:Loc Instance.Server.RefreshAll}" />
                            <ui:MyButton x:Name="BtnAddServer"
                                         MinWidth="110"
                                         Margin="0,7,15,0"
                                         Padding="13,7"
                                         HorizontalAlignment="Left"
                                         Text="{loc:Loc Instance.Server.AddServer}" />
                        </WrapPanel>
                    </ui:MyCard>

                    <ui:MyCard x:Name="PanServerList"
                               Margin="0,0,0,15"
                               Title="{loc:Loc Instance.Server.FoundServers}">
                        <StackPanel x:Name="PanServers"
                                    Margin="20,42,18,16"
                                    ClipToBounds="True" />
                    </ui:MyCard>
                </StackPanel>
            </Grid>
        </ui:MyScrollViewer>
    </Grid>
</ui:MyPageRight>