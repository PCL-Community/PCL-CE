<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.Views.Pages.PageDownloadClient">
    <Grid>
        <ScrollViewer x:Name="PanBack"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="5">
                <StackPanel x:Name="PanMain"
                            Margin="20,20,20,5"
                            Spacing="6" />
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="PanLoad"
                Classes="Card"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="40,0"
                Padding="20,20,20,17"
                IsVisible="False">
            <StackPanel Spacing="10"
                        HorizontalAlignment="Center">
                <ProgressBar x:Name="LoadBar"
                             Width="240"
                             Height="6"
                             IsIndeterminate="True" />
                <TextBlock x:Name="LoadText"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>