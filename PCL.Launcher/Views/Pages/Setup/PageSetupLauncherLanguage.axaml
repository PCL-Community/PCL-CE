<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:svg="using:PCL.UI.Controls.SvgIcon"
                xmlns:loc="using:PCL.Core.UI"
                x:Class="PCL.Views.Pages.Setup.PageSetupLauncherLanguage">
    <ui:MyScrollViewer x:Name="PanBack"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25,10">
            <ui:MyCard Margin="0,15"
                       Title="{loc:Loc Setup.Language.CardTitle}">
                <StackPanel Margin="25,40,25,15">
                    <Grid ColumnDefinitions="Auto,*,60"
                          RowDefinitions="28,9,28">
                        <TextBlock Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,25,0"
                                   Text="{loc:Loc Setup.Language.UiLanguage}" />
                        <ui:MyComboBox x:Name="ComboUiLanguage"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="2"
                                   VerticalAlignment="Center"
                                   Margin="0,0,25,0"
                                   Text="{loc:Loc Setup.Language.FormatCulture}" />
                        <ui:MyComboBox x:Name="ComboUiFormatCulture"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       HorizontalAlignment="Stretch" />
                    </Grid>

                    <ui:BlurBorder x:Name="BannerInternationalization"
                                   MinHeight="230"
                                   Margin="0,10,0,0"
                                   Padding="25"
                                   CornerRadius="5"
                                   ClipToBounds="True"
                                   Background="{DynamicResource ColorBrush7}">
                        <Grid>
                            <Canvas Width="205"
                                    Height="145"
                                    Margin="0,-43,-25,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False">
                                <svg:SvgIcon Width="215"
                                             Height="215"
                                             Canvas.Left="5"
                                             Canvas.Top="-56"
                                             Icon="lucide/earth"
                                             IconBrush="{DynamicResource ColorBrush5}"
                                             StrokeThickness="2.4"
                                             Opacity="0.62"
                                             Stretch="Uniform" />
                            </Canvas>
                            <StackPanel Grid.Column="0"
                                        Spacing="2">
                                <TextBlock FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Setup.Language.Banner.TitlePrefix}" />
                                <!-- 使用内置字体，避免依赖 Windows 专有字体（Bahnschrift）导致非 Windows 平台字形创建失败 -->
                                <TextBlock FontFamily="avares://PCL.Launcher/Assets/Fonts#PCL English"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           Text="PCL CE" />
                                <TextBlock FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Setup.Language.Banner.TitleSuffix}" />
                                <TextBlock Margin="0,18,0,0"
                                           FontSize="14"
                                           LineHeight="23"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Setup.Language.Banner.DescriptionLine1}" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="14"
                                           LineHeight="23"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Setup.Language.Banner.DescriptionLine2}" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="14"
                                           LineHeight="23"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Setup.Language.Banner.DescriptionLine3}" />
                            </StackPanel>
                        </Grid>
                    </ui:BlurBorder>

                    <StackPanel Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="7">
                        <ui:MyIconTextButton x:Name="BtnTranslateWebsite"
                                             ColorType="Highlight"
                                             SvgIcon="lucide/globe"
                                             Text="{loc:Loc Setup.Language.Banner.TranslateWebsite}" />
                        <ui:MyIconTextButton x:Name="BtnSubmitPullRequest"
                                             SvgIcon="lucide/git-pull-request-arrow"
                                             Text="{loc:Loc Setup.Language.Banner.SubmitPullRequest}" />
                    </StackPanel>
                </StackPanel>
            </ui:MyCard>
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageRight>