<ui:MyPageLeft xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:PCL.UI.Controls"
               xmlns:loc="using:PCL.Core.UI"
               x:Class="PCL.Views.Pages.Setup.PageSetupLeft">
    <ui:MyScrollViewer Classes="FullMargin"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PanItem"
                    Margin="0,12,0,0">
            <TextBlock x:Name="TextGameCategory"
                       Margin="13,5,5,3"
                       Opacity="0.6"
                       FontSize="12"
                       Text="{loc:Loc Setup.Left.Category.Game}" />

            <ui:MyListItem x:Name="ItemLaunch"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="1"
                           MinPaddingRight="35"
                           SvgIcon="lucide/rocket"
                           Title="{loc:Loc Setup.Left.Item.Launch}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemJava"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="1"
                           MinPaddingRight="35"
                           SvgIcon="lucide/coffee"
                           Title="{loc:Loc Setup.Left.Item.Java}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemGameManage"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.95"
                           MinPaddingRight="35"
                           SvgIcon="lucide/book-marked"
                           Title="{loc:Loc Setup.Left.Item.GameManage}"
                           Type="RadioBox" />

            <TextBlock x:Name="TextToolsCategory"
                       Margin="13,5,5,3"
                       Opacity="0.6"
                       FontSize="12"
                       Text="{loc:Loc Setup.Left.Category.Tools}" />

            <ui:MyListItem x:Name="ItemGameLink"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           MinPaddingRight="35"
                           SvgIcon="lucide/bubbles"
                           Title="{loc:Loc Setup.Left.Item.GameLink}"
                           Type="RadioBox" />

            <TextBlock x:Name="TextLauncherCategory"
                       Margin="13,5,5,3"
                       Opacity="0.6"
                       FontSize="12"
                       Text="{loc:Loc Setup.Left.Category.Launcher}" />

            <ui:MyListItem x:Name="ItemUI"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           MinPaddingRight="35"
                           SvgIcon="lucide/palette"
                           Title="{loc:Loc Setup.Left.Item.Ui}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemLauncherLanguage"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.95"
                           MinPaddingRight="35"
                           SvgIcon="lucide/earth"
                           Title="{loc:Loc Setup.Language.Title}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemLauncherMisc"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.95"
                           MinPaddingRight="35"
                           SvgIcon="lucide/monitor-cog"
                           Title="{loc:Loc Setup.Left.Item.Misc}"
                           Type="RadioBox" />

            <TextBlock x:Name="TextAboutCategory"
                       Margin="13,5,5,3"
                       Opacity="0.6"
                       FontSize="12"
                       Text="{loc:Loc Setup.Left.Category.About}" />

            <ui:MyListItem x:Name="ItemAbout"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           MinPaddingRight="35"
                           SvgIcon="lucide/info"
                           Title="{loc:Loc Setup.Left.Item.About}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemUpdate"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           MinPaddingRight="35"
                           SvgIcon="lucide/refresh-cw"
                           Title="{loc:Loc Setup.Left.Item.Update}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemFeedback"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.9"
                           MinPaddingRight="35"
                           SvgIcon="lucide/message-circle"
                           Title="{loc:Loc Setup.Left.Item.Feedback}"
                           Type="RadioBox" />
            <ui:MyListItem x:Name="ItemLog"
                           Height="36"
                           IsScaleAnimationEnabled="False"
                           LogoScale="0.9"
                           MinPaddingRight="35"
                           SvgIcon="lucide/scroll-text"
                           Title="{loc:Loc Setup.Left.Item.Log}"
                           Type="RadioBox" />
        </StackPanel>
    </ui:MyScrollViewer>
</ui:MyPageLeft>