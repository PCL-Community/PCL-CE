<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                x:Class="PCL.Views.Pages.Setup.PageSetupLog">
    <ui:MyScrollViewer x:Name="PanBack"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <DockPanel>
            <ui:MyCard DockPanel.Dock="Top"
                       Margin="25,25,25,5"
                       Title="{loc:Loc Setup.Log.Operations}">
                <WrapPanel Margin="25,40,20,20">
                    <ui:MyButton Height="35"
                                 x:Name="BtnExport"
                                 MinWidth="100"
                                 Margin="0,0,15,0"
                                 Padding="13,0"
                                 ColorType="Highlight"
                                 Text="{loc:Loc Setup.Log.Export}" />
                    <ui:MyButton Height="35"
                                 x:Name="BtnExportAll"
                                 MinWidth="120"
                                 Margin="0,0,15,0"
                                 Padding="13,0"
                                 Text="{loc:Loc Setup.Log.ExportAll}" />
                    <ui:MyButton Height="35"
                                 x:Name="BtnOpenDir"
                                 MinWidth="120"
                                 Margin="0,0,15,0"
                                 Padding="13,0"
                                 Text="{loc:Loc Setup.Log.OpenDirectory}" />
                    <ui:MyButton Height="35"
                                 x:Name="BtnClear"
                                 MinWidth="120"
                                 Padding="13,0"
                                 ColorType="Red"
                                 Text="{loc:Loc Setup.Log.ClearHistory}" />
                </WrapPanel>
            </ui:MyCard>
            <ui:MyCard Margin="25,10,25,25"
                       Title="{loc:Loc Setup.Log.AllLogs}">
                <StackPanel x:Name="PanList"
                            Margin="20,36,18,18" />
            </ui:MyCard>
        </DockPanel>
    </ui:MyScrollViewer>
</ui:MyPageRight>