<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:svg="using:PCL.UI.Controls.SvgIcon"
                xmlns:loc="using:PCL.Core.UI"
                x:Class="PCL.Views.Pages.Setup.PageSetupLog">
    <ui:MyScrollViewer x:Name="PanBack"
                       HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <DockPanel>
            <ui:MyCard x:Name="CardDeviceInfo"
                       DockPanel.Dock="Top"
                       Margin="25,25,25,5"
                       Title="{loc:Loc Setup.Log.Device.Title}"
                       CanSwap="True"
                       IsSwapped="True">
                <StackPanel Margin="25,40,23,20">
                    <Border MinHeight="150"
                            Padding="22"
                            CornerRadius="5"
                            ClipToBounds="True"
                            Background="{DynamicResource ColorBrush7}">
                        <Grid RowDefinitions="Auto,Auto">
                            <Canvas Grid.Row="0"
                                    Width="180"
                                    Height="130"
                                    Margin="0,-30,-22,0"
                                    Opacity="0.52"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False">
                                <svg:SvgIcon Width="180"
                                             Height="180"
                                             Canvas.Left="0"
                                             Canvas.Top="-35"
                                             Icon="lucide/monitor-cog"
                                             IconBrush="{DynamicResource ColorBrush5}"
                                             StrokeThickness="2.4"
                                             Stretch="Uniform" />
                            </Canvas>

                            <StackPanel Grid.Row="0"
                                        VerticalAlignment="Center"
                                        Margin="0,0,150,0">
                                <TextBlock FontSize="13"
                                           Opacity="0.7"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           Text="{loc:Loc Setup.Log.Device.Summary.Caption}" />
                                <TextBlock x:Name="LabDeviceOs"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Margin="0,6,0,0"
                                        Spacing="2">
                                <TextBlock x:Name="LabDeviceLine1"
                                           FontSize="14"
                                           LineHeight="22"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="LabDeviceLine2"
                                           FontSize="14"
                                           LineHeight="22"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="LabDeviceLine3"
                                           FontSize="14"
                                           LineHeight="22"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="LabDeviceLine4"
                                           FontSize="14"
                                           LineHeight="22"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <ui:MyIconTextButton x:Name="BtnExportDeviceInfo"
                                             Margin="0,0,7,0"
                                             ColorType="Highlight"
                                             SvgIcon="lucide/download"
                                             Text="{loc:Loc Setup.Log.Device.Export}" />
                        <ui:MyIconTextButton x:Name="BtnCopyDeviceInfo"
                                             SvgIcon="lucide/copy"
                                             Text="{loc:Loc Setup.Log.Device.Copy}" />
                    </StackPanel>

                    <StackPanel x:Name="PanDeviceSections"
                                Margin="0,16,0,0"
                                Spacing="12" />
                </StackPanel>
            </ui:MyCard>
            <ui:MyCard DockPanel.Dock="Top"
                       Margin="25,10,25,5"
                       Title="{loc:Loc Setup.Log.Operations}">
                <WrapPanel Margin="25,40,20,20"
                           ItemHeight="35">
                    <ui:MyButton x:Name="BtnExport"
                                 MinWidth="100"
                                 Margin="0,0,15,0"
                                 ColorType="Highlight"
                                 Text="{loc:Loc Setup.Log.Export}" />
                    <ui:MyButton x:Name="BtnExportAll"
                                 MinWidth="120"
                                 Margin="0,0,15,0"
                                 ColorType="Normal"
                                 Text="{loc:Loc Setup.Log.ExportAll}" />
                    <ui:MyButton x:Name="BtnOpenDir"
                                 MinWidth="120"
                                 Margin="0,0,15,0"
                                 ColorType="Normal"
                                 Text="{loc:Loc Setup.Log.OpenDirectory}" />
                    <ui:MyButton x:Name="BtnClear"
                                 MinWidth="120"
                                 ColorType="Red"
                                 Text="{loc:Loc Setup.Log.ClearHistory}" />
                </WrapPanel>
            </ui:MyCard>
            <ui:MyCard Margin="25,10,25,25"
                       Title="{loc:Loc Setup.Log.AllLogs}">
                <StackPanel x:Name="PanList"
                            Margin="20,36,18,18" />
            </ui:MyCard>
        </DockPanel>
    </ui:MyScrollViewer>
</ui:MyPageRight>