<Project Sdk="Microsoft.NET.Sdk">
    <!-- PCL 的界面层：跨平台 net10.0。 -->
    <PropertyGroup>
        <AssemblyTitle>PCL</AssemblyTitle>
        <AssemblyName>PCL.Launcher</AssemblyName>
        <Description>PCL 的界面层</Description>
        <Company>PCL Community</Company>
        <Product>PCL</Product>
        <RootNamespace>PCL</RootNamespace>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Configurations>Debug;CI;Release;Beta</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
        <PlatformTarget>$(Platform)</PlatformTarget>
        <NoWarn>$(NoWarn);CS9113</NoWarn>
        <Version>2.15.1</Version>
        <AssemblyVersion>2.15.1.0</AssemblyVersion>
        <FileVersion>2.15.1.0</FileVersion>
        <InformationalVersion>2.15.1</InformationalVersion>
        <ApplicationIcon>Assets/Images/icon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Wayland" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="JAJ.Packages.MiniAudioEx" Version="3.3.7" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources\metadata.json" Link="metadata.json">
            <LogicalName>PCL.metadata.json</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\*.*" Exclude="Resources\metadata.json">
            <LogicalName>PCL.Resources.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\hints\*.txt">
            <LogicalName>PCL.Resources.hints.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <Content Include="Assets\Images\icon.png" Link="Assets\Images\icon.png" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\PCL.Launcher.Core\LICENCE" Link="LICENCE.PCL.Launcher.Core" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <AvaloniaResource Include="Assets/IconPacks/**" />
        <AvaloniaResource Include="Assets/Images/**" />
        <AvaloniaResource Include="Assets/Fonts/**" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PCL.Core.UI\PCL.Core.UI.csproj" />
        <ProjectReference Include="..\PCL.Launcher.Core\PCL.Launcher.Core.csproj" />
    </ItemGroup>
    <Target Name="RemovePublishPdbs" AfterTargets="Publish" Condition="'$(Configuration)' != 'Debug'">
        <ItemGroup>
            <_PublishPdb Include="$(PublishDir)**/*.pdb" />
        </ItemGroup>
        <Delete Files="@(_PublishPdb)" />
    </Target>
</Project>