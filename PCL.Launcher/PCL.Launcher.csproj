<Project Sdk="Microsoft.NET.Sdk">
    <!-- PCL 的界面层：目标为跨平台 net10.0，WPF 工程保持冻结。 -->
    <PropertyGroup>
        <AssemblyTitle>PCL</AssemblyTitle>
        <AssemblyName>PCL.Launcher</AssemblyName>
        <Description>PCL 的界面层</Description>
        <Company>PCL Community</Company>
        <Product>PCL</Product>
        <RootNamespace>PCL</RootNamespace>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Configurations>Debug;CI;Release;Beta</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
        <PlatformTarget>$(Platform)</PlatformTarget>
        <NoWarn>$(NoWarn);CS9113</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <!-- 复用 WPF 头的构建元数据，PCL.Core 通过入口程序集的清单资源读取 -->
        <EmbeddedResource Include="..\Plain Craft Launcher 2\metadata.json" Link="metadata.json">
            <LogicalName>PCL.metadata.json</LogicalName>
        </EmbeddedResource>
        <!-- 启动链资源（辅助 jar、日志配置、数据库模板等），与 WPF 头共用同一份文件 -->
        <EmbeddedResource Include="..\Plain Craft Launcher 2\Resources\*.*">
            <LogicalName>PCL.Resources.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PCL.Core.UI\PCL.Core.UI.csproj" />
        <ProjectReference Include="..\PCL.Launcher.Core\PCL.Launcher.Core.csproj" />
    </ItemGroup>
</Project>