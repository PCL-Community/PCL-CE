<Project Sdk="Microsoft.NET.Sdk">
    <!-- PCL 的界面层：跨平台 net10.0。 -->
    <PropertyGroup>
        <AssemblyTitle>PCL</AssemblyTitle>
        <AssemblyName>PCL.Launcher</AssemblyName>
        <Description>PCL 的界面层</Description>
        <Company>PCL Community</Company>
        <Product>PCL</Product>
        <RootNamespace>PCL</RootNamespace>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Configurations>Debug;CI;Release;Beta</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
        <PlatformTarget>$(Platform)</PlatformTarget>
        <NoWarn>$(NoWarn);CS9113</NoWarn>
        <!-- 版本号与 Plain Craft Launcher 2/metadata.json 的 version.base 保持一致（运行期展示仍读 metadata.json） -->
        <Version>2.15.1</Version>
        <AssemblyVersion>2.15.1.0</AssemblyVersion>
        <FileVersion>2.15.1.0</FileVersion>
        <InformationalVersion>2.15.1</InformationalVersion>
        <!-- Windows 可执行文件图标与清单：由 SDK 在生成 Win32 宿主时使用，非 Windows 目标构建时忽略 -->
        <ApplicationIcon>Assets/Images/icon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <!-- 构建元数据位于 Plain Craft Launcher 2/metadata.json，PCL.Core 通过入口程序集的清单资源读取 -->
        <EmbeddedResource Include="..\Plain Craft Launcher 2\metadata.json" Link="metadata.json">
            <LogicalName>PCL.metadata.json</LogicalName>
        </EmbeddedResource>
        <!-- 启动链资源（辅助 jar、日志配置、数据库模板等），直接引用 Plain Craft Launcher 2/Resources 下的文件 -->
        <EmbeddedResource Include="..\Plain Craft Launcher 2\Resources\*.*">
            <LogicalName>PCL.Resources.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <!-- 游戏内提示文本：WPF 侧按 Resources/hints/{语言}.txt 读取，这里使用同一相对路径的清单名 -->
        <EmbeddedResource Include="..\Plain Craft Launcher 2\Resources\hints\*.txt">
            <LogicalName>PCL.Resources.hints.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <!-- 许可证文件随输出复制，沿用 WPF 版把 LICENCE 放进输出目录的分发方式 -->
        <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\PCL.Launcher.Core\LICENCE" Link="LICENCE.PCL.Launcher.Core" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\Plain Craft Launcher 2\LICENCE" Link="LICENCE.PCL" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <!-- SVG 图标资源：SvgIconLoader 通过 avares://PCL.Launcher/Assets/IconPacks/{pack}/{name}.svg 读取 -->
        <AvaloniaResource Include="Assets/IconPacks/**" />
        <!-- 控件图片与字体：MyImage 占位图、方块/皮肤/头像图标、启动器内置字体 -->
        <AvaloniaResource Include="Assets/Images/**" />
        <AvaloniaResource Include="Assets/Fonts/**" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PCL.Core.UI\PCL.Core.UI.csproj" />
        <ProjectReference Include="..\PCL.Launcher.Core\PCL.Launcher.Core.csproj" />
    </ItemGroup>
</Project>
