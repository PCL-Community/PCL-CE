<Project Sdk="Microsoft.NET.Sdk">
    <!-- PCL.Core 的 Avalonia 适配层：把 PlatformServices 的 7 个服务与宿主接口绑定到 Avalonia。 -->
    <PropertyGroup>
        <AssemblyTitle>PCL.Core.Avalonia</AssemblyTitle>
        <AssemblyName>PCL.Core.Avalonia</AssemblyName>
        <Description>PCL.Core 的 Avalonia 适配层</Description>
        <Company>PCL Community</Company>
        <Product>PCL.Core.Avalonia</Product>
        <RootNamespace>PCL.Core.Avalonia</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Configurations>Debug;CI;Release;Beta</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
        <PlatformTarget>$(Platform)</PlatformTarget>
        <NoWarn>$(NoWarn);CS9113</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PCL.Core\PCL.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- 语言资源字典：由 WPF 语言 XAML 机械转换而来（仅命名空间差异），作为 Avalonia 资源随程序集打包 -->
        <AvaloniaResource Include="Localization\Languages\*.axaml" />
    </ItemGroup>
</Project>
